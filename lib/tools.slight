; Tools for an agent (D187, D188): reading, finding and changing files, and
; running commands. Not part of the prelude, so a program that wants them
; says (@include :tools); this includes :agent, :exec and :fs itself.
;
;     (let approve (lambda (what) ...))           ; #true to go ahead
;     (agent/new url model "" (list (tools/read-file) (tools/list-files) (tools/search)
;                                   (tools/write-file approve) (tools/edit-file approve)
;                                   (tools/run approve)))
;
; A tool that changes a file or runs a command first asks approve, a
; function of what it's about to do, as text, and does it only if that
; gives #true; if not, the model is told it wasn't let. A tool that can't
; do what it's asked raises why, which the model is told too.

(@include :agent)
(@include :exec)
(@include :fs)

(defun tools/read-file ()
    (tool/new "read_file" "Reads a text file, and gives what's in it."
        (list (list "path" :string "The file's path"))
        (lambda (args) (tools/read (tools/string args "path")))))

(defun tools/list-files ()
    (tool/new "list_files" "Lists what's in a directory, one name a line, a directory's ending in /."
        (list (list "path" :string "The directory's path, . for the current one"))
        (lambda (args) (tools/listing (exec/run (list "ls" "-1Ap" "--" (tools/string args "path")))))))

(defun tools/search ()
    (tool/new "search" "Finds the lines that contain some text, in a file or in every file under a directory, as file:line:text."
        (list (list "text" :string "The text to look for, as it is: not a pattern")
              (list "path" :string "The file or directory to look in, . for the current one"))
        (lambda (args) (tools/grep (tools/string args "text") (tools/string args "path")))))

(defun tools/write-file (approve)
    (tool/new "write_file" "Writes a file, all of it, making it if it isn't there, once the user agrees."
        (list (list "path" :string "The file's path")
              (list "content" :string "What the file is to hold, all of it"))
        (lambda (args) (tools/write approve (tools/string args "path") (tools/string args "content")))))

(defun tools/edit-file (approve)
    (tool/new "edit_file" "Changes a file by replacing a piece of its text with another, once the user agrees. The text to replace must be in the file once, exactly as it is there, spaces and all."
        (list (list "path" :string "The file's path")
              (list "old" :string "The text to replace")
              (list "new" :string "What to put in its place"))
        (lambda (args) (tools/edit approve (tools/string args "path") (tools/string args "old") (tools/string args "new")))))

(defun tools/run (approve)
    (tool/new "run" "Runs a shell command, once the user agrees, and gives what it printed and its exit status."
        (list (list "command" :string "The command, for sh -c"))
        (lambda (args) (tools/command approve (tools/string args "command")))))

; --- what they do ------------------------------------------------------

; The argument called name, which must be a string.
(defun tools/string (args name)
    (let v (lookup name args))
    (cond
        ((eq? v :not-found) (raise (concat "the argument " name " is missing")))
        ((str? v)           v)
        (#true              (raise (concat "the argument " name " must be a string")))))

; The file at path, its bytes as they are; or it raises why not.
(defun tools/read (path)
    (match (join (connect :fs/read path (tools/chunks ())))
        ((:ok text)      text)
        ((:error reason) (raise reason))))

(defun tools/chunks (acc)
    (recv
        ((:open f)    (send f (list :read :chunks)) (tools/chunks acc))
        ((:chunk f s) (tools/chunks (cons s acc)))
        ((:eof f)     (str-join "" (reverse acc)))))

; Makes the file at path hold text, and nothing else.
(defun tools/save (path text)
    (match (join (connect :fs/write path (tools/writing text)))
        ((:ok _)         ())
        ((:error reason) (raise reason))))

(defun tools/writing (text)
    (recv ((:open f) (send f (list :write text)) (disconnect f))))

; What a command printed, and its status if that wasn't 0.
(defun tools/output (ran)
    (match ran
        ((:ok (0 output))      output)
        ((:ok (status output)) (concat output "[exit status: " status "]"))
        ((:error reason)       (raise reason))))

; An empty directory says so, since an empty result reads as nothing.
(defun tools/listing (ran)
    (match ran
        ((:ok (0 "")) "the directory is empty")
        (_            (tools/output ran))))

; grep: -F, the text as it is, since a model's text often has a bracket or
; a dot in it; -I, no binary files; and no .git. Status 1 is no lines.
(defun tools/grep (text path)
    (match (exec/run (list "grep" "-rnIF" "--exclude-dir=.git" "-e" text "--" path))
        ((:ok (1 ""))  "no lines contain it")
        (ran           (tools/output ran))))

(defun tools/write (approve path content)
    (cond
        ((not (approve (concat "write " path ", " (str-len content) " bytes:\n" (tools/marked "+ " content))))
            "the user didn't let it be written")
        (#true
            (tools/save path content)
            (concat "wrote " (str-len content) " bytes to " path))))

; old must be in the file once: a second one, even overlapping the first,
; would leave which to change to chance.
(defun tools/edit (approve path old new)
    (let text (tools/read path))
    (let at   (index-of text old))
    (cond
        ((== (str-len old) 0) (raise "old is empty: give the text to replace"))
        ((< at 0)             (raise (concat "the text to replace isn't in " path)))
        ((>= (index-of (substring text (+ at 1) (str-len text)) old) 0)
            (raise (concat "the text to replace is in " path " more than once: give more of it, to say which")))
        ((not (approve (concat "edit " path ":\n" (tools/marked "- " old) (tools/marked "+ " new))))
            "the user didn't let it be changed")
        (#true
            (tools/save path (concat (substring text 0 at) new (substring text (+ at (str-len old)) (str-len text))))
            (concat "changed " path))))

(defun tools/command (approve command)
    (cond
        ((not (approve (concat "run: " command))) "the user didn't let it run")
        (#true
            (match (exec/run (list "sh" "-c" command))
                ((:ok (status output)) (concat output "[exit status: " status "]"))
                ((:error reason)       (raise reason))))))

; text's lines, each after mark, for the person to read; a last newline
; makes no line of its own.
(defun tools/marked (mark text)
    (let lines (str-split text \n))
    (let shown (if (and (cons? lines) (cons? (cdr lines)) (eq? (car (reverse lines)) "")) (reverse (cdr (reverse lines))) lines))
    (str-join "" (map (lambda (line) (concat mark line \n)) shown)))
