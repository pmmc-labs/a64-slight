; Tools for an agent (D187-D192): reading, finding and changing files,
; running commands, fetching from the web, arithmetic, notes kept from
; one conversation to the next, and other agents to ask. Not part of the prelude, so a program
; that wants them says (@include :tools); this includes :agent, :calc,
; :ds, :exec and :fs itself.
;
;     (let approve (lambda (what) ...))           ; #true to go ahead
;     (agent/new url model "" (list (tools/read-file) (tools/list-files) (tools/search)
;                                   (tools/write-file approve) (tools/edit-file approve)
;                                   (tools/run approve)))
;
; A tool that changes a file, runs a command or fetches a URL first asks
; approve, a function of what it's about to do, as text, and does it only
; if that gives #true; if not, the model is told it wasn't let. The text
; is printable (tools/printable), so it shows a person what will be done,
; whatever the model put in it. A tool that can't do what it's asked
; raises why, which the model is told too.

(@include :agent)
(@include :calc)
(@include :ds)
(@include :exec)
(@include :fs)

(defun tools/read-file ()
    (tool/new "read_file" "Reads a text file, and gives what's in it."
        (list (list "path" :string "The file's path"))
        (lambda (args) (tools/read (tools/string args "path")))))

(defun tools/list-files ()
    (tool/new "list_files" "Lists what's in a directory, one name a line, a directory's ending in /."
        (list (list "path" :string "The directory's path, . for the current one"))
        (lambda (args) (tools/listing (exec/run (list "ls" "-1Ap" "--" (tools/string args "path")))))))

(defun tools/search ()
    (tool/new "search" "Finds the lines that contain some text, in a file or in every file under a directory, as file:line:text."
        (list (list "text" :string "The text to look for, as it is: not a pattern")
              (list "path" :string "The file or directory to look in, . for the current one"))
        (lambda (args) (tools/grep (tools/string args "text") (tools/string args "path")))))

(defun tools/write-file (approve)
    (tool/new "write_file" "Writes a file, all of it, making it if it isn't there, once the user agrees."
        (list (list "path" :string "The file's path")
              (list "content" :string "What the file is to hold, all of it"))
        (lambda (args) (tools/write approve (tools/string args "path") (tools/string args "content")))))

(defun tools/edit-file (approve)
    (tool/new "edit_file" "Changes a file by replacing a piece of its text with another, once the user agrees. The text to replace must be in the file once, exactly as it is there, spaces and all."
        (list (list "path" :string "The file's path")
              (list "old" :string "The text to replace")
              (list "new" :string "What to put in its place"))
        (lambda (args) (tools/edit approve (tools/string args "path") (tools/string args "old") (tools/string args "new")))))

; A command still running after 2 minutes is stopped (D234), as Claude
; Code's own are; tools/run-within sets another limit.
(defun tools/run (approve) (tools/run-within 120000 approve))

(defun tools/run-within (ms approve)
    (tool/new "run" (str "Runs a shell command, once the user agrees, and gives what it printed and its exit status. One still running after " (tools/duration ms) " is stopped.")
        (list (list "command" :string "The command, for sh -c"))
        (lambda (args) (tools/command approve ms (tools/string args "command")))))

(defun tools/calc ()
    (tool/new "calc" "Works out arithmetic exactly: + - * / % and ^ (a power), parentheses, sqrt, abs, floor, ceil, round, sin, cos, tan, exp, min, max, pi and e."
        (list (list "expression" :string "The arithmetic, as you'd write it, such as (2 + 3) * 4^2 / 7"))
        (lambda (args) (calc/eval (tools/string args "expression")))))

; Notes in a store (notes/open, below), which the model keeps without
; asking: they're its own, in a file the program chose.
(defun tools/remember (store)
    (tool/new "remember" "Keeps a note under a key, for later, in this conversation or another. A note already under the key is replaced."
        (list (list "key" :string "A short name for the note")
              (list "text" :string "The note"))
        (lambda (args)
            (let key (tools/string args "key"))
            (notes/put store key (tools/string args "text"))
            (str "remembered " key))))

(defun tools/recall (store)
    (tool/new "recall" "Gives the note kept under a key. For a key with no note, it gives the keys there are."
        (list (list "key" :string "The note's key"))
        (lambda (args)
            (let key  (tools/string args "key"))
            (let text (notes/get store key))
            (let keys (notes/keys store))
            (cond
                ((str? text) text)
                ((nil? keys) "there are no notes yet")
                (#true       (str "there's no note under " key "; the keys are: " (str/join ", " keys)))))))

; Another agent, a, as a tool called name, which description tells the
; model about: a bigger model, say, or one with a system prompt of its
; own. It doesn't ask: what a does, its own tools ask about. An agent
; mustn't be its own tool: it would wait for itself.
(defun tools/ask-agent (name description a)
    (tool/new name description
        (list (list "question" :string "What to ask, in full: it knows nothing of this conversation"))
        (lambda (args)
            (match (agent/ask a (tools/string args "question"))
                ((:ok answer)    answer)
                ((:error reason) (raise reason))))))

(defun tools/fetch (approve)
    (tool/new "fetch" "Fetches a URL, http or https, once the user agrees, and gives what's there as text, a web page's HTML made plain. A redirect isn't followed: it says where it goes, for another fetch."
        (list (list "url" :string "The URL, starting http:// or https://"))
        (lambda (args) (tools/get approve (tools/string args "url")))))

; --- what they do ------------------------------------------------------

; The argument called name, which must be a string.
(defun tools/string (args name)
    (let v (lookup name args))
    (cond
        ((eq? v :not-found) (raise (str "the argument " name " is missing")))
        ((str? v)           v)
        (#true              (raise (str "the argument " name " must be a string")))))

; The file at path, its bytes as they are; or it raises why not.
(defun tools/read (path)
    (match (join (fork (tools/reading path)))
        ((:ok text)      text)
        ((:error reason) (raise reason))))

(defun tools/reading (path)
    (match (open :fs/read path)
        ((:ok f)         (send f (list :read :chunks)) (tools/chunks f ()))
        ((:error reason) (raise reason))))

(defun tools/chunks (f acc)
    (match (read f)
        ((:chunk _ s)      (tools/chunks f (cons s acc)))
        ((:eof _)          (str/join "" (reverse acc)))
        ((:error _ reason) (raise reason))))

; Makes the file at path hold text, and nothing else.
(defun tools/save (path text)
    (match (join (fork (tools/writing path text)))
        ((:ok _)         ())
        ((:error reason) (raise reason))))

; A write that fails leaves (:error f reason) to be read, closed or not.
(defun tools/writing (path text)
    (match (open :fs/write path)
        ((:ok f)
            (send f (list :write text))
            (disconnect f)
            (match (read f)
                ((:error _ reason) (raise reason))
                (_                 ())))
        ((:error reason) (raise reason))))

; What a command printed, and its status if that wasn't 0.
(defun tools/output (ran)
    (match ran
        ((:ok (0 output))      output)
        ((:ok (status output)) (str output "[exit status: " status "]"))
        ((:error reason)       (raise reason))))

; An empty directory says so, since an empty result reads as nothing.
(defun tools/listing (ran)
    (match ran
        ((:ok (0 "")) "the directory is empty")
        (_            (tools/output ran))))

; grep: -F, the text as it is, since a model's text often has a bracket or
; a dot in it; -I, no binary files; and no .git. Status 1 is no lines.
(defun tools/grep (text path)
    (match (exec/run (list "grep" "-rnIF" "--exclude-dir=.git" "-e" text "--" path))
        ((:ok (1 ""))  "no lines contain it")
        (ran           (tools/output ran))))

(defun tools/write (approve path content)
    (cond
        ((not (tools/allowed? approve (str "write " path ", " (bytes/len content) " bytes:\n" (tools/marked "+ " content))))
            "the user didn't let it be written")
        (#true
            (tools/save path content)
            (str "wrote " (bytes/len content) " bytes to " path))))

; old must be in the file once: a second one, even overlapping the first,
; would leave which to change to chance.
(defun tools/edit (approve path old new)
    (let text (tools/read path))
    (let at   (bytes/index-of text old))
    (cond
        ((== (bytes/len old) 0) (raise "old is empty: give the text to replace"))
        ((< at 0)             (raise (str "the text to replace isn't in " path)))
        ((>= (bytes/index-of (bytes/slice text (+ at 1)) old) 0)
            (raise (str "the text to replace is in " path " more than once: give more of it, to say which")))
        ((not (tools/allowed? approve (str "edit " path ":\n" (tools/marked "- " old) (tools/marked "+ " new))))
            "the user didn't let it be changed")
        (#true
            (tools/save path (str (bytes/slice text 0 at) new (bytes/slice text (+ at (bytes/len old)))))
            (str "changed " path))))

(defun tools/command (approve ms command)
    (cond
        ((not (tools/allowed? approve (str "run: " command))) "the user didn't let it run")
        (#true
            (match (exec/run-within ms (list "sh" "-c" command))
                ((:ok ((:timeout _) output)) (str output "[stopped after " (tools/duration ms) ", still running]"))
                ((:ok (status output))       (str output "[exit status: " status "]"))
                ((:error reason)             (raise reason))))))

; ms as a person says it: "120 s", or "300 ms".
(defun tools/duration (ms)
    (if (== (math/mod ms 1000) 0) (str (div ms 1000) " s") (str ms " ms")))

; text's lines, each after mark, for the person to read; a last newline
; makes no line of its own.
(defun tools/marked (mark text)
    (let lines (str/split text \n))
    (let shown (match (reverse lines) (("" & rest) (reverse rest)) (_ lines)))
    (str/join "" (map (lambda (line) (str mark line \n)) shown)))

; --- what's shown ------------------------------------------------------

; Asks approve about what, made printable.
(defun tools/allowed? (approve what) (approve (tools/printable what)))

; text, with what a terminal would take as a command, or would show in
; another order, written as an escape a person can read: control
; characters but newline and tab, DEL and the C1 controls (U+0080 to
; U+009F) as \u{1b}, Unicode's bidirectional embeddings, overrides and
; isolates (U+202A to U+202E, U+2066 to U+2069) the same, and a byte
; that isn't UTF-8 as \x9b. What it gives is printable already, so it
; can be given again.
(defun tools/printable (text)
    (str/join "" (map tools/printable-char (str/chars text))))

(defun tools/printable-char (c)
    (let code (str/code-at c 0))
    (cond
        ((and (== (bytes/len c) 1) (>= (bytes/at c 0) 128)) (str "\\x" (tools/hex-of (bytes/at c 0))))
        ((or (== code 10) (== code 9))                       c)
        ((or (< code 32) (== code 127) (and (>= code 128) (<= code 159))
             (and (>= code 8234) (<= code 8238)) (and (>= code 8294) (<= code 8297)))
            (str "\\u{" (tools/hex-of code) "}"))
        (#true                                              c)))

; n in hexadecimal, lower case.
(defun tools/hex-of (n)
    (let d (bytes/slice "0123456789abcdef" (% n 16) (+ (% n 16) 1)))
    (if (< n 16) d (str (tools/hex-of (div n 16)) d)))

; --- fetching ----------------------------------------------------------

; curl's -w writes the status, the URL fetched, the type and where a
; redirect goes, a line each, after what it fetched, behind a line no
; page has.
(defun tools/marker () "@@slight-fetch@@ ")

; A URL must be http or https: curl reads files and much else too, and
; --proto holds it to those as well. curl doesn't follow a redirect: the
; model is told where it goes, and fetching that is asked about in turn,
; so a page can't send a fetch where the person didn't agree to. 20
; seconds and 5 MB at most; and a failure is curl's message, with the
; trailer and anything it fetched before left out.
(defun tools/get (approve url)
    (cond
        ((not (or (str/starts-with? url "http://") (str/starts-with? url "https://")))
            (raise "the URL must start with http:// or https://"))
        ((not (tools/allowed? approve (str "fetch " url))) "the user didn't let it be fetched")
        (#true
            (match (exec/run (list "curl" "-sS" "--proto" "=http,https" "--max-time" "20" "--max-filesize" "5000000"
                                   "-w" (str "\\n" (tools/marker) "%{http_code}\\n%{url_effective}\\n%{content_type}\\n%{redirect_url}") "--" url))
                ((:ok (0 output))      (tools/fetched output))
                ((:ok (status output)) (raise (tools/curl-error output status)))
                ((:error reason)       (raise reason))))))

(defun tools/curl-error (output status)
    (let at (bytes/index-of output "curl: ("))
    (if (< at 0)
        (str "curl failed, with status " status)
        (car (str/split (bytes/slice output at) \n))))

; What was fetched, as text: a page made plain, its links against the URL
; it came from, text as it is, or what it is if it isn't text; after its
; status, if that isn't 2xx. A redirect is where it goes.
; The trailer's ith line, or "" if curl's was cut short.
(defun tools/field (lines i)
    (match (nth i lines)
        (()   "")
        (line line)))

(defun tools/fetched (output)
    (let parts   (reverse (str/split output (str \n (tools/marker)))))
    (let body    (if (cons? parts) (str/join (str \n (tools/marker)) (reverse (cdr parts))) ""))
    (let trailer (str/split (if (cons? parts) (car parts) "") \n))
    (let code    (tools/field trailer 0))
    (let type    (str/lower (tools/field trailer 2)))
    (let to      (tools/field trailer 3))
    (let text    (cond
                     ((>= (bytes/index-of type "html") 0) (tools/html->text body (tools/field trailer 1)))
                     ((tools/text? type body)       body)
                     (#true                         (str "not text: " type ", " (bytes/len body) " bytes"))))
    (cond
        ((str/starts-with? code "2")                     text)
        ((and (str/starts-with? code "3") (not (eq? to ""))) (str "HTTP " code ": a redirect to " to ", which a fetch of its own can get"))
        (#true                                           (str "HTTP " code \n text))))

(defun tools/text? (type body)
    (cond
        ((eq? type "")                    (str/well-formed? body))
        ((str/starts-with? type "text/")  #true)
        (#true (or (>= (bytes/index-of type "json") 0) (>= (bytes/index-of type "xml") 0) (>= (bytes/index-of type "javascript") 0)))))

; --- HTML as text ------------------------------------------------------

; HTML as plain text, for a model: comments, scripts, styles, SVG and
; noscript go, with what's in them; other tags go, but one that starts a
; block (a paragraph, a heading, a row, a break) starts a line, and an
; item starts one with "- "; entities are decoded; and space is squeezed,
; with never more than one blank line. A link is [text](url), its URL
; resolved against base, the page's own ("" leaves it as it is). The HTML
; is cut at each <, so each piece is a tag and the text after it, and the
; whole is read once.
(defun tools/html->text (html base)
    (let pieces (str/split (tools/uncomment html) "<"))
    (if (nil? pieces)
        ""
        (tools/lines (tools/pieces (cdr pieces) () base #false (list (tools/plain (car pieces)))))))

; html without its comments, which can hold a < of their own.
(defun tools/uncomment (html)
    (let parts (str/split html "<!--"))
    (if (nil? parts)
        ""
        (str/join "" (cons (car parts) (map tools/after-comment (cdr parts))))))

(defun tools/after-comment (part)
    (let end (bytes/index-of part "-->"))
    (if (< end 0) "" (bytes/slice part (+ end 3))))

; skip is the tag that ends what's being left out ("/script"), or ().
; open is whether a link is open: its <a> put (:link url) in acc, which
; its </a>, the next <a> or the end makes [text](url) of, with the pieces
; since.
(defun tools/pieces (pieces skip base open acc)
    (match pieces
        (() (str/join "" (reverse (tools/shut open acc))))
        ((p & rest)
            (let close (bytes/index-of p ">"))
            (let tag   (tools/tag p close))
            (let text  (if (< close 0) "" (bytes/slice p (+ close 1))))
            (cond
                ((not (nil? skip))
                    (if (eq? tag skip) (tools/pieces rest () base open (cons (tools/plain text) acc)) (tools/pieces rest skip base open acc)))
                ((eq? tag "")
                    (tools/pieces rest () base open (cons (tools/plain (str "<" p)) acc)))
                ((member? tag (list "script" "style" "svg" "noscript"))
                    (tools/pieces rest (str "/" tag) base open acc))
                ((eq? tag "a")
                    (tools/pieces rest () base #true (cons (tools/plain text) (cons (list :link (tools/href p close base)) (tools/shut open acc)))))
                ((eq? tag "/a")
                    (tools/pieces rest () base #false (cons (tools/plain text) (tools/shut open acc))))
                (#true
                    (tools/pieces rest () base open (cons (tools/plain text) (cons (tools/break tag) acc))))))))

; A piece's tag, lower case, with its / if it closes one; or "" if the <
; didn't start a tag ("a < b").
(defun tools/tag (p close)
    (let head  (if (< close 0) p (bytes/slice p 0 close)))
    (let first (if (== (bytes/len head) 0) 0 (bytes/at head 0)))
    (cond
        ((not (or (tools/letter? first) (== first 47) (== first 33) (== first 63))) "")
        (#true (str/lower (tools/name-of head)))))

(defun tools/letter? (b) (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122))))

; A tag's name: up to a space, a newline, a tab or a /, past a first /.
(defun tools/name-of (head)
    (let rest (if (str/starts-with? head "/") (bytes/slice head 1) head))
    (let end  (tools/until rest 0 (cons 47 (tools/spaces))))
    (str (if (str/starts-with? head "/") "/" "") (bytes/slice rest 0 end)))

; The first index from i in s whose byte is one of stops, or past the end;
; and the first whose byte isn't one of skips.
(defun tools/until (s i stops)
    (if (or (>= i (bytes/len s)) (member? (bytes/at s i) stops)) i (tools/until s (+ i 1) stops)))

(defun tools/past (s i skips)
    (if (and (< i (bytes/len s)) (member? (bytes/at s i) skips)) (tools/past s (+ i 1) skips) i))

(defun tools/spaces () (list 32 10 13 9))

; What a tag puts in the text: a line for a block, an item's dash, a bar
; before a cell, or nothing. An item, a row or a term starts a line, and
; its end doesn't, so a list's items are on lines one after another.
(defun tools/break (tag)
    (let name (if (str/starts-with? tag "/") (bytes/slice tag 1) tag))
    (cond
        ((eq? tag "li")                                                     "\n- ")
        ((member? tag (list "td" "th"))                                     " | ")
        ((member? tag (list "/li" "/tr" "/dt" "/dd" "/td" "/th"))           "")
        ((member? name (list "p" "div" "br" "tr" "title" "h1" "h2" "h3" "h4" "h5" "h6"
                             "section" "article" "header" "footer" "main" "nav" "aside"
                             "ul" "ol" "dl" "dt" "dd" "table" "blockquote" "pre" "hr"
                             "form" "figure" "figcaption"))                 "\n")
        (#true                                                              "")))

; Text between tags: its entities decoded, and its space squeezed to
; single spaces, a space at either end kept, since the text next to it
; may need it.
(defun tools/plain (text)
    (let spaced (str/join " " (str/split (str/join " " (str/split (str/join " " (str/split text \n)) \t)) \r)))
    (let words  (filter (lambda (w) (> (bytes/len w) 0)) (str/split spaced " ")))
    (let lead   (if (str/starts-with? spaced " ") " " ""))
    (let trail  (if (and (cons? words) (str/ends-with? spaced " ")) " " ""))
    (tools/entities (str lead (str/join " " words) trail)))

(defun tools/entities (s)
    (let parts (str/split s "&"))
    (if (or (nil? parts) (nil? (cdr parts)))
        s
        (str/join "" (cons (car parts) (map tools/entity (cdr parts))))))

; A piece after an &: an entity it knows, up to its ;, and the rest; or
; the & back, as it was.
(defun tools/entity (part)
    (let semi  (bytes/index-of part ";"))
    (let value (if (and (> semi 0) (< semi 10)) (tools/decode (bytes/slice part 0 semi)) :not-found))
    (if (eq? value :not-found)
        (str "&" part)
        (str value (bytes/slice part (+ semi 1)))))

(defun tools/decode (name)
    (cond
        ((str/starts-with? name "#x") (tools/code (tools/hex (bytes/slice name 2) 0)))
        ((str/starts-with? name "#X") (tools/code (tools/hex (bytes/slice name 2) 0)))
        ((str/starts-with? name "#")  (tools/code (str->int (bytes/slice name 1))))
        (#true
            (lookup name (list (list "amp" "&") (list "lt" "<") (list "gt" ">") (list "quot" "\"")
                               (list "apos" "'") (list "nbsp" " ") (list "mdash" "—") (list "ndash" "–")
                               (list "hellip" "…") (list "lsquo" "‘") (list "rsquo" "’")
                               (list "ldquo" "“") (list "rdquo" "”") (list "copy" "©"))))))

; A code point as its character, if it is one.
(defun tools/code (n)
    (if (and (int? n) (> n 0) (< n 1114112) (not (and (>= n 55296) (<= n 57343))))
        (codes->str (list n))
        :not-found))

(defun tools/hex (s acc)
    (cond
        ((== (bytes/len s) 0) acc)
        (#true
            (let b (bytes/at s 0))
            (let d (cond
                       ((and (>= b 48) (<= b 57))  (- b 48))
                       ((and (>= b 97) (<= b 102)) (- b 87))
                       ((and (>= b 65) (<= b 70))  (- b 55))
                       (#true                      -1)))
            (if (or (< d 0) (> acc 1114111)) #false (tools/hex (bytes/slice s 1) (+ (* acc 16) d))))))

; The text's lines, each with its space squeezed and none at its ends
; (pieces next to each other may each have kept a space), and no more than
; one blank line in a row, none at the start or the end.
(defun tools/lines (text)
    (let lines (map (lambda (line) (str/join " " (filter (lambda (w) (> (bytes/len w) 0)) (str/split line " ")))) (str/split text \n)))
    (str/join \n (reverse (tools/blank-once lines () #true))))

(defun tools/blank-once (lines acc blank)
    (match lines
        (() (if (and (cons? acc) (eq? (car acc) "")) (cdr acc) acc))
        ((l & rest)
            (cond
                ((and (eq? l "") blank) (tools/blank-once rest acc #true))
                ((eq? l "")             (tools/blank-once rest (cons "" acc) #true))
                (#true                  (tools/blank-once rest (cons l acc) #false))))))

; --- links -------------------------------------------------------------

(defun tools/shut (open acc) (if open (tools/link-close acc ()) acc))

; acc with the pieces since its open link's marker made the link.
(defun tools/link-close (acc inside)
    (match acc
        (((:link url) & rest) (cons (tools/link-text inside url) rest))
        ((p & rest)           (tools/link-close rest (cons p inside)))))

; A link's text as [words](url), on one line, with the space or line
; breaks around it kept outside; or the text as it was, if it has no words
; (an image's link) or goes nowhere a fetch could.
(defun tools/link-text (inside url)
    (let raw   (str/join "" inside))
    (let words (filter (lambda (w) (> (bytes/len w) 0)) (str/split (str/join " " (str/split raw \n)) " ")))
    (cond
        ((or (nil? words) (eq? url :none)) raw)
        (#true
            (let start (tools/past raw 0 (list 32 10)))
            (let end   (tools/back raw (bytes/len raw)))
            (str (bytes/slice raw 0 start) "[" (str/join " " words) "](" url ")" (bytes/slice raw end)))))

; Where the space and line breaks at the end of s, before i, start.
(defun tools/back (s i)
    (if (and (> i 0) (member? (bytes/at s (- i 1)) (list 32 10))) (tools/back s (- i 1)) i))

; Where an <a> goes, the piece p after its <: its href, entities decoded
; and resolved against base; or :none.
(defun tools/href (p close base)
    (let head (if (< close 0) p (bytes/slice p 0 close)))
    (let at   (tools/attribute (str/lower head) "href" 0))
    (if (< at 0) :none (tools/resolve base (tools/entities (tools/value head at)))))

; Where the value of the attribute name starts in head, lower case: name
; after a space and before an =, so not data-href; or -1.
(defun tools/attribute (head name from)
    (let i (bytes/index-of (bytes/slice head from) name))
    (cond
        ((< i 0) -1)
        (#true
            (let at (+ from i))
            (let eq (tools/past head (+ at (bytes/len name)) (tools/spaces)))
            (if (and (> at 0) (member? (bytes/at head (- at 1)) (tools/spaces)) (< eq (bytes/len head)) (== (bytes/at head eq) 61))
                (tools/past head (+ eq 1) (tools/spaces))
                (tools/attribute head name (+ at 1))))))

; The value at i: in quotes, up to the closing one, or up to a space.
(defun tools/value (head i)
    (let q (if (< i (bytes/len head)) (bytes/at head i) 0))
    (cond
        ((or (== q 34) (== q 39))
            (let rest (bytes/slice head (+ i 1)))
            (let end  (bytes/index-of rest (if (== q 34) "\"" "'")))
            (if (< end 0) rest (bytes/slice rest 0 end)))
        (#true (bytes/slice head i (tools/until head i (tools/spaces))))))

; href as a whole URL, against base, the page's; or :none for a place on
; the same page, or a scheme a fetch can't follow (mailto:, javascript:).
; A ../ is left in, for the server to take out.
(defun tools/resolve (base href)
    (let lower (str/lower (bytes/slice href 0 8)))
    (cond
        ((or (eq? href "") (str/starts-with? href "#"))                              :none)
        ((or (str/starts-with? lower "http://") (str/starts-with? lower "https://")) href)
        ((tools/scheme? href)                                                        :none)
        ((eq? base "")                                                               href)
        ((str/starts-with? href "//") (str (bytes/slice base 0 (+ (bytes/index-of base ":") 1)) href))
        ((str/starts-with? href "/")  (str (tools/origin base) href))
        ((str/starts-with? href "?")  (str (tools/page base) href))
        (#true                        (str (tools/dir base) href))))

; Whether href starts with a scheme: a : before any / ? or #.
(defun tools/scheme? (href)
    (let c (tools/until href 0 (list 58 47 63 35)))
    (and (> c 0) (< c (bytes/len href)) (== (bytes/at href c) 58)))

; A URL's scheme and host (and port); without its query or fragment; and
; its directory, up to its last /.
(defun tools/origin (url) (bytes/slice url 0 (tools/until url (+ (bytes/index-of url "//") 2) (list 47 63 35))))
(defun tools/page (url) (bytes/slice url 0 (tools/until url 0 (list 63 35))))

(defun tools/dir (url)
    (let page (tools/page url))
    (if (== (bytes/len page) (bytes/len (tools/origin url)))
        (str page "/")
        ; up to the last /, which page has: it has the origin's //
        (str (str/slice page 0 (str/last-index-of page "/")) "/")))

; --- notes -------------------------------------------------------------

; A store of notes, a process holding them as (key text) pairs, newest
; first. It reads them from the file at path, as an s-expression, when it
; starts (a file that isn't there, or is empty, is no notes; one that
; isn't notes ends the store, rather than be written over), and writes
; them all back after each change, so they outlast the program.
(defun notes/open (path) (spawn (notes/loop path (notes/read path))))

(defun notes/get (store key) (ask store (list :get key)))
(defun notes/keys (store) (ask store (list :keys)))

; Raises why, if the file can't be written; the store goes on as it was.
(defun notes/put (store key text)
    (match (ask store (list :put key text))
        ((:error reason) (raise reason))
        (_               ())))

(defun notes/loop (path table)
    (recv
        ((:get key to) (reply to (lookup key table)) (notes/loop path table))
        ((:keys to)    (reply to (map car table)) (notes/loop path table))
        ((:put key text to)
            (let new (cons (list key text) (remove (lambda (n) (eq? (car n) key)) table)))
            (match (join (fork (tools/save path (str (sexp/print new) \n))))
                ((:ok _)
                    (reply to ())
                    (notes/loop path new))
                ((:error reason)
                    (reply to (list :error reason))
                    (notes/loop path table))))))

(defun notes/read (path)
    (match (join (fork (tools/read path)))
        ((:error (:enoent _)) ())
        ((:error reason)      (raise reason))
        ((:ok text)
            (match (if (eq? (tools/lines text) "") (list :ok ()) (sexp/parse text))
                ((:ok table) (if (notes/table? table) table (raise (list :not-notes path))))
                (_           (raise (list :not-notes path)))))))

; Whether table is a list of (key text) pairs of strings.
(defun notes/table? (table)
    (match table
        (()                     #true)
        (((k t) & rest)         (and (str? k) (str? t) (notes/table? rest)))
        (_                      #false)))
