; HTTP/1.1 over :tcp: a server and a client, opt-in (D140, D173). Not part
; of the prelude, so a program that wants them says (@include :http).
;
;     (http/serve 8080 handler)                    ; the listener's pid
;     (http/get "http://localhost:8080/hello?x=1") ; (:ok (200 headers body))
;
; A handler is a function of a request, and gives a response. A request is a
; keyed list, read with lookup:
;
;     (:method :get) (:path "/hello") (:query "x=1") (:headers ...) (:body "")
;
; A response is (status headers body), headers being (name value) pairs with
; the names in lowercase. The library adds Content-Length and Connection:
; close, so a handler leaves them out.
;
; One request and one response to a connection, which then closes. A handler
; runs in a process of its own, so a fault in it is a 500 (D173). A request
; that breaks the rules gets a 400, a head over 64 KB a 431 and a body over
; 8 MB a 413; a client gets (:error reason) instead.
;
; Errors are (:error reason): what the device gave (D136), (:bad-http what)
; for a reply that isn't HTTP, (:bad-url url), :no-tls (HTTPS waits for 12c),
; :closed for a connection that closed before its reply, or :timeout.
;
; http/stream gives a reply's body to its caller as it comes, in messages, as
; a device does (D181):
;
;     (http/stream :get url () "" :lines)          ; the stream's pid, s
;     ; then (:head s status headers), (:line s text) ..., (:eof s)

; GET url, with no headers and no body.
(defun http/get (url) (http/request :get url () ""))

; Any method, headers (a list of (name value)) and a body (a string, "" for
; none). Gives (:ok response), or (:error reason).
(defun http/request (method url headers body)
    (let ctx (list :client (http/method-name method)))
    (match (http/parse-url url)
        ((:ok host port target)
            (http/unwrap (join (connect :tcp (str host ":" port) (http/exchange host port target headers body ctx)))))
        ((:error reason) (list :error reason))))

; As http/request, but gives (:error :timeout) if no answer comes within ms
; milliseconds. The timer stays pending until then and keeps the program
; running, as ask-within's does (D173).
(defun http/request-within (ms method url headers body)
    (let ctx (list :client (http/method-name method)))
    (match (http/parse-url url)
        ((:ok host port target)
            (http/await (connect :tcp (str host ":" port) (http/exchange host port target headers body ctx)) ms))
        ((:error reason) (list :error reason))))

; The pid's result, or (:error :timeout) after ms milliseconds, killing it.
(defun http/await (pid ms)
    (let box (fork (http/box pid)))
    (after ms box :timeout)
    (match (join box)
        ((:ok (:done exit)) (http/unwrap exit))
        ((:ok (:timeout))   (kill pid) (list :error :timeout))))

(defun http/box (pid)
    (monitor pid)
    (recv
        ((:exit _ exit) (list :done exit))
        (:timeout       (list :timeout))))

; A connection's process ends with its result, or with (:error reason) if the
; device failed (D136). join gives either as (:ok result) or (:error reason).
(defun http/unwrap (exit)
    (match exit
        ((:ok result)    result)
        ((:error reason) (list :error reason))))

; The reply's body as it comes, sent to the caller (D181). Gives the stream's
; pid, s, at once: the process that owns the connection, so kill stops it.
; The caller hears (:head s status headers), then the body, as (:chunk s
; bytes) when how is :chunks or (:line s text) when it's :lines, then (:eof
; s); or, if anything fails, (:error s reason) in their place, the reason as
; http/request gives it. A bad URL is an error too, so there's always a pid.
(defun http/stream (method url headers body how)
    (let caller $$)
    (let ctx    (list :stream (http/method-name method) caller (http/how how)))
    (let s      (match (http/parse-url url)
        ((:ok host port target) (connect :tcp (str host ":" port) (http/exchange host port target headers body ctx)))
        ((:error reason)        (fork (raise reason)))))
    (fork (http/watch s caller))
    s)

; A stream cuts its body into :lines or :chunks; anything else faults, in the
; caller.
(defun http/how (how)
    (match how
        (:lines  :lines)
        (:chunks :chunks)))

; Tells the caller how the stream s ended, which s can't always say itself:
; a device that fails ends its owner at once (D136). An error raised in s
; comes the same way. A kill says nothing, since the caller asked for it.
; And if the caller ends first, s is killed, as a device closes when its
; owner ends.
(defun http/watch (s caller)
    (monitor s)
    (monitor caller)
    (recv
        ((:exit p exit) (if (eq? p s) (http/ended s caller exit) (kill s)))))

(defun http/ended (s caller exit)
    (match exit
        ((:ok _)          (send caller (list :eof s)))
        ((:error :killed) ())
        ((:error reason)  (send caller (list :error s reason)))))

; The client's side of a connection: the request goes out, then the reply is
; read as ctx says: whole, (:client method), or streamed to a caller,
; (:stream method caller how).
(defun http/exchange (host port target headers body ctx)
    (recv
        ((:open c)
            (send c (list :write (http/request-text (cadr ctx) host port target headers body)))
            (send c (list :read :chunks))
            (http/head c ctx "" (cons 0 ())))))

; Listens on port (0 lets the system pick). Its owner sends (:listening port)
; to the caller, and the listener's pid is the result, which kill stops.
(defun http/serve (port handler)
    (let told $$)
    (connect :tcp/listen port (http/accept handler told)))

(defun http/accept (handler told)
    (recv
        ((:open _ bound)
            (send told (list :listening bound))
            (http/accept handler told))
        ((:accept _ conn)
            (connect conn (http/conn conn handler))
            (http/accept handler told))))

(defun http/conn (c handler)
    (recv
        ((:open _)
            (send c (list :read :chunks))
            (http/head c (list :server handler) "" (cons 0 ())))))

; The head: its lines up to a blank one, the start line first. acc is
; (total . lines), total being the head's bytes so far and lines the lines so
; far, last first. 65536 is the most a head may be.
(defun http/head (c ctx buf acc)
    (let i (bytes/index-of buf "\n"))
    (cond
        ((>= i 0)
            (let line  (http/chop (bytes/slice buf 0 i)))
            (let total (+ (car acc) (+ i 1)))
            (let rest  (bytes/slice buf (+ i 1)))
            (cond
                ((> total 65536)                                  (http/fail c ctx :head-too-big))
                ((and (== (bytes/len line) 0) (nil? (cdr acc)))   (http/fail c ctx (list :bad-http "no start line")))
                ((== (bytes/len line) 0)                          (http/after-head c ctx rest (reverse (cdr acc))))
                (#true                                            (http/head c ctx rest (cons total (cons line (cdr acc)))))))
        ((> (bytes/len buf) 65536) (http/fail c ctx :head-too-big))
        (#true (recv
            ((:chunk c s) (http/head c ctx (~ buf s) acc))
            ((:eof c)     (http/fail c ctx (if (and (nil? (cdr acc)) (== (bytes/len buf) 0))
                                               :closed
                                               (list :bad-http "closed in the head"))))))))

; The line without its \r, if it has one.
(defun http/chop (s)
    (if (str/ends-with? s "\r") (bytes/slice s 0 -1) s))

; The head is in. Its start line must have the parts its side needs; the body
; comes next, as the head says.
(defun http/after-head (c ctx buf lines)
    (let words (str/split (car lines) " "))
    (let msg   (list words (map http/header (cdr lines))))
    (if (http/start-ok? ctx words)
        (http/start-body c ctx msg buf)
        (http/fail c ctx (list :bad-http "start line"))))

; curl and others wait for a 100 before they send a body they expect the
; server to refuse, or to take a while (RFC 9110, Expect). A stream's caller
; hears the head as soon as it's in.
(defun http/start-body (c ctx msg buf)
    (match ctx
        ((:server _)
            (if (eq? (lookup "expect" (cadr msg)) "100-continue")
                (send c (list :write "HTTP/1.1 100 Continue\r\n\r\n"))
                ()))
        ((:stream _ caller _) (send caller (list :head $$ (http/status msg) (cadr msg))))
        ((:client _)          ()))
    (http/body c ctx msg buf (http/framing ctx msg)))

(defun http/start-ok? (ctx words)
    (if (eq? (car ctx) :server)
        (== (length words) 3)
        (and (>= (length words) 2) (int? (str->int (cadr words))))))

; A header line, "Name: value", as (name value): the name in lowercase, and
; the value without the spaces around it.
(defun http/header (line)
    (let i (bytes/index-of line ":"))
    (cond
        ((< i 0) (list (str/lower line) ""))
        (#true   (list (str/lower (http/trim (bytes/slice line 0 i)))
                       (http/trim (bytes/slice line (+ i 1)))))))

; The text without spaces and tabs at either end.
(defun http/trim (s)
    (http/trim-right (http/trim-left s)))

(defun http/trim-left (s)
    (cond
        ((and (> (bytes/len s) 0) (http/blank? (bytes/at s 0)))
            (http/trim-left (bytes/slice s 1)))
        (#true s)))

(defun http/trim-right (s)
    (cond
        ((and (> (bytes/len s) 0) (http/blank? (bytes/at s (- (bytes/len s) 1))))
            (http/trim-right (bytes/slice s 0 -1)))
        (#true s)))

(defun http/blank? (b) (or (== b 32) (== b 9)))

; How the body is cut: by a count, in chunks, to the end of the connection, or
; not at all. A request with neither a length nor chunks has no body.
(defun http/framing (ctx msg)
    (let headers (cadr msg))
    (let clen    (lookup "content-length" headers))
    (cond
        ((http/chunked? headers) (list :chunked))
        ((http/no-body? ctx msg) (list :none))
        ((eq? clen :not-found)   (if (eq? (car ctx) :server) (list :none) (list :to-eof)))
        (#true                   (list :length (str->int clen)))))

(defun http/chunked? (headers)
    (let te (lookup "transfer-encoding" headers))
    (and (not (eq? te :not-found)) (>= (bytes/index-of (str/lower te) "chunked") 0)))

(defun http/no-body? (ctx msg)
    (cond
        ((eq? (car ctx) :server) #false)
        ((eq? (cadr ctx) "HEAD") #true)
        (#true                   (http/bodiless? (http/status msg)))))

(defun http/status (msg) (str->int (cadr (car msg))))

; 1xx, 204 and 304 have no body.
(defun http/bodiless? (status)
    (or (< status 200) (== status 204) (== status 304)))

; The body, cut as the framing says. Each piece is taken as soon as it's in
; (http/take), and acc is what's kept of them.
(defun http/body (c ctx msg buf how)
    (let acc (http/acc ctx))
    (match how
        ((:none)     (http/done c ctx msg acc))
        ((:length n) (if (and (int? n) (>= n 0))
                         (http/length c ctx msg buf acc n)
                         (http/fail c ctx (list :bad-http "content-length"))))
        ((:chunked)  (http/chunk-size c ctx msg buf acc))
        ((:to-eof)   (http/to-eof c ctx msg (http/take ctx acc buf)))))

; A body of n bytes: what came with the head, then chunks till there are n.
(defun http/length (c ctx msg buf acc n)
    (if (and (eq? (car ctx) :server) (> n 8388608))
        (http/fail c ctx :body-too-big)
        (http/data c ctx msg buf acc n #false)))

; need bytes of the body: those in buf, then from the device. They end the
; body, or in a chunked one, the chunk. buf is taken before the next chunk is
; waited for, so a stream's caller has it at once.
(defun http/data (c ctx msg buf acc need chunked)
    (cond
        ((>= (bytes/len buf) need)
            (let taken (http/take ctx acc (bytes/slice buf 0 need)))
            (let rest  (bytes/slice buf need))
            (if chunked (http/chunk-end c ctx msg rest taken) (http/done c ctx msg taken)))
        (#true
            (let taken (http/take ctx acc buf))
            (recv
                ((:chunk c s) (http/data c ctx msg s taken (- need (bytes/len buf)) chunked))
                ((:eof c)     (http/fail c ctx (list :bad-http "short body")))))))

; A chunked body: a size line, the bytes it gives, the line after them, and so
; on, till a size of 0 and the trailers.
(defun http/chunk-size (c ctx msg buf acc)
    (let i (bytes/index-of buf "\n"))
    (cond
        ((>= i 0)
            (let size (http/chunk-size-of (bytes/slice buf 0 i)))
            (let rest (bytes/slice buf (+ i 1)))
            (cond
                ((not (int? size))                                              (http/fail c ctx (list :bad-http "chunk size")))
                ((== size 0)                                                    (http/trailers c ctx msg rest acc))
                ((and (eq? (car ctx) :server) (> (+ (car acc) size) 8388608))   (http/fail c ctx :body-too-big))
                (#true                                                          (http/data c ctx msg rest acc size #true))))
        ((> (bytes/len buf) 65536) (http/fail c ctx (list :bad-http "chunk size")))
        (#true (recv
            ((:chunk c s) (http/chunk-size c ctx msg (~ buf s) acc))
            ((:eof c)     (http/fail c ctx (list :bad-http "short body")))))))

; The size in a chunk's size line: hexadecimal, with any ";extension" ignored.
(defun http/chunk-size-of (line)
    (let semi (bytes/index-of line ";"))
    (http/hex (http/trim (if (< semi 0) (http/chop line) (bytes/slice line 0 semi)))))

; The number a hexadecimal string gives, or #false. Eight digits at most, so
; it can't overflow.
(defun http/hex (s)
    (cond
        ((or (== (bytes/len s) 0) (> (bytes/len s) 8)) #false)
        (#true (http/hex-loop s 0 0))))

(defun http/hex-loop (s i acc)
    (cond
        ((== i (bytes/len s)) acc)
        (#true
            (let d (http/hex-digit (bytes/at s i)))
            (if (< d 0) #false (http/hex-loop s (+ i 1) (+ (* acc 16) d))))))

(defun http/hex-digit (b)
    (cond
        ((and (>= b 48) (<= b 57))  (- b 48))
        ((and (>= b 97) (<= b 102)) (- b 87))
        ((and (>= b 65) (<= b 70))  (- b 55))
        (#true -1)))

; The line that ends a chunk's bytes, then the next size line.
(defun http/chunk-end (c ctx msg buf acc)
    (let i (bytes/index-of buf "\n"))
    (cond
        ((>= i 0) (http/chunk-size c ctx msg (bytes/slice buf (+ i 1)) acc))
        ((> (bytes/len buf) 65536) (http/fail c ctx (list :bad-http "chunk end")))
        (#true (recv
            ((:chunk c s) (http/chunk-end c ctx msg (~ buf s) acc))
            ((:eof c)     (http/fail c ctx (list :bad-http "short body")))))))

; The trailers after the last chunk, to a blank line; then the body is done.
(defun http/trailers (c ctx msg buf acc)
    (let i (bytes/index-of buf "\n"))
    (cond
        ((>= i 0)
            (cond
                ((== (bytes/len (http/chop (bytes/slice buf 0 i))) 0) (http/done c ctx msg acc))
                (#true (http/trailers c ctx msg (bytes/slice buf (+ i 1)) acc))))
        ((> (bytes/len buf) 65536) (http/fail c ctx (list :bad-http "trailers")))
        (#true (recv
            ((:chunk c s) (http/trailers c ctx msg (~ buf s) acc))
            ((:eof c)     (http/fail c ctx (list :bad-http "short body")))))))

; A body that lasts till the connection closes.
(defun http/to-eof (c ctx msg acc)
    (recv
        ((:chunk c s) (http/to-eof c ctx msg (http/take ctx acc s)))
        ((:eof c)     (http/done c ctx msg acc))))

; What's kept of a body: for a whole one, (total . parts), the parts last
; first; for a stream, the start of a line that hasn't ended yet.
(defun http/acc (ctx)
    (if (eq? (car ctx) :stream) "" (cons 0 ())))

; A piece of the body, s, as it comes: kept, or sent to a stream's caller.
(defun http/take (ctx acc s)
    (match ctx
        ((:stream _ caller :lines)
            (http/lines caller (str/split (~ acc s) "\n")))
        ((:stream _ caller :chunks)
            (if (== (bytes/len s) 0) () (send caller (list :chunk $$ s)))
            acc)
        (_ (cons (+ (car acc) (bytes/len s)) (cons s (cdr acc))))))

; The pieces of the body between newlines: each but the last is a line, sent
; without its \r, as the head's are; the last hasn't ended, and is kept. A
; line over 64 KB ends the stream, so a reply with no newlines can't fill
; the heap.
(defun http/lines (caller pieces)
    (cond
        ((nil? pieces)                    "")
        ((> (bytes/len (car pieces)) 65536) (raise :line-too-big))
        ((nil? (cdr pieces))              (car pieces))
        (#true
            (send caller (list :line $$ (http/chop (car pieces))))
            (http/lines caller (cdr pieces)))))

(defun http/joined (acc) (str/join "" (reverse (cdr acc))))

; The message is whole. A server runs the handler and answers; a client gives
; its response; a stream sends its last line, if it had no newline. (Its
; watcher sends the (:eof s).)
(defun http/done (c ctx msg acc)
    (match ctx
        ((:server handler)    (http/respond c handler (http/request-of msg (http/joined acc))))
        ((:client _)          (list :ok (http/response-of msg (http/joined acc))))
        ((:stream _ caller _) (if (== (bytes/len acc) 0) () (send caller (list :line $$ (http/chop acc)))))))

; A message that breaks the rules: a server answers with the status that
; says why, and a client gives the reason. A server whose client closed
; before anything is not answered. A stream raises it, and its watcher
; tells the caller.
(defun http/fail (c ctx reason)
    (match ctx
        ((:server _)
            (if (eq? reason :closed)
                ()
                (http/write c (list (http/fail-status reason) () ""))))
        ((:client _)       (list :error reason))
        ((:stream _ _ _)   (raise reason))))

(defun http/fail-status (reason)
    (cond
        ((eq? reason :head-too-big) 431)
        ((eq? reason :body-too-big) 413)
        (#true                      400)))

; The handler runs in a process of its own (D173): a fault in it is a 500.
(defun http/respond (c handler req)
    (match (join (fork (handler req)))
        ((:ok resp) (http/write c resp))
        ((:error _) (http/write c (list 500 () "")))))

(defun http/write (c resp)
    (match resp
        ((status headers body)
            (send c (list :write (http/response-text status headers body))))))

(defun http/request-of (msg body)
    (let words  (car msg))
    (let target (cadr words))
    (let q      (bytes/index-of target "?"))
    (list
        (list :method  (http/method-of (car words)))
        (list :path    (if (< q 0) target (bytes/slice target 0 q)))
        (list :query   (if (< q 0) "" (bytes/slice target (+ q 1))))
        (list :headers (cadr msg))
        (list :body    body)))

(defun http/method-of (s)
    (cond
        ((eq? s "GET")    :get)
        ((eq? s "HEAD")   :head)
        ((eq? s "POST")   :post)
        ((eq? s "PUT")    :put)
        ((eq? s "DELETE") :delete)
        (#true            s)))

; The method as it goes on the wire: :get is "GET", and a string stays as it is.
(defun http/method-name (method)
    (cond
        ((sym? method) (str/upper (sym->str method)))
        (#true         method)))

(defun http/response-of (msg body)
    (list (http/status msg) (cadr msg) body))

(defun http/request-text (method host port target headers body)
    (str method " " target " HTTP/1.1\r\n"
            "Host: " host ":" port "\r\n"
            "Connection: close\r\n"
            (http/header-lines headers)
            "Content-Length: " (bytes/len body) "\r\n\r\n"
            body))

(defun http/response-text (status headers body)
    (str "HTTP/1.1 " status " " (http/reason status) "\r\n"
            (http/header-lines headers)
            "Content-Length: " (bytes/len body) "\r\n"
            "Connection: close\r\n\r\n"
            body))

(defun http/header-lines (headers)
    (str/join "" (map (lambda (h) (str (car h) ": " (cadr h) "\r\n")) headers)))

(defun http/reason (status)
    (cond
        ((== status 200) "OK")
        ((== status 201) "Created")
        ((== status 204) "No Content")
        ((== status 301) "Moved Permanently")
        ((== status 302) "Found")
        ((== status 304) "Not Modified")
        ((== status 400) "Bad Request")
        ((== status 403) "Forbidden")
        ((== status 404) "Not Found")
        ((== status 405) "Method Not Allowed")
        ((== status 413) "Payload Too Large")
        ((== status 431) "Request Header Fields Too Large")
        ((== status 500) "Internal Server Error")
        ((== status 501) "Not Implemented")
        (#true           "")))

; http://host[:port][/path[?query]], as (:ok host port target). The port is 80
; and the target "/" when none is given.
(defun http/parse-url (url)
    (cond
        ((str/starts-with? url "https://")  (list :error :no-tls))
        ((not (str/starts-with? url "http://")) (list :error (list :bad-url url)))
        (#true                              (http/split-url (bytes/slice url 7) url))))

(defun http/split-url (authority-and-target url)
    (let slash     (bytes/index-of authority-and-target "/"))
    (let authority (if (< slash 0) authority-and-target (bytes/slice authority-and-target 0 slash)))
    (let target    (if (< slash 0) "/" (bytes/slice authority-and-target slash)))
    (let colon     (bytes/index-of authority ":"))
    (let host      (if (< colon 0) authority (bytes/slice authority 0 colon)))
    (let port      (if (< colon 0) 80 (str->int (bytes/slice authority (+ colon 1)))))
    (if (and (> (bytes/len host) 0) (int? port))
        (list :ok host port target)
        (list :error (list :bad-url url))))
