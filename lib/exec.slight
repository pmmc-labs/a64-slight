; Running a command to its end (D185, D187). Not part of the prelude, so a
; program that wants it says (@include :exec).
;
;     (exec/run (list "ls" "-l"))           (:ok (0 "total 8\n..."))

; Runs cmd, a list of strings, with no input, and gives (:ok (status
; output)) once it has ended: output is what it printed, stdout and stderr
; together, and status its exit code, or (:signal name). Or (:error
; reason), if it can't be started: (:error (:enoent "ls")).
(defun exec/run (cmd)
    (join (connect :exec cmd (exec/collect ()))))

; chunks is the output so far, last first.
(defun exec/collect (chunks)
    (recv
        ((:open p)     (send p (list :read :chunks)) (send p (list :eof)) (exec/collect chunks))
        ((:chunk p s)  (exec/collect (cons s chunks)))
        ((:eof p)      (exec/collect chunks))
        ((:exited p n) (list n (str-join "" (reverse chunks))))))
