; The prelude: compiled with every program. It can only define functions.
;
; A program can define a function with a prelude name: its own code then
; uses its own, and the prelude keeps using these (D80). D78 says why
; filter keeps what matches and remove drops it; why range is (range
; start end), from start up to but not including end; and why take and
; skip stop at the end of the list rather than faulting. Predicates end
; in ?, starts-with? and ends-with? among them. Every loop is a tail
; call, so long lists are fine.

; --- numbers and booleans ---------------------------------------------------

(defun inc (n) (+ n 1))
(defun dec (n) (- n 1))

; On booleans only. (and and or aren't functions: the expander makes them
; into cond, which stops at the first operand that decides.)
(defun not (a)
    (cond
        (a      #false)
        (#true  #true)))

; --- folds --------------------------------------------------------------------

; (f acc x) for each x, from the left.
(defun fold/l (acc f xs)
    (match xs
        (()         acc)
        ((x & rest) (fold/l (f acc x) f rest))))

; (f x acc) for each x, from the right.
(defun fold/r (acc f xs) (fold/r-loop f (reverse xs) acc))
(defun fold/r-loop (f xs acc)
    (match xs
        (()         acc)
        ((x & rest) (fold/r-loop f rest (f x acc)))))

; --- lists --------------------------------------------------------------------
;
; Each its own loop, not fold/l with a lambda: a closure called for each
; element was most of the time a program spent in these (D203).

(defun reverse (xs) (reverse-onto xs ()))

; xs reversed, in front of ys.
(defun reverse-onto (xs ys)
    (match xs
        (()         ys)
        ((x & rest) (reverse-onto rest (cons x ys)))))

(defun length (xs) (length-loop xs 0))
(defun length-loop (xs n)
    (match xs
        (()         n)
        ((_ & rest) (length-loop rest (+ n 1)))))

(defun append (xs ys) (reverse-onto (reverse xs) ys))

(defun sum (xs) (sum-loop xs 0))
(defun sum-loop (xs acc)
    (match xs
        (()         acc)
        ((x & rest) (sum-loop rest (+ acc x)))))

(defun product (xs) (product-loop xs 1))
(defun product-loop (xs acc)
    (match xs
        (()         acc)
        ((x & rest) (product-loop rest (* acc x)))))

(defun map (f xs) (map-loop f xs ()))
(defun map-loop (f xs acc)
    (match xs
        (()         (reverse acc))
        ((x & rest) (map-loop f rest (cons (f x) acc)))))

; The elements for which (f x) is #true.
(defun filter (f xs) (filter-loop f xs ()))
(defun filter-loop (f xs acc)
    (match xs
        (()         (reverse acc))
        ((x & rest) (filter-loop f rest (if (f x) (cons x acc) acc)))))

; The elements for which (f x) is #false.
(defun remove (f xs) (remove-loop f xs ()))
(defun remove-loop (f xs acc)
    (match xs
        (()         (reverse acc))
        ((x & rest) (remove-loop f rest (if (f x) acc (cons x acc))))))

; The first n elements, or all of them if there are fewer.
(defun take (n xs) (take-loop n xs ()))
(defun take-loop (n xs acc)
    (cond
        ((== n 0)  (reverse acc))
        ((nil? xs) (reverse acc))
        (#true     (take-loop (- n 1) (cdr xs) (cons (car xs) acc)))))

; All but the first n elements, or () if there are fewer.
(defun skip (n xs)
    (cond
        ((== n 0)  xs)
        ((nil? xs) xs)
        (#true     (skip (- n 1) (cdr xs)))))

; The element at index i, or () if there isn't one.
(defun nth (i xs)
    (match xs
        (()         ())
        ((x & rest) (if (== i 0) x (nth (- i 1) rest)))))

; The first element for which (f x) is #true, or ().
(defun find (f xs)
    (match xs
        (()         ())
        ((x & rest) (if (f x) x (find f rest)))))

(defun member? (x xs)
    (match xs
        (()         #false)
        ((y & rest) (or (eq? x y) (member? x rest)))))

; start, start + 1, ... up to but not including end.
(defun range (start end) (range-loop (- end 1) start ()))
(defun range-loop (n start acc)
    (cond
        ((< n start) acc)
        (#true       (range-loop (- n 1) start (cons n acc)))))

; (f i) for i from start up to but not including end, for its effects.
(defun dotimes (start end f)
    (cond
        ((>= start end) ())
        (#true          (f start) (dotimes (+ start 1) end f))))

; (x y) for each x and the y in the same place, as long as the shorter
; list: an association list, if the xs are keys.
(defun zip (xs ys) (zip-loop xs ys ()))
(defun zip-loop (xs ys acc)
    (match (list xs ys)
        (((x & xr) (y & yr)) (zip-loop xr yr (cons (list x y) acc)))
        (_                   (reverse acc))))

; --- sorting ------------------------------------------------------------------

; xs in order: a before b when (less? a b) is #true, so (sort < xs) is
; ascending. Stable: elements that neither is less than the other keep
; their order. A merge sort from the bottom up: runs of one, merged in
; pairs, again and again, till there's one run.
(defun sort (less? xs) (sort-runs less? (map (lambda (x) (list x)) xs)))

; xs in the order of (key x), a number, ascending; stable too. key is
; called once for each element.
(defun sort-by (key xs)
    (map cadr (sort (lambda (a b) (< (car a) (car b))) (map (lambda (x) (list (key x) x)) xs))))

(defun sort-runs (less? runs)
    (cond
        ((nil? runs)       ())
        ((nil? (cdr runs)) (car runs))
        (#true             (sort-runs less? (sort-pairs less? runs ())))))

; Each run merged with the one after it, in order.
(defun sort-pairs (less? runs acc)
    (cond
        ((nil? runs)       (reverse acc))
        ((nil? (cdr runs)) (reverse (cons (car runs) acc)))
        (#true             (sort-pairs less? (cddr runs) (cons (sort-merge less? (car runs) (cadr runs) ()) acc)))))

; Two sorted runs as one: on a tie, a's element first, which keeps the
; sort stable. acc is what's merged so far, reversed.
(defun sort-merge (less? a b acc)
    (cond
        ((nil? a)                     (fold/l b (lambda (r x) (cons x r)) acc))
        ((nil? b)                     (fold/l a (lambda (r x) (cons x r)) acc))
        ((less? (car b) (car a))      (sort-merge less? a (cdr b) (cons (car b) acc)))
        (#true                        (sort-merge less? (cdr a) b (cons (car a) acc)))))

; --- association lists: ((key value) ...) -------------------------------------

(defun assoc (k v table)
    (cons (list k v) table))

; The value for k, or :not-found.
(defun lookup (k table)
    (match table
        (()                   :not-found)
        (((key value) & rest) (if (eq? k key) value (lookup k rest)))))

; --- strings ------------------------------------------------------------------

(defun str-repeat (s n) (str-repeat-loop s n ""))
(defun str-repeat-loop (s n acc)
    (cond
        ((<= n 0) acc)
        (#true    (str-repeat-loop s (- n 1) (~ acc s)))))

(defun starts-with? (s m)
    (cond
        ((> (str-len m) (str-len s)) #false)
        (#true                       (eq? (substring s 0 (str-len m)) m))))

(defun ends-with? (s m)
    (cond
        ((> (str-len m) (str-len s)) #false)
        (#true                       (eq? (substring s (- (str-len s) (str-len m)) (str-len s)) m))))

; s padded to n bytes with fill, repeated and cut to fit, as JavaScript's
; padStart and padEnd do.
(defun pad-start (s n fill) (~ (padding s n fill) s))
(defun pad-end (s n fill) (~ s (padding s n fill)))
(defun padding (s n fill)
    (let need (- n (str-len s)))
    (cond
        ((<= need 0)          "")
        ((== (str-len fill) 0) "")
        (#true                (substring (str-repeat fill (+ 1 (div need (str-len fill)))) 0 need))))

; ASCII only (D27): other bytes are left alone.
(defun uc (s) (bytes->string (map (lambda (b) (cond ((and (>= b 97) (<= b 122)) (- b 32)) (#true b))) (bytes s))))
(defun lc (s) (bytes->string (map (lambda (b) (cond ((and (>= b 65) (<= b 90)) (+ b 32)) (#true b))) (bytes s))))

; The bytes of s, as a list of integers.
(defun bytes (s) (bytes-loop s (- (str-len s) 1) ()))
(defun bytes-loop (s i acc)
    (cond
        ((< i 0) acc)
        (#true   (bytes-loop s (- i 1) (cons (byte-at s i) acc)))))

; Perl's ord and chr (D148): the code point of a string's first character,
; and the one-character string for a code point. They're utf8/code and
; utf8/char, under the names Perl gives them.
(defun ord (s) (utf8/code s))
(defun chr (n) (utf8/char n))
