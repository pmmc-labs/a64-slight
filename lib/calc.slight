; Arithmetic, written as people write it, worked out (D190). Not part of
; the prelude, so a program that wants it says (@include :calc).
;
;     (calc/eval "(2 + 3) * 4 ^ 2 / 8")      ; 10
;     (calc/eval "7 / 2")                     ; 3.5
;     (calc/eval "max(2, sqrt(2) * 3)")       ; 4.242640687119286
;
; + - * / % and ^ (or **), with ^ first, and from the right, then a sign,
; then * / and %, then + and -; parentheses; the functions sqrt, abs,
; floor, ceil, round, sin, cos, tan, exp, min and max; and the constants pi
; and e. Whole numbers stay whole while they fit in 62 bits, so 2^61 is
; exact, and so is a division that comes out whole; anything else is a
; float. An expression that can't be read or worked out raises why, and
; where, so a model that wrote it can mend it.

(defun calc/eval (s)
    (let tokens (calc/tokens s 0 ()))
    (cond
        ((nil? tokens) (raise "the expression is empty"))
        (#true
            (match (calc/sum tokens)
                ((v ())                  v)
                ((_ ((:comma at) & _))   (raise (str "at byte " at ": a , where an operator or the end should be (a number is written without commas)")))
                ((_ (token & _))         (calc/stuck token "an operator or the end"))))))

; --- reading -----------------------------------------------------------

; The tokens of s from byte i: (:num n at), (:op "+" at), (:open at),
; (:close at), (:comma at) and (:name "sqrt" at), at counting from 1.
; ** is ^, and ×, ÷ and − are *, / and -, since a model may write them.
(defun calc/tokens (s i acc)
    (cond
        ((>= i (bytes/len s)) (reverse acc))
        (#true
            (let b  (bytes/at s i))
            (let at (+ i 1))
            (cond
                ((member? b (list 32 9 10 13))              (calc/tokens s (+ i 1) acc))
                ((or (calc/digit? b) (== b 46))             (calc/number s i acc))
                ((calc/letter? b)                           (calc/name s i (calc/name-end s i) acc))
                ((eq? (bytes/slice s i (+ i 2)) "**")       (calc/tokens s (+ i 2) (cons (list :op "^" at) acc)))
                ((eq? (bytes/slice s i (+ i 2)) "×")        (calc/tokens s (+ i 2) (cons (list :op "*" at) acc)))
                ((eq? (bytes/slice s i (+ i 2)) "÷")        (calc/tokens s (+ i 2) (cons (list :op "/" at) acc)))
                ((eq? (bytes/slice s i (+ i 3)) "−")        (calc/tokens s (+ i 3) (cons (list :op "-" at) acc)))
                ((member? b (list 43 45 42 47 37 94))       (calc/tokens s (+ i 1) (cons (list :op (bytes/slice s i (+ i 1)) at) acc)))
                ((== b 40)                                  (calc/tokens s (+ i 1) (cons (list :open at) acc)))
                ((== b 41)                                  (calc/tokens s (+ i 1) (cons (list :close at) acc)))
                ((== b 44)                                  (calc/tokens s (+ i 1) (cons (list :comma at) acc)))
                (#true (raise (str "at byte " at ": can't read " (str/slice (bytes/slice s i) 0 1))))))))

(defun calc/digit? (b) (and (>= b 48) (<= b 57)))
(defun calc/letter? (b) (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122))))

(defun calc/digits-end (s i)
    (if (and (< i (bytes/len s)) (calc/digit? (bytes/at s i))) (calc/digits-end s (+ i 1)) i))

(defun calc/name-end (s i)
    (if (and (< i (bytes/len s)) (calc/letter? (bytes/at s i))) (calc/name-end s (+ i 1)) i))

(defun calc/name (s i end acc)
    (calc/tokens s end (cons (list :name (str/lower (bytes/slice s i end)) (+ i 1)) acc)))

; A number: digits, maybe a point and more, maybe an exponent. Whole if it
; has neither and fits; a float otherwise, its parts made into the form
; str->float takes (".5" and "1." have a 0 put to them).
(defun calc/number (s i acc)
    (let whole (calc/digits-end s i))
    (let point (and (< whole (bytes/len s)) (== (bytes/at s whole) 46)))
    (let frac  (if point (calc/digits-end s (+ whole 1)) whole))
    (let exp   (calc/exponent-end s frac))
    (let ints  (bytes/slice s i whole))
    (let fracs (if point (bytes/slice s (+ whole 1) frac) ""))
    (let n     (cond
                   ((and (== (bytes/len ints) 0) (== (bytes/len fracs) 0)) (raise (str "at byte " (+ i 1) ": a point with no digits")))
                   ((and (not point) (== exp frac))
                       (let k (str->int ints))
                       (if (int? k) k (str->float ints)))
                   (#true
                       (str->float (str (if (eq? ints "") "0" ints) "." (if (eq? fracs "") "0" fracs)
                                              (bytes/slice s frac exp))))))
    (if (eq? n #false)
        (raise (str "at byte " (+ i 1) ": " (bytes/slice s i exp) " is too big for a number"))
        (calc/tokens s exp (cons (list :num n (+ i 1)) acc))))

; Where an exponent after i ends: e or E, maybe a sign, and digits; or i
; itself if there isn't one.
(defun calc/exponent-end (s i)
    (let sign (if (and (< (+ i 1) (bytes/len s)) (member? (bytes/at s (+ i 1)) (list 43 45))) 2 1))
    (cond
        ((not (and (< i (bytes/len s)) (member? (bytes/at s i) (list 101 69)))) i)
        ((not (and (< (+ i sign) (bytes/len s)) (calc/digit? (bytes/at s (+ i sign))))) i)
        (#true (calc/digits-end s (+ i sign)))))

; --- working it out ----------------------------------------------------
;
; Each step takes the tokens left and gives (value tokens-left).

(defun calc/sum (tokens) (calc/sum-on (calc/product tokens)))

(defun calc/sum-on (vt)
    (match vt
        ((v ((:op "+" _) & rest)) (calc/sum-next v rest calc/add))
        ((v ((:op "-" _) & rest)) (calc/sum-next v rest calc/sub))
        (_                        vt)))

(defun calc/sum-next (v rest f)
    (match (calc/product rest)
        ((w more) (calc/sum-on (list (f v w) more)))))

(defun calc/product (tokens) (calc/product-on (calc/unary tokens)))

(defun calc/product-on (vt)
    (match vt
        ((v ((:op "*" _) & rest))  (calc/product-next v rest calc/mul))
        ((v ((:op "/" _) & rest))  (calc/product-next v rest calc/div))
        ((v ((:op "%" _) & rest))  (calc/product-next v rest calc/mod))
        (_                         vt)))

(defun calc/product-next (v rest f)
    (match (calc/unary rest)
        ((w more) (calc/product-on (list (f v w) more)))))

; A sign binds less tightly than ^, so -2^2 is -4.
(defun calc/unary (tokens)
    (match tokens
        (((:op "-" _) & rest) (match (calc/unary rest) ((v more) (list (calc/sub 0 v) more))))
        (((:op "+" _) & rest) (calc/unary rest))
        (_                    (calc/power tokens))))

; ^ from the right: 2^3^2 is 2^9.
(defun calc/power (tokens)
    (match (calc/atom tokens)
        ((v ((:op "^" _) & rest)) (match (calc/unary rest) ((w more) (list (calc/pow v w) more))))
        (vt                       vt)))

(defun calc/atom (tokens)
    (match tokens
        (()                                (raise "the expression ends too soon"))
        (((:num n _) & rest)               (list n rest))
        (((:open at) & rest)               (calc/closed (calc/sum rest) at))
        (((:name f at) (:open _) & rest)   (calc/call f at (calc/args rest ())))
        (((:name c at) & rest)             (list (calc/constant c at) rest))
        ((token & _)                       (calc/stuck token "a number"))))

(defun calc/closed (vt at)
    (match vt
        ((v ((:close _) & rest)) (list v rest))
        (_                       (raise (str "at byte " at ": a ( that isn't closed")))))

; A function's arguments, after its (: (values tokens-left).
(defun calc/args (tokens acc)
    (match (calc/sum tokens)
        ((v ((:comma _) & rest)) (calc/args rest (cons v acc)))
        ((v ((:close _) & rest)) (list (reverse (cons v acc)) rest))
        ((_ ())                  (raise "the expression ends too soon: a function's ( isn't closed"))
        ((_ (token & _))         (calc/stuck token "a , or a )"))))

(defun calc/call (f at args-rest)
    (match args-rest
        ((args rest) (list (calc/apply f at args) rest))))

(defun calc/apply (f at args)
    (let one (and (cons? args) (nil? (cdr args))))
    (let x   (if one (car args) 0))
    (cond
        ((member? f (list "min" "max"))
            (if (nil? args) (raise (str "at byte " at ": " f " takes at least one number"))
                (fold/l (car args) (if (eq? f "min") math/min math/max) (cdr args))))
        ((not (member? f (list "sqrt" "abs" "floor" "ceil" "round" "sin" "cos" "tan" "exp")))
            (calc/unknown f at))
        ((not one) (raise (str "at byte " at ": " f " takes one number")))
        ((eq? f "sqrt")  (math/sqrt x))
        ((eq? f "abs")   (math/abs x))
        ((eq? f "sin")   (math/sin x))
        ((eq? f "cos")   (math/cos x))
        ((eq? f "tan")   (math/tan x))
        ((eq? f "exp")   (math/exp x))
        ((calc/whole? x) x)
        ((eq? f "floor") (math/floor x))
        ((eq? f "ceil")  (math/ceil x))
        (#true           (math/round x))))

; Whether rounding x would give it back as it is: a whole number, or a
; float too big for one (or infinite, or not a number), which floor and
; the rest would fault on.
(defun calc/whole? (x) (or (int? x) (calc/big? x) (not (== x x))))

(defun calc/constant (c at)
    (cond
        ((eq? c "pi") math/PI)
        ((eq? c "e")  2.718281828459045)
        (#true        (calc/unknown c at))))

(defun calc/unknown (name at)
    (raise (str "at byte " at ": there's no " name ": the functions are sqrt, abs, floor, ceil, round, sin, cos, tan, exp, min and max, and the constants pi and e")))

(defun calc/stuck (token wanted)
    (raise (str "at byte " (car (reverse token)) ": " (calc/shown token) " where " wanted " should be")))

(defun calc/shown (token)
    (match token
        ((:num n _)  n)
        ((:op o _)   o)
        ((:open _)   "(")
        ((:close _)  ")")
        ((:comma _)  ",")
        ((:name f _) f)))

; --- the arithmetic ----------------------------------------------------
;
; Whole numbers stay whole while the answer is well inside 62 bits, which
; a float's estimate of it tells; past that, it's a float, rather than an
; overflow.

(defun calc/big? (x) (> (math/abs x) 4.0e18))
(defun calc/float (x) (* 1.0 x))

(defun calc/add (a b) (if (and (int? a) (int? b) (not (calc/big? (+ (calc/float a) b)))) (+ a b) (+ (calc/float a) b)))
(defun calc/sub (a b) (if (and (int? a) (int? b) (not (calc/big? (- (calc/float a) b)))) (- a b) (- (calc/float a) b)))
(defun calc/mul (a b) (if (and (int? a) (int? b) (not (calc/big? (* (calc/float a) b)))) (* a b) (* (calc/float a) b)))

(defun calc/div (a b)
    (cond
        ((== b 0)                                          (raise "division by zero"))
        ((and (int? a) (int? b) (== (% a b) 0))            (div a b))
        (#true                                             (/ a b))))

; As C's fmod for floats: the sign of a.
(defun calc/mod (a b)
    (cond
        ((== b 0)                                          (raise "division by zero, in %"))
        ((and (int? a) (int? b))                           (% a b))
        ((calc/whole? (/ a b))                             (raise "% of numbers that far apart"))
        (#true                                             (- a (* b (math/trunc (/ a b)))))))

; A whole power of a whole number is worked out exactly, by squaring.
(defun calc/pow (a b)
    (if (and (int? a) (int? b) (>= b 0))
        (calc/ipow a b 1)
        (math/pow (calc/float a) (calc/float b))))

(defun calc/ipow (a b acc)
    (cond
        ((== b 0)       acc)
        ((== (% b 2) 1) (calc/ipow (calc/mul a a) (div b 2) (calc/mul acc a)))
        (#true          (calc/ipow (calc/mul a a) (div b 2) acc))))
