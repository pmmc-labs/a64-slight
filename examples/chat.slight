; chat: talk with a model on a local ollama, a line at a time (D184).
;
;     chat [model] [url]
;
; The model is llama3.2 unless given. The url, unless given, is where
; OLLAMA_HOST says, as ollama reads it ("host:port", a host without its
; port, or a URL), or http://localhost:11434. Type a
; line and press Enter, and the answer is written as it comes. Backspace
; takes back a character. Keys typed while an answer comes wait for it,
; and then go on the next line. Ctrl-D on an empty line ends the chat, and
; Ctrl-C ends it at once.
;
; The model has lib/tools.slight's tools (D187-D192): read_file,
; list_files, search and calc; remember and recall, notes kept in
; ~/.slight-chat-notes from one chat to the next, whose keys the model is
; told of at the start; write_file, edit_file, run and fetch, which do
; nothing till you've said y to what they show you; and, with CHAT_EXPERT
; set to another model (a bigger one, say), ask_expert, which asks an
; agent on that model. A call and its result
; are shown as they happen. Escape stops the commands and fetches you've
; said y to that are still running, and the model is told they were
; killed; at a y/n question, it's n.
;
; The keyboard's process is the agent's caller too, so an answer's pieces
; come to it among the keys, and one recv takes both; and the tools ask it
; whether they may.

(@include :tools)

(defun prompt () "❯ ")

(defun divider ()
    (str \e "[2m" (str/repeat "─" (tty/screen/cols)) \e "[0m" \n))

(defun main (args env)
    (let model (if (cons? args) (car args) "llama3.2"))
    (let url   (if (and (cons? args) (cons? (cdr args))) (cadr args) (ollama-url env)))
    (let path   (notes-path env))
    (let store  (notes/open path))
    (let keys   (notes/keys store))
    (let expert (lookup "CHAT_EXPERT" env))
    (tty/write \e "[1;32m" "Slight Agent Chat v0.0" \e "[0m" \n
               \n
               \e "[2m"
               "    model : " model \n
               "    url   : " url   \n
               "    tools : read_file, list_files, search, calc, remember, recall, write_file, edit_file, run, fetch" \n
               "    notes : " path " (" (length keys) ")" \n
               (if (str? expert) (str "    expert: " expert \n) "")
               \e "[0m"
               \n
               (divider) (prompt))
    (let extra  (if (str? expert) (list (expert-tool url expert)) ()))
    (join (connect :keypress (typing (agent/new url model (system keys) (append (chat-tools $$ store) extra)) "" ())))
    :bye)

; The notes go in the home directory, so every chat has them.
(defun notes-path (env)
    (let home (lookup "HOME" env))
    (if (str? home) (str home "/.slight-chat-notes") ".slight-chat-notes"))

; A model doesn't know to recall what it can't know it has.
(defun system (keys)
    (if (nil? keys)
        ""
        (str "You keep notes with the remember tool, and read them with recall. You have notes under these keys: "
                (str/join ", " keys) ".")))

; Another agent, on the model called expert, to ask.
(defun expert-tool (url expert)
    (tools/ask-agent "ask_expert"
        (str "Asks an expert (the model " expert ") a question, and gives its answer. It knows nothing of this conversation, so ask in full.")
        (agent/new url expert "Answer briefly and exactly." ())))

; The model's tools. me is the keyboard's process, which those that
; change something ask first, saying which call is asking, so that Escape
; can stop it.
(defun chat-tools (me store)
    (let approve (lambda (what) (ask me (list :approve what $$))))
    (list (tools/read-file) (tools/list-files) (tools/search) (tools/calc) (tools/remember store) (tools/recall store)
          (tools/write-file approve) (tools/edit-file approve) (tools/run approve) (tools/fetch approve)))

; Where OLLAMA_HOST says ollama is: without a scheme it's http, and
; without a port, ollama's.
(defun ollama-url (env)
    (let h (lookup "OLLAMA_HOST" env))
    (cond
        ((or (eq? h :not-found) (eq? h "")) "http://localhost:11434")
        ((>= (bytes/index-of h "://") 0)    (with-port h (+ (bytes/index-of h "://") 3)))
        (#true                              (with-port (str "http://" h) 7))))

; url, with ollama's port if what's after its scheme (from at) has none.
(defun with-port (url at)
    (if (>= (bytes/index-of (bytes/slice url at) ":") 0) url (str url ":11434")))

; Editing a line. pending holds the keys typed during the last answer,
; oldest first; they come before any typed since.
(defun typing (a line pending)
    (match pending
        (()           (recv (key (typed a line key ()))))
        ((key & rest) (typed a line key rest))))

(defun typed (a line key pending)
    (match key
        ((:Enter)
            (if (== (bytes/len line) 0)
                (typing a line pending)
                (do (tty/write \n (divider))
                    (agent/say a line)
                    (answering a pending ()))))
        ((:Backspace)
            (if (== (bytes/len line) 0)
                (typing a line pending)
                (do (tty/write "\u{8} \u{8}")
                    (typing a (str/slice line 0 -1) pending))))
        (("d" :ctrl)
            (if (== (bytes/len line) 0)
                (tty/write "\n")
                (typing a line pending)))
        ((char & mods)
            (if (and (str? char) (or (nil? mods) (eq? mods (list :shift))))
                (do (tty/write char)
                    (typing a (~ line char) pending))
                (typing a line pending)))))


; An answer coming: its pieces are written as they come, and so are the
; tools it calls, and keys wait. A tool that asks waits for y or n.
; Whatever the model gave goes through tools/printable first, so it can't
; work the terminal: hide part of a command it asks to run, say.
; allowed holds the calls let go ahead in this answer, which Escape kills
; (those that have ended, harmlessly).
(defun answering (a pending allowed)
    (recv
        ((:piece  _ text)        (tty/write \e "[3;36m" (tools/printable text) \e "[0m") (answering a pending allowed))
        ((:calling _ name args)  (tty/write \n \e "[2m" "→ " (tools/printable (str name " " (show-args args))) \e "[0m" \n) (answering a pending allowed))
        ((:called _ name result) (tty/write \e "[2m" "← " (tools/printable (str name ": " (show-result result))) \e "[0m" \n) (answering a pending allowed))
        ((:approve what p box)   (approving a pending allowed what p box ()))
        ((:answer _ _)           (tty/write \n (divider) (prompt)) (typing a "" pending))
        ((:error  _ reason)      (tty/write "[" (tools/printable (trouble reason)) "]" \n (prompt)) (typing a "" pending))
        ((:Escape)               (map kill allowed) (answering a pending ()))
        (key                     (answering a (append pending (list key)) allowed))))

; Asking whether a tool's call p may do what it says: y or n (Escape is
; n), and only a key typed since the question; anything else asked about
; meanwhile waits in queued. The tools make what printable already; this
; is for any that don't.
(defun approving (a pending allowed what p box queued)
    (tty/write \e "[1;33m" (tools/printable what) \e "[0m" "  [y/n] ")
    (deciding a pending allowed p box queued))

(defun deciding (a pending allowed p box queued)
    (recv
        (("y")            (tty/write "yes" \n) (reply box #true) (decided a pending (cons p allowed) queued))
        (("n")            (tty/write "no" \n) (reply box #false) (decided a pending allowed queued))
        ((:Escape)        (tty/write "no" \n) (reply box #false) (decided a pending allowed queued))
        ((:approve w q b) (deciding a pending allowed p box (append queued (list (list w q b)))))
        (_                (deciding a pending allowed p box queued))))

(defun decided (a pending allowed queued)
    (match queued
        (()                     (answering a pending allowed))
        (((what p box) & rest)  (approving a pending allowed what p box rest))))

; The arguments, each as its first line, cut at 60 characters.
(defun show-args (args)
    (str/join ", " (map (lambda (arg) (str (car arg) ": " (short (str (cadr arg))))) args)))

(defun short (s)
    (let line (if (== (bytes/len s) 0) "" (car (str/split s \n))))
    (if (or (> (str/len line) 60) (< (bytes/len line) (bytes/len s))) (str (str/slice line 0 60) "…") line))

; A result, short: an error's first line, or how long it is.
(defun show-result (result)
    (if (str/starts-with? result "error:")
        (car (str/split result \n))
        (str (bytes/len result) " bytes")))

; What went wrong, for a person: what the server or the model said, or the
; reason as it is.
(defun trouble (reason)
    (match reason
        ((:http status message) (str "the server said " status ": " message))
        ((:model message)       (str "the model said: " message))
        (_                      (str "error: " reason))))

(main @ARGV %ENV)
