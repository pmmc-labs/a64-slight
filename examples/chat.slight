; chat: talk with a model on a local ollama, a line at a time (D184).
;
;     chat [model] [url]
;
; The model is llama3.2 unless given, at http://localhost:11434. Type a
; line and press Enter, and the answer is written as it comes. Backspace
; takes back a character. Keys typed while an answer comes wait for it,
; and then go on the next line. Ctrl-D on an empty line ends the chat, and
; Ctrl-C ends it at once.
;
; The keyboard's process is the agent's caller too, so an answer's pieces
; come to it among the keys, and one recv takes both.

(@include :agent)

(defun prompt () "❯ ")

(defun divider ()
    (concat \e "[2m" (str-repeat "─" (tty/screen/cols)) \e "[0m" \n))

(defun main (args)
    (let model (if (cons? args) (car args) "llama3.2"))
    (let url   (if (and (cons? args) (cons? (cdr args))) (cadr args) "http://localhost:11434"))
    (let a     (agent/new url model ""))
    (tty/write \e "[1;32m" "Slight Agent Chat v0.0" \e "[0m" \n
               \n
               \e "[2m"
               "    model : " model \n
               "    url   : " url   \n
               \e "[0m"
               \n
               (divider) (prompt))
    (join (connect :keypress (typing a "" ())))
    :bye)

; Editing a line. pending holds the keys typed during the last answer,
; oldest first; they come before any typed since.
(defun typing (a line pending)
    (match pending
        (()           (recv (key (typed a line key ()))))
        ((key & rest) (typed a line key rest))))

(defun typed (a line key pending)
    (match key
        ((:Enter)
            (if (== (str-len line) 0)
                (typing a line pending)
                (do (tty/write \n (divider))
                    (agent/say a line)
                    (answering a pending))))
        ((:Backspace)
            (if (== (str-len line) 0)
                (typing a line pending)
                (do (tty/write "\u{8} \u{8}")
                    (typing a (utf8/substring line 0 (- (utf8/len line) 1)) pending))))
        (("d" :ctrl)
            (if (== (str-len line) 0)
                (tty/write "\n")
                (typing a line pending)))
        ((char & mods)
            (if (and (str? char) (or (nil? mods) (eq? mods (list :shift))))
                (do (tty/write char)
                    (typing a (~ line char) pending))
                (typing a line pending)))))


; An answer coming: its pieces are written as they come, and keys wait.
(defun answering (a pending)
    (recv
        ((:piece  _ text)   (tty/write \e "[3;36m" text \e "[0m") (answering a pending))
        ((:answer _ _)      (tty/write \n (divider) (prompt)) (typing a "" pending))
        ((:error  _ reason) (tty/write "[" (trouble reason) "]" \n (prompt)) (typing a "" pending))
        (key                (answering a (append pending (list key))))))

; What went wrong, for a person: what the server or the model said, or the
; reason as it is.
(defun trouble (reason)
    (match reason
        ((:http status message) (concat "the server said " status ": " message))
        ((:model message)       (concat "the model said: " message))
        (_                      (concat "error: " reason))))

(main @ARGV)
