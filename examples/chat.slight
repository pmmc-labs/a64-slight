; chat: talk with a model on a local ollama, a line at a time (D184).
;
;     chat [model] [url]
;
; The model is llama3.2 unless given. The url, unless given, is where
; OLLAMA_HOST says, as ollama reads it ("host:port", a host without its
; port, or a URL), or http://localhost:11434. Type a
; line and press Enter, and the answer is written as it comes. Backspace
; takes back a character. Keys typed while an answer comes wait for it,
; and then go on the next line. Ctrl-D on an empty line ends the chat, and
; Ctrl-C ends it at once.
;
; The model has lib/tools.slight's tools (D187, D188, D189): read_file,
; list_files and search, and write_file, edit_file, run and fetch, which
; do nothing till you've said y to what they show you. A call and its result
; are shown as they happen. A command runs to its end: one that doesn't
; end is stopped with Ctrl-C, which ends the chat.
;
; The keyboard's process is the agent's caller too, so an answer's pieces
; come to it among the keys, and one recv takes both; and the tools ask it
; whether they may.

(@include :tools)
(@include :ds)

(defun prompt () "❯ ")

(defun divider ()
    (concat \e "[2m" (str-repeat "─" (tty/screen/cols)) \e "[0m" \n))

(defun main (args env)
    (let model (if (cons? args) (car args) "llama3.2"))
    (let url   (if (and (cons? args) (cons? (cdr args))) (cadr args) (ollama-url env)))
    (tty/write \e "[1;32m" "Slight Agent Chat v0.0" \e "[0m" \n
               \n
               \e "[2m"
               "    model : " model \n
               "    url   : " url   \n
               "    tools : read_file, list_files, search, write_file, edit_file, run, fetch" \n
               \e "[0m"
               \n
               (divider) (prompt))
    (join (connect :keypress (typing (agent/new url model "" (chat-tools $$)) "" ())))
    :bye)

; The model's tools. me is the keyboard's process, which those that
; change something ask first.
(defun chat-tools (me)
    (let approve (lambda (what) (ask me (list :approve what))))
    (list (tools/read-file) (tools/list-files) (tools/search)
          (tools/write-file approve) (tools/edit-file approve) (tools/run approve) (tools/fetch approve)))

; Where OLLAMA_HOST says ollama is: without a scheme it's http, and
; without a port, ollama's.
(defun ollama-url (env)
    (let h (lookup "OLLAMA_HOST" env))
    (cond
        ((or (eq? h :not-found) (eq? h "")) "http://localhost:11434")
        ((>= (index-of h "://") 0)          (with-port h (+ (index-of h "://") 3)))
        (#true                              (with-port (concat "http://" h) 7))))

; url, with ollama's port if what's after its scheme (from at) has none.
(defun with-port (url at)
    (if (>= (index-of (substring url at (str-len url)) ":") 0) url (concat url ":11434")))

; Editing a line. pending holds the keys typed during the last answer,
; oldest first; they come before any typed since.
(defun typing (a line pending)
    (match pending
        (()           (recv (key (typed a line key ()))))
        ((key & rest) (typed a line key rest))))

(defun typed (a line key pending)
    (match key
        ((:Enter)
            (if (== (str-len line) 0)
                (typing a line pending)
                (do (tty/write \n (divider))
                    (agent/say a line)
                    (answering a pending))))
        ((:Backspace)
            (if (== (str-len line) 0)
                (typing a line pending)
                (do (tty/write "\u{8} \u{8}")
                    (typing a (utf8/substring line 0 (- (utf8/len line) 1)) pending))))
        (("d" :ctrl)
            (if (== (str-len line) 0)
                (tty/write "\n")
                (typing a line pending)))
        ((char & mods)
            (if (and (str? char) (or (nil? mods) (eq? mods (list :shift))))
                (do (tty/write char)
                    (typing a (~ line char) pending))
                (typing a line pending)))))


; An answer coming: its pieces are written as they come, and so are the
; tools it calls, and keys wait. A tool that asks waits for y or n.
(defun answering (a pending)
    (recv
        ((:piece  _ text)        (tty/write \e "[3;36m" text \e "[0m") (answering a pending))
        ((:calling _ name args)  (tty/write \n \e "[2m" "→ " name " " (show-args args) \e "[0m" \n) (answering a pending))
        ((:called _ name result) (tty/write \e "[2m" "← " name ": " (show-result result) \e "[0m" \n) (answering a pending))
        ((:approve what box)     (approving a pending what box ()))
        ((:answer _ _)           (tty/write \n (divider) (prompt)) (typing a "" pending))
        ((:error  _ reason)      (tty/write "[" (trouble reason) "]" \n (prompt)) (typing a "" pending))
        (key                     (answering a (append pending (list key))))))

; Asking whether a tool may do what it says: y or n, and only a key typed
; since the question; anything else asked about meanwhile waits in queued.
(defun approving (a pending what box queued)
    (tty/write \e "[1;33m" what \e "[0m" "  [y/n] ")
    (deciding a pending box queued))

(defun deciding (a pending box queued)
    (recv
        (("y")          (tty/write "yes" \n) (reply box #true) (decided a pending queued))
        (("n")          (tty/write "no" \n) (reply box #false) (decided a pending queued))
        ((:approve w b) (deciding a pending box (append queued (list (list w b)))))
        (_              (deciding a pending box queued))))

(defun decided (a pending queued)
    (match queued
        (()                     (answering a pending))
        (((what box) & rest)    (approving a pending what box rest))))

; The arguments, each as its first line, cut at 60 bytes.
(defun show-args (args)
    (str-join ", " (map (lambda (arg) (concat (car arg) ": " (short (concat (cadr arg))))) args)))

(defun short (s)
    (let line (if (== (str-len s) 0) "" (car (str-split s \n))))
    (if (or (> (str-len line) 60) (< (str-len line) (str-len s))) (concat (substring line 0 60) "…") line))

; A result, short: an error's first line, or how long it is.
(defun show-result (result)
    (if (starts-with? result "error:")
        (car (str-split result \n))
        (concat (str-len result) " bytes")))

; What went wrong, for a person: what the server or the model said, or the
; reason as it is.
(defun trouble (reason)
    (match reason
        ((:http status message) (concat "the server said " status ": " message))
        ((:model message)       (concat "the model said: " message))
        (_                      (concat "error: " reason))))

(main @ARGV %ENV)
