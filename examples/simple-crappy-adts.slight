; simple-crappy-adts: a binary tree as tagged lists, (:Branch left right)
; and (:Leaf value), with predicates for each, and a printer, which take
; a tree apart by matching its shape.

(defun Branch? (t) (match t ((:Branch _ _) #true) (_ #false)))
(defun Leaf?   (t) (match t ((:Leaf _) #true) (_ #false)))
(defun Tree?   (t) (or (Branch? t) (Leaf? t)))

(defun Branch (left right)
    (list :Branch left right))

(defun Leaf (value)
    (list :Leaf value))

(defun pprint-tree (t depth)
    (match t
        ((:Leaf value)
            (tty/write (str/repeat "  " depth) ":..[" value "]" \n))
        ((:Branch left right)
            (pprint-tree left  (inc depth))
            (pprint-tree right (inc depth)))))

(let tree (Branch
    (Leaf :+)
    (Branch
        (Leaf 10)
        (Leaf 20))))

(pprint-tree tree 0)
