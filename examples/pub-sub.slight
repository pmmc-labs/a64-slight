; pub-sub: a broker passes each published item to its subscribers, and
; on any other message stops them and ends. The broker and each
; subscriber are receive functions; the root publishes two items, stops
; the broker, and reads how it ended: with what its subscribers said as
; they stopped (D243).

(defun notify-all (subs item)
    (match subs
        (() ())
        ((sub & rest)
            (send sub (list :item item))
            (notify-all rest item))))

(defun stop-all (subs)
    (match subs
        (() ())
        ((sub & rest)
            (send sub (list :done $$))
            (stop-all rest))))

(defun subscriber ()
    (recv
        ((:item x)
            (pprint (list $$ :received x))
            (subscriber))
        ((:done from)
            (send from :sub-done)
            :sub-done)))

; n answers, after those in acc, newest first.
(defun gather (n acc)
    (if (== n 0)
        (reverse acc)
        (recv (r (gather (- n 1) (cons r acc))))))

(defun broker (subs)
    (recv
        ((:pub x)
            (notify-all subs x)
            (broker subs))
        (other
            (stop-all subs)
            (gather (length subs) (list :broker-done)))))

(let s1 (spawn (subscriber)))
(let s2 (spawn (subscriber)))
(let b  (spawn (broker (list s1 s2))))
(send b (list :pub 1))
(send b (list :pub 2))
(send b (list :stop))
(read b)
