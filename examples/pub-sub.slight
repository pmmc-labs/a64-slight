; pub-sub, from ts-slight's examples: a broker passes each published item
; to its subscribers, then stops them. Changes: a (recv) in the middle of
; a function became a receive function; if became cond; join gives
; (:ok value).

(defun notify-all (subs item)
    (cond
        ((nil? subs) ())
        (#true
            (send (car subs) (list :item item))
            (notify-all (cdr subs) item))))

(defun stop-all (subs)
    (cond
        ((nil? subs) ())
        (#true
            (send (car subs) (list :done))
            (stop-all (cdr subs)))))

(defun subscriber ()
    (recv
        ((:item x)
            (pprint (list $$ :received x))
            (subscriber))
        (other :sub-done)))

(defun broker (subs)
    (recv
        ((:pub x)
            (notify-all subs x)
            (broker subs))
        (other
            (stop-all subs)
            :broker-done)))

(let s1 (fork (subscriber)))
(let s2 (fork (subscriber)))
(let b  (fork (broker (list s1 s2))))
(send b (list :pub 1))
(send b (list :pub 2))
(send b (list :stop))
(list (join b) (join s1) (join s2))
