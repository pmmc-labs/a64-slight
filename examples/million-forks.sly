// million-forks (after
// https://pkolaczk.github.io/memory-consumption-of-async/): a chain of a
// million processes, each waiting for one message, which it passes on.
// A waiting process holds no stack, just its function, its arguments and
// its mailbox, which is what lets a million of them wait at once.

fun test_actor(next) {
    recv {
        :PING(n) => if nil?(next) {
            tty::write("ALL DONE: ", n, " at ", self, "\n")
        } else {
            send(next, :PING(n + 1))
        }
    }
}

fun setup(n, next) {
    if n == 0 {
        tty::write("READY\n");
        next
    } else {
        setup(n - 1, spawn test_actor(next))
    }
}

let actor_count = 1000000;

tty::write("INIT with ", actor_count, " actors\n");
let last = setup(actor_count, spawn test_actor([]));
tty::write("START\n");
send(last, :PING(0))
