; ten-thousand-forks (after
; https://pkolaczk.github.io/memory-consumption-of-async/, which it ran
; with a million till D276): a chain of ten thousand processes, each
; waiting for one message, which it passes on. A waiting process keeps
; its stack, so a chain costs a stack's touched pages a process, and how
; many can wait at once is how many stacks the system maps.

(defun test-actor (next)
    (recv
        ((:PING n)
            (cond
                ((nil? next) (tty/write "ALL DONE: " n " at " $$ \n))
                (#true       (send next (list :PING (+ n 1))))))))

(defun setup (n next)
    (cond
        ((== n 0)
            (tty/write "READY" \n)
            next)
        (#true
            (setup (- n 1) (fork (test-actor next))))))

(let actor-count 10000)

(tty/write "INIT with " actor-count " actors" \n)
(let last (setup actor-count (fork (test-actor ()))))
(tty/write "START" \n)
(send last (list :PING 0))
