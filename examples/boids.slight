; args: 30 4 8
; boids: Craig Reynolds's flocking birds, in the terminal, with a process
; for each bird. A bird steers by three rules, from the birds it can see:
; toward the middle of them (cohesion), the way they're going
; (alignment), and away from any too close (separation). The sky wraps
; around at its edges. q quits. Its arguments, each optional: how many
; birds (30); a number of frames, to draw them one under another and stop
; rather than redraw the screen till q; and a seed, from 1 to 2147483646:
;
;     node bin/slightc.ts -o boids examples/boids.slight
;     ./boids                                      (q quits)
;     ./boids 60                                   (60 birds)
;     SLIGHT_CLOCK=virtual ./boids 12 4 </dev/null (four frames, at once)
;
; There's no one place where the flock is. Each bird, and the display,
; has a round: a process that collects what every bird says on a tick,
; and hands it over all at once, in the order of the birds' ids. Each
; tick, every bird tells every round where it is and how it's going; when
; its own round hands it the tick, it works out its next move, sleeps a
; tick, and tells them again. The display draws each tick its round hands
; it. So the waiting for a whole tick, and for what comes early from a
; bird already on the next, is written once, in the round; and since the
; rounds are there before any bird is told who's in the flock, nothing a
; bird says can come too soon. A bird sums over the others in the order
; of their ids, so where they go doesn't depend on the order the messages
; came in: any SLIGHT_SCHED gives the same flight.
;
; Space is in columns: a column is 1 wide and a row 2 high, about as a
; terminal's cells are, so the flock isn't stretched. The expected output
; comes from t/models/boids.py.

; --- how birds fly ------------------------------------------------------------

(defun sight () 10.0)           ; how far a bird sees
(defun room () 2.0)             ; how close it lets another come
(defun cohesion-rate () 0.01)
(defun alignment-rate () 0.125)
(defun separation-rate () 0.1)
(defun max-speed () 1.0)
(defun min-speed () 0.5)
(defun tick-ms () 100)

; --- vectors, as (x y) --------------------------------------------------------

(defun v+ (a b) (match (list a b) (((ax ay) (bx by)) (list (+ ax bx) (+ ay by)))))
(defun v- (a b) (match (list a b) (((ax ay) (bx by)) (list (- ax bx) (- ay by)))))
(defun v* (a k) (match a ((x y) (list (* x k) (* y k)))))
(defun v/ (a k) (match a ((x y) (list (/ x k) (/ y k)))))
(defun dot (a b) (match (list a b) (((ax ay) (bx by)) (+ (* ax bx) (* ay by)))))
(defun vsum (vs) (fold/l (list 0 0) v+ vs))

; The shortest way from a to b, on a circle size round.
(defun across (a b size)
    (let d (- b a))
    (cond
        ((> d (/ size 2))         (- d size))
        ((< d (- 0 (/ size 2)))   (+ d size))
        (#true                    d)))

(defun around (x size)
    (cond
        ((< x 0)     (+ x size))
        ((>= x size) (- x size))
        (#true       x)))

; --- steering -----------------------------------------------------------------

; A bird is ((x y) (vx vy)).

; The others bird me sees, from what the flock said, ((id state) ...) in
; the order of the ids: each as (offset velocity distance²), the offset
; being the shortest way to it round the sky.
(defun in-sight (me state heard sky)
    (match (list state sky)
        ((((x y) _) (w h))
            (let seen (map
                (lambda (said)
                    (match said
                        ((id ((px py) v))
                            (let d (list (across x px w) (across y py h)))
                            (list d v (dot d d)))))
                (remove (lambda (said) (== (car said) me)) heard)))
            (filter (lambda (o) (< (caddr o) (* (sight) (sight)))) seen))))

(defun cohesion (others)
    (v* (v/ (vsum (map car others)) (length others)) (cohesion-rate)))

(defun alignment (others v)
    (v* (v- (v/ (vsum (map cadr others)) (length others)) v) (alignment-rate)))

(defun separation (others)
    (let close (filter (lambda (o) (< (caddr o) (* (room) (room)))) others))
    (v* (vsum (map car close)) (- 0 (separation-rate))))

; Not faster than max-speed, nor slower than min-speed unless still.
(defun limit (v)
    (let speed (sqrt (dot v v)))
    (cond
        ((> speed (max-speed))                    (v* v (/ (max-speed) speed)))
        ((and (< speed (min-speed)) (> speed 0))  (v* v (/ (min-speed) speed)))
        (#true                                    v)))

; Where bird me goes next, from what the flock said.
(defun steer (me state heard sky)
    (let others (in-sight me state heard sky))
    (match (list state sky)
        ((((x y) v) (w h))
            (let v2 (limit (if (nil? others)
                v
                (v+ v (v+ (cohesion others) (v+ (alignment others v) (separation others)))))))
            (list (list (around (+ x (car v2)) w) (around (+ y (cadr v2)) h)) v2))))

; --- a round ------------------------------------------------------------------

; What all n birds said on a tick (round-up, since round is a builtin's
; name). It takes (:at tick id value) from any of them, and once it has
; one from each, sends its owner (:round tick heard), heard being
; ((id value) ...) in the order of the ids, and goes on to the next tick.
; A bird that has its own round's tick can be on the next while this
; round still waits for part of it, from a bird that hasn't finished
; telling everyone, so it keeps what comes early. Nothing comes from two
; ticks on: a bird tells every round all of a tick before it can hear all
; of it, so every message of a tick is sent before any of the tick after
; the next. (The cond with no other clause says so: it faults if one
; came.)
(defun round-up (n owner tick heard count early)
    (cond
        ((== count n)
            (send owner (list :round tick (sort-by car heard)))
            (round-up n owner (inc tick) early (length early) ()))
        (#true
            (recv
                ((:at at id value)
                    (cond
                        ((== at tick)       (round-up n owner tick (cons (list id value) heard) (inc count) early))
                        ((== at (inc tick)) (round-up n owner tick heard count (cons (list id value) early)))))))))

; --- a bird -------------------------------------------------------------------

; It waits to hear the rounds (its own, every other bird's, and the
; display's), tells them where it starts, and flies.
(defun bird (me state sky)
    (recv
        ((:flock rounds)
            (tell rounds 0 me state)
            (fly me state sky rounds))))

; Each time its round hands it a tick, it steers by what the flock said,
; sleeps a tick, and tells the rounds where it is on the next.
(defun fly (me state sky rounds)
    (recv
        ((:round tick heard)
            (let next (steer me state heard sky))
            (sleep (tick-ms))
            (tell rounds (inc tick) me next)
            (fly me next sky rounds))))

(defun tell (rounds tick me state)
    (let msg (list :at tick me state))
    (map (lambda (r) (send r msg)) rounds))

; --- the display --------------------------------------------------------------

; Draws each tick its round hands it, till it has drawn frames of them,
; or forever if frames isn't above 0, or till q. Gives how many it drew.
(defun display (sky frames drawn)
    (recv
        ((:round tick heard)
            (draw sky frames tick (map cadr heard))
            (if (== (inc drawn) frames)
                frames
                (display sky frames (inc drawn))))
        (:quit drawn)))

; Which way it's going: one of eight arrows. 0.41421356 is tan 22.5°,
; halfway between an axis and a diagonal.
(defun arrow (v)
    (match v
        ((vx vy)
            (cond
                ((<= (abs vy) (* (abs vx) 0.41421356)) (if (< vx 0) "←" "→"))
                ((<= (abs vx) (* (abs vy) 0.41421356)) (if (< vy 0) "↑" "↓"))
                ((< vx 0)                              (if (< vy 0) "↖" "↙"))
                (#true                                 (if (< vy 0) "↗" "↘"))))))

; The sky as a tuple of rows, each a tuple of one-character strings, with
; a bird put in it. A bird on the far edge, which rounding can leave
; exactly there, is put back on the near one.
(defun put (grid bird)
    (match bird
        (((x y) v)
            (let row (% (floor (/ y 2)) (tuple/len grid)))
            (let col (% (floor x) (tuple/len (tuple/get grid 0))))
            (tuple/set grid row (tuple/set (tuple/get grid row) col (arrow v))))))

; Each frame redraws the whole screen from the top left, or, when there's
; a number of frames, goes under the one before.
(defun draw (sky frames tick birds)
    (match sky
        ((w h)
            (let live (< frames 1))
            (let grid (fold/l (tuple/make (div h 2) (tuple/make w " ")) put birds))
            (let edge (concat "+" (str-repeat "-" w) "+\n"))
            (tty/write
                (if live (concat \e "[H") "")
                edge
                (str-join "" (map (lambda (row) (concat "|" (str-join "" (tuple->list row)) "|\n")) (tuple->list grid)))
                edge
                "tick " tick ", " (length birds) " birds"
                (if live ", q quits" "\n")))))

(defun keys (shown)
    (recv
        (("q" & _) (send shown :quit))
        (_         (keys shown))))

; --- the flock ----------------------------------------------------------------

; Park and Miller's minimal standard generator: 16807 times anything
; below 2^31 stays far below 2^62, so nothing overflows.
(defun random (s) (% (* s 16807) 2147483647))
(defun fraction (s) (/ s 2147483647))

; n birds anywhere in the sky, going any way, from seed.
(defun hatch (n sky seed birds)
    (cond
        ((== n 0) (reverse birds))
        (#true
            (let a (random seed))
            (let b (random a))
            (let c (random b))
            (let d (random c))
            (match sky
                ((w h)
                    (let pos (list (* (fraction a) w) (* (fraction b) h)))
                    (let v (list (* (- (* (fraction c) 2) 1) (max-speed)) (* (- (* (fraction d) 2) 1) (max-speed))))
                    (hatch (dec n) sky d (cons (list pos v) birds)))))))

; The i'th argument as a number, or default if there isn't one.
(defun arg (i args default)
    (match (nth i args)
        (()     default)
        (#false default)
        (k      k)))

; --- the program --------------------------------------------------------------

(let args (map string->int @ARGV))
(let n (arg 0 args 30))
(let frames (arg 1 args 0))
(let sky (list (- (tty/screen/cols) 2) (* 2 (- (tty/screen/rows) 3))))
(let states (hatch n sky (arg 2 args 2026) ()))

(when (< frames 1) (tty/write \e "[?25l" \e "[2J"))
(let shown (fork (display sky frames 0)))
(let birds (map
    (lambda (b) (match b ((i state) (fork (bird i state sky)))))
    (zip (range 0 n) states)))
(let rounds (map (lambda (owner) (fork (round-up n owner 0 () 0 ()))) (cons shown birds)))
(map (lambda (b) (send b (list :flock rounds))) birds)
(let keyboard (connect :keypress (keys shown)))

(let drawn (join shown))
(map kill (cons keyboard (append birds rounds)))
(when (< frames 1) (tty/write \e "[?25h\n"))
(match drawn
    ((:ok k) (concat k " frames")))
