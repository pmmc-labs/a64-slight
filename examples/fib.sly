// fib: the doubly recursive Fibonacci, of the program's argument, or of
// 25 without one. @ARGV holds strings, so n goes through str_to_int.
// Neither recursive call is a tail call, so it exercises the stack.

fun fib(n) {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

let n = if nil?(@ARGV) { 25 } else { str_to_int(car(@ARGV)) };
tty::write("fib(", n, ") = ");
fib(n)
