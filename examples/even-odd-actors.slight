; even-odd-actors: two processes decide whether a number is even by
; passing it back and forth, counting down, until one of them reaches 0
; and tells the actor that asked (the root's top-level, since the root
; is a task and can't take messages, D243). Each is a receive function
; that prints what it got and matches it: a count of 0 is the answer, and
; any other is passed on; anything else (:STOP) ends it. The asker takes
; the four answers as they come, then stops both.

(defun is-it-even? (reply-to)
    (recv
        (msg
            (pprint (list :is-it-even? :got msg))
            (match msg
                ((:IS-EVEN? 0 _)
                    (send reply-to (list :IT-IS-EVEN!))
                    (is-it-even? reply-to))
                ((:IS-EVEN? n peer)
                    (send peer (list :IS-ODD? (- n 1) $$))
                    (is-it-even? reply-to))
                (_ ())))))

(defun is-it-odd? (reply-to)
    (recv
        (msg
            (pprint (list :is-it-odd? :got msg))
            (match msg
                ((:IS-ODD? 0 _)
                    (send reply-to (list :IT-IS-ODD!))
                    (is-it-odd? reply-to))
                ((:IS-ODD? n peer)
                    (send peer (list :IS-EVEN? (- n 1) $$))
                    (is-it-odd? reply-to))
                (_ ())))))

; the asker: wait for n answers, print them, and stop both actors
(defun collect (n answers is-even? is-odd?)
    (cond
        ((== n 0)
            (pprint (reverse answers))
            (send is-even? (list :STOP))
            (send is-odd?  (list :STOP)))
        (#true (collect (- n 1) (cons (recv) answers) is-even? is-odd?))))

; The top level is a task, which can't wait (D243), so an actor does its work.
(defun top-level ()
    (let $reply-to $$)
    (let is-even? (spawn (is-it-even? $reply-to)))
    (let is-odd?  (spawn (is-it-odd?  $reply-to)))
    (pprint $reply-to)
    (send is-even? (list :IS-EVEN? 21 is-odd?))
    (send is-even? (list :IS-EVEN? 36 is-odd?))
    (send is-even? (list :IS-EVEN? 57 is-odd?))
    (send is-even? (list :IS-EVEN? 92 is-odd?))
    (collect 4 () is-even? is-odd?))

(read (spawn (top-level)))
