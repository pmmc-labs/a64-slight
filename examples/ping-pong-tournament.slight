; ping-pong-tournament: N games of ping-pong at once, each played for D
; milliseconds, then the volleys counted.
;
; How many volleys fit depends on the machine, so this example has no
; .expected, and it can't run on the virtual clock that the golden tests
; use: there, time moves only when nothing can run, and the players never
; stop (D110). Run it by hand:
;
;     node bin/slightc.ts -o build/ping-pong-tournament examples/ping-pong-tournament.slight
;     build/ping-pong-tournament 10 100    # games, ms; qemu-aarch64 build/... on x86
;
; Each game is a process that forks its two players, waits for the
; :START gate, serves, sleeps for D ms, stops them, and collects their
; counts. The root starts the games, joins them all, says where a game's
; counts differ from the one before by more than one, and adds them up.
; N and D come from @ARGV, through string->int, and default to 10 and
; 100. A game is forked by name: a function that waits isn't a value.

(defun player (counter)
    (recv
        ((:Serve reply-to)
            (send reply-to (list :Ping $$))
            (player counter))
        ((:Ping reply-to)
            (send reply-to (list :Pong $$))
            (player (+ counter 1)))
        ((:Pong reply-to)
            (send reply-to (list :Ping $$))
            (player (+ counter 1)))
        ((:EXIT reply-to)
            (send reply-to (list :Final counter)))))

(defun ping-pong (duration)
    (let p1 (fork (player 0)))
    (let p2 (fork (player 0)))
    (ping-pong-start p1 p2 duration))

; wait for the :START gate, serve, let them play for duration ms, stop
; them, then collect the two finals, labelled in the order they arrive
(defun ping-pong-start (p1 p2 duration)
    (recv
        (start
            (send p1 (list :Serve p2))
            (sleep duration)
            (send p1 (list :EXIT $$))
            (send p2 (list :EXIT $$))
            (ping-pong-finals p1 p2 ()))))

(defun ping-pong-finals (p1 p2 got)
    (recv
        (final
            (cond
                ((nil? got) (ping-pong-finals p1 p2 final))
                (#true      (list (list p1 got) (list p2 final)))))))

(defun setup-tournament (n duration)
    (cond
        ((== n 0) ())
        (#true    (cons (fork (ping-pong duration)) (setup-tournament (- n 1) duration)))))

(defun start-tournament (pids)
    (map (lambda (pid) (send pid :START) pid) pids))

(defun await-results (pids)
    (map (lambda (pid) (cadr (join pid))) pids))

(defun converged? (lhs rhs tolerance)
    (<= (abs (- (cadr lhs) (cadr rhs))) tolerance))

(defun check-results (results)
    (fold/l (car results) (lambda (acc r)
        (let acc-p1 (car  acc))
        (let acc-p2 (cadr acc))
        (let r-p1   (car  r))
        (let r-p2   (cadr r))
        (cond
            ((and (converged? (cadr acc-p1) (cadr r-p1) 1)
                  (converged? (cadr acc-p2) (cadr r-p2) 1))
                acc)
            (#true
                (tty/write "... results diverged from " acc " to " r \n)
                r)))
        (cdr results)))

(defun calculate-totals (results)
    (fold/l 0 (lambda (acc r)
        (+ acc
            (+ (cadr (cadr (car  r)))
               (cadr (cadr (cadr r))))))
        results))

(let num-games     (if (nil? @ARGV) 10  (string->int (car  @ARGV))))
(let game-duration (if (nil? @ARGV) 100 (string->int (cadr @ARGV))))

(tty/write "Running " num-games " for " game-duration \n)

(tty/write "Setting up Tournament ..." \n)
(let setup-pids (setup-tournament num-games game-duration))
(tty/write "..." \n)

(tty/write "Starting Tournament ..." \n)
(let running-pids (start-tournament setup-pids))
(tty/write "..." \n)

(tty/write "Awaiting Tournament Results ..." \n)
(let results (await-results running-pids))
(tty/write "..." \n)

(tty/write "Analyzing Tournament Results ..." \n)
(tty/write " Final Results : " (check-results results) \n)
(tty/write "Total Messages : " (calculate-totals results) \n)
