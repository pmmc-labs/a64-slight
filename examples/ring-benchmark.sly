// ring-benchmark: a chain of processes passes a count along it, and the
// last one reports back to the root, at an address the root made, since
// it's a task (D243), once for each ping; then an :EXIT goes down the
// chain, and each process ends as it passes it on. The chain's length and
// the number of pings after the first come from @ARGV, through
// str_to_int, and default to 1000 and 3. Each round is reported as it
// completes.

fun test_actor(reply_to, next) {
    recv {
        :EXIT(n) => if nil?(next) {
            tty::write("EXITING at ", self, "\n")
        } else {
            send(next, :EXIT(0))
        }
        :PING(count) => {
            if nil?(next) {
                send(reply_to, :COMPLETED(count, self))
            } else {
                send(next, :PING(count + 1))
            }
            test_actor(reply_to, next)
        }
    }
}

fun setup(n, reply_to, next) {
    if n == 0 {
        tty::write("READY\n");
        next
    } else {
        setup(n - 1, reply_to, spawn test_actor(reply_to, next))
    }
}

fun send_ping($self, pid, count) {
    if count >= 0 {
        send(pid, :PING(0));
        let :COMPLETED(n, from) = read($self);
        tty::write("COMPLETED ", n, " at ", from, "\n");
        send_ping($self, pid, count - 1)
    } else {
        send(pid, :EXIT(0));
        :done
    }
}

let $self = address();
let actor_count = if nil?(@ARGV) { 1000 } else { str_to_int(car(@ARGV)) }
let ping_count  = if nil?(@ARGV) { 3 } else { str_to_int(cadr(@ARGV)) }
tty::write("INIT with ", actor_count, " actors, sending ", ping_count + 1, " pings\n");
let last = setup(actor_count, $self, spawn test_actor($self, []));
tty::write("START\n");
send_ping($self, last, ping_count)
