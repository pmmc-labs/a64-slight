; fold-konts: four ways to map over a 1,440-element list, which must
; agree: a foldr written by hand, a recursive map, the prelude's map,
; and fold/r. The first two aren't tail-recursive, so they take as much
; stack as the list is long.

(defun hand-written-foldr (init f seq)
    (match seq
        (()         init)
        ((x & rest) (f x (hand-written-foldr init f rest)))))

(defun old-map (f lst)
    (match lst
        (()         ())
        ((x & rest) (cons (f x) (old-map f rest)))))

; 0 to 9, 144 times
(let the-big-list (fold/l () (lambda (acc i) (append (range 0 10) acc)) (range 0 144)))

(let by-foldr  (hand-written-foldr () (lambda (x acc) (cons (inc x) acc)) the-big-list))
(let by-map    (old-map inc the-big-list))
(let by-new    (map inc the-big-list))
(let by-fold-r (fold/r () (lambda (x acc) (cons (inc x) acc)) the-big-list))

(pprint (length the-big-list))
(pprint (sum by-foldr))
(pprint (eq? by-foldr by-map))
(pprint (eq? by-map by-new))
(pprint (eq? by-new by-fold-r))
(eq? the-big-list (reverse (reverse the-big-list)))
