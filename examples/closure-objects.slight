; closure-objects: objects are closures over their fields, answering
; messages, which they match on. A Point hands what it doesn't know to its
; Object, its super; each object is given its id when it's made; and a
; message no object knows is answered with (method-not-found m).

(defun Object (oid)
    (lambda (m)
        (match m
            (:oid   oid)
            (:class Object)
            (:===   (lambda (o) (eq? oid (o :oid))))
            (_      (list :method-not-found m)))))

(defun Point (oid x y)
    (let super (Object oid))
    (lambda (m)
        (match m
            (:class  Point)
            (:x      x)
            (:y      y)
            (:+      (lambda (o) (Point (list oid :+ (o :oid)) (+ x (o :x)) (+ y (o :y)))))
            (:-      (lambda (o) (Point (list oid :- (o :oid)) (- x (o :x)) (- y (o :y)))))
            (:==     (lambda (o) (and (== x (o :x)) (== y (o :y)))))
            (:!=     (lambda (o) (or  (!= x (o :x)) (!= y (o :y)))))
            (:to-str (concat "Point:" x ":" y))
            (_       (super m)))))

(let obj1 (Object 1))
(let obj2 (Object 2))

(pprint (obj1 :oid))
(pprint (obj2 :oid))
(pprint ((obj1 :===) obj2))

(let p1 (Point :p1 10 20))
(let p2 (Point :p2 20 10))
(let p3 (Point :p3 20 10))

(pprint (((p1 :+) p2) :to-str))
(pprint (((p1 :+) p2) :oid))
(pprint ((p2 :==)  p3))
(pprint ((p2 :===) p3))
(pprint ((p1 :==) ((((p1 :+) p2) :-) p3)))
(pprint (((p1 :class) :p4 25 30) :to-str))
(p1 :fly)
