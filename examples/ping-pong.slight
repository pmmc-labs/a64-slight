; ping-pong: a pinger and a ponger play 30 rounds. The pinger sends, and
; waits for the reply in the middle of its loop (D167). The root joins
; both.

(defun ponger ()
    (recv
        ((:stop from) :pong-done)
        ((:ping from)
            (send from (list :pong $$))
            (ponger))))

(defun pinger (target n)
    (cond
        ((== n 0)
            (send target (list :stop $$))
            :ping-done)
        (#true
            (send target (list :ping $$))
            (let reply (recv))
            (pprint (list :round n :reply reply))
            (pinger target (- n 1)))))

(let pong (fork (ponger)))
(list (join (fork (pinger pong 30))) (join pong))
