; ping-pong: a pinger and a ponger play 30 rounds. The pinger sends, and
; waits for the reply in the middle of its loop (D167). The ponger answers
; the pinger's stop too, and the root reads how the pinger ended (D243).

(defun ponger ()
    (recv
        ((:stop from)
            (send from :pong-done)
            :pong-done)
        ((:ping from)
            (send from (list :pong $$))
            (ponger))))

(defun pinger (target n)
    (cond
        ((== n 0)
            (send target (list :stop $$))
            (let last (recv))
            (list :ping-done last))
        (#true
            (send target (list :ping $$))
            (let reply (recv))
            (pprint (list :round n :reply reply))
            (pinger target (- n 1)))))

(let pong (spawn (ponger)))
(read (spawn (pinger pong 30)))
