

(defun tokenize-atom (chars tokens acc)
    (match chars
        (()           (tokenizer chars (cons acc tokens)))
        ((" " & rest) (tokenizer rest (cons acc tokens)))
        (("(" & _)    (tokenizer chars (cons acc tokens)))
        ((")" & _)    (tokenizer chars (cons acc tokens)))
        ((c & rest)   (tokenize-atom rest tokens (~ acc c)))))

(defun tokenizer (chars tokens)
    (match chars
        (()           (reverse tokens))
        ((" " & rest) (tokenizer rest tokens))
        (("(" & rest) (tokenizer rest (cons :OPEN  tokens)))
        ((")" & rest) (tokenizer rest (cons :CLOSE tokens)))
        ((c & rest)   (tokenize-atom rest tokens c))))

(defun lexer (tokens acc)
    (match tokens
        (() (reverse acc))
        ((token & rest)
            (cond
                ((sym? token)               (lexer rest (cons token acc)))
                ((int? (string->int token)) (lexer rest (cons (list :INT (string->int token)) acc)))
                (#true                      (lexer rest (cons (list :SYM token) acc)))))))

(defun close-expression (stack acc)
    (match stack
        (()             acc)
        ((:MARK & rest) (cons acc rest))
        ((next & rest)  (close-expression rest (cons next acc)))))

(defun parser (lexed acc)
    (match lexed
        (()              acc)
        ((:OPEN & rest)  (parser rest (cons :MARK acc)))
        ((:CLOSE & rest) (parser rest (close-expression acc ())))
        ((next & rest)   (parser rest (cons next acc)))))

(pprint
    (parser
        (lexer
            (tokenizer
                (str-split "(+ 10 (+ (* 2 10) 30))" "")
            ())
        ())
    ())
)
