
(defun join-and-get (pid)
    (let result (join pid))
    (case (car result)
        (:ok    (cadr result))
        (:error (raise (cadr result)))))

(defun &+ (x y) (+ x y))
(defun &* (x y) (* x y))

(let pid (fork (
    (join-and-get (fork (yield &+)))
    (join-and-get (fork (
        (join-and-get (fork (yield &+)))
        (join-and-get (fork (yield 5)))
        (join-and-get (fork (yield 5)))
    )))
    (join-and-get (fork (
        (join-and-get (fork (yield &*)))
        (join-and-get (fork (
            (join-and-get (fork (yield &+)))
            (join-and-get (fork (yield 2)))
            (join-and-get (fork (
                (join-and-get (fork (yield &+)))
                (join-and-get (fork (yield 1)))
                (join-and-get (fork (yield 1)))
            )))
        )))
        (join-and-get (fork (yield 5)))
    )))
)))

(pprint (join pid))
