
(defun Lambda (params body env) (list :Lambda params body env))
(defun Builtin (body) (list :Builtin body))

(defun bind-params (params args env)
    (match (list params args)
        ((() _)              env)
        (((p & ps) (a & as)) (bind-params ps as (assoc p a env)))))

(defun eval (expr env)
    (pprint (list $$ :EVAL expr))
    (cond
        ((sym?  expr)
            (pprint (list $$ :IS-SYM expr))
            (let found (lookup expr env))
            (pprint (list $$ :FOUND? found))
            (yield found))
        ((cons? expr)
            (pprint (list $$ :CALLING expr))
            (match expr
                ((:lambda params body) (Lambda params body env))
                ((call & args)
                    (yield (application (eval call env) (map (lambda (a) (eval a env)) args) env)))))
        (#true
            (pprint (list $$ :IS-ATOM expr))
            (yield expr))))

(defun application (call args env)
    (pprint (list $$ :APPLY (car call) args))
    (match call
        ((:Lambda params body closure-env)
            (pprint (list $$ :CALL-LAMBDA body args))
            (yield (eval body (bind-params params args closure-env))))
        ((:Builtin body)
            (pprint (list $$ :CALL-BIF body args))
            (yield (body args)))))

(let env
    (assoc :+ (Builtin (lambda (args) (apply + args)))
    (assoc :- (Builtin (lambda (args) (apply - args)))
    (assoc :* (Builtin (lambda (args) (apply * args)))
    (assoc :/ (Builtin (lambda (args) (apply / args)))
    ()))))
)

(let p1 (fork (eval '((lambda (x y) (+ x y)) 10 20) env)))
(let p2 (fork (eval '((lambda (x y) (+ x y)) 10 20) env)))

(pprint (join p1))
(pprint (join p2))
