

(defun Calculator ()
    (recv
        ((:add x y $f) (send $f (+ x y)) (Calculator))
        ((:sub x y $f) (send $f (- x y)) (Calculator))
        ((:mul x y $f) (send $f (* x y)) (Calculator))
        ((:div x y $f) (send $f (/ x y)) (Calculator))
        (other
            (raise (list :WTF other)))))

(defun Future () (recv (msg (yield msg))))

(defun ask? ($to @msg)
    (let $f (spawn (Future)))
    (send $to (append @msg (list $f)))
    (match (join $f)
        ((:ok    value)  value)
        ((:error reason) (raise reason))))

(let calc (spawn (Calculator)))

(pprint (ask? calc (list :add 10 (ask? calc (list :mul 2 10)))))

