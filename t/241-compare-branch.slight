; Comparisons that branch and literals that are immediates (D197). A
; comparison as a cond test is a compare and a branch, an integer literal
; on either side an immediate (or a word, past an immediate's reach); any
; operand that isn't an integer goes to rt_compare. Each of the six must
; agree with the same comparison made as a value. Then + and - with a
; literal: near the edges of 63 bits, past an immediate's reach, and on
; floats.

(defun tests (a b)
    (str (if (< a b) "t" "f") (if (<= a b) "t" "f") (if (> a b) "t" "f")
            (if (>= a b) "t" "f") (if (== a b) "t" "f") (if (!= a b) "t" "f")))

(defun shown (r) (if (eq? r #true) "t" "f"))

(defun as-values (a b)
    (str/join "" (map shown (list (< a b) (<= a b) (> a b) (>= a b) (== a b) (!= a b)))))

(defun lits (a)
    (str (if (< a 2) "t" "f") (if (< 2 a) "t" "f") (if (>= a -3) "t" "f") (if (== a 0) "t" "f")
            (if (!= 5000 a) "t" "f") (if (> a 10000000000) "t" "f") (if (<= -10000000000 a) "t" "f")))

(defun lits-as-values (a)
    (str/join "" (map shown (list (< a 2) (< 2 a) (>= a -3) (== a 0) (!= 5000 a) (> a 10000000000) (<= -10000000000 a)))))

(let nan (math/sqrt -1))
(let max 4611686018427387903)
(let min -4611686018427387904)
(let xs (list -3 0 2 3 5000 10000000000 max min 2.5 -3.0 nan))

(map (lambda (a) (tty/write (lits a) " " (eq? (lits a) (lits-as-values a)) \n)) xs)
(let pairs (list (list 1 2) (list 2 1) (list 2 2) (list -5 5) (list max min) (list min max)
                 (list 1 1.0) (list 1.5 2) (list 2 1.5) (list nan 1) (list 1 nan) (list nan nan)))
(map (lambda (p) (tty/write (tests (car p) (cadr p)) " " (eq? (tests (car p) (cadr p)) (as-values (car p) (cadr p))) \n)) pairs)

(defun arith (a) (list (+ a 2) (- a 3) (+ a -4) (- a 5000) (+ a 10000000000) (- a -10000000000)))
(pprint (arith 1))
(pprint (arith 2.5))
(pprint (list (+ max -1) (- min -1) (- max 0) (+ min 0)))
:done
