(pprint (eq? (list 1 2) (list 1 2)))
(pprint (eq? (list 1 2) (list 1 3)))
(pprint (eq? (list 1 2) (list 1 2 3)))
(pprint (eq? (list 1 2 3) (list 1 2)))
(pprint (eq? (list (list :a) :b) (list (list :a) :b)))
(pprint (eq? (list (list :a) :b) (list (list :c) :b)))
(pprint (eq? (list) ()))
(pprint (eq? (list 1) ()))
(pprint (eq? () (list 1)))
(pprint (eq? (list 1) 1))
(pprint (eq? :a (list :a)))
(pprint (ne? (list 1 2) (list 1 2)))
(ne? (list 1 2) (list 2 1))
