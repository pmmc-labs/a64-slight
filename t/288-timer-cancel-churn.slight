; Timers set and taken back so that their numbers meet in the index
; timer/cancel finds them by (D232), a table of open addressing: 40 that
; stay, then 50 rounds of 80 more, each round taken back in a scrambled
; order, then the 40, last first. Each is found, and taken back, once,
; 4040 times #true, and none is left to fire. t/models/timer-ids.py
; models the index: in a table that left a gap where one was taken back,
; six of them would be lost.

; Aimed at an actor that never takes them, since a task can't be sent to (D243).
(defun set-timers (to n) (map (lambda (i) (after 600000 to i)) (range 0 n)))

(defun trues (bs) (length (filter (lambda (b) b) bs)))

(defun one-round (to ok)
    (let block (set-timers to 80))
    (+ ok (trues (map (lambda (i) (timer/cancel (nth (math/mod (* i 37) 80) block))) (range 0 80)))))

(defun rounds (to r ok)
    (if (== r 0) ok (rounds to (- r 1) (one-round to ok))))

(let to (spawn (recv)))
(let long (set-timers to 40))
(let ok (rounds to 50 0))
(+ ok (trues (map timer/cancel (reverse long))))
