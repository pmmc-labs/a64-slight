; stdin: abq
; Every process connected to :keypress gets every key, in the order they
; connected. On the virtual clock, a key comes each time nothing can run,
; before the clock moves: every key is handled before a 1 ms sleep ends.

(defun listener (name)
    (recv
        ((key & _)
            (pprint (list name key))
            (match key
                ("q" name)
                (_   (listener name))))))

(fork (do (sleep 1) (pprint :slept)))
(let one (connect :keypress (listener :one)))
(let two (connect :keypress (listener :two)))
; Both end on the same key, so both are read at once: a read of the
; second alone would come after its end, which an actor doesn't keep
; (D243); read/any watches both, and tells the root each one's end.
(let first (read/any (list one two)))
(pprint (list (cadr first) (read (if (eq? (car first) one) two one))))
