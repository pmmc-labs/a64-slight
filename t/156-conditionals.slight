; if, when, case, and and or become cond (the expander makes them so). and
; and or stop at the first operand that decides, and, as in Scheme, give
; the last one as it is if they get to it; case compares its topic with
; eq?, and gives () when nothing matches and there's no #true clause. In
; tail position they keep their tail calls, to a receive function too.

(defun show (x) (pprint x) x)

(pprint (if #true :yes :no))
(pprint (if #false :yes :no))
(pprint (if #false :yes))
(pprint (when #true (show 1) 2))
(pprint (when #false (show 1) 2))

(defun kind (x)
    (case x
        (:a         "the symbol a")
        ("b"        "the string b")
        (3          "three")
        ((list 4 5) "a list")))

(pprint (map kind (list :a "b" 3 (list 4 5) :z)))
(pprint (case 1 (2 :two) (#true :other)))

(pprint (and (show #true) (show #false) (show #true)))
(pprint (or (show #false) (show #true) (show #false)))
(pprint (list (and) (or) (and #true) (or #false)))
(pprint (list (and #true 5) (and #false 5) (or #false "five") (or #true "five") (and :only)))

; a loop that recurs from an if: a million times, in constant stack
(defun count-down (n) (if (== n 0) :done (count-down (- n 1))))
(pprint (count-down 1000000))

; a receive function's loop, through case and if
(defun counter (n)
    (recv
        (msg
            (case msg
                (:inc  (counter (+ n 1)))
                (:stop n)
                (#true (if (int? msg) (counter (+ n msg)) (counter n)))))))

(let c (fork (counter 0)))
(send c :inc)
(send c 10)
(send c :ignored)
(send c :inc)
(send c :stop)
(pprint (join c))

; an operand before the last that isn't a boolean faults, as any cond
; test does
(pprint (join (fork (and 5 #true))))
