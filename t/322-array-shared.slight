; Arrays of 4 KB or more, 512 elements, are buffers off the heap, shared,
; as big strings are (D253): made by the prelude's array/generate, mapped,
; folded, sliced and joined; a fork's copy and a join's result, which
; share them; twenty actors each sending one back, changed, and ending
; before it's read, so the buffers outlive their senders (with
; SLIGHT_POISON, as t/run.sh sets it, one freed too soon reads as
; garbage); and 200 MB of them made and dropped by a process whose heap
; holds 64 MB, so the dropped ones must be collected. Expected output
; worked out by hand.

(defun back (to i a) (send to (list i (array/mul a i))))
(defun churn (i total)
    (if (== i 0) total (churn (- i 1) (+ total (array/len (array/make :float 100000 i))))))

(let a (array/generate :float 1000 (lambda (i) (* i 0.5))))
(let b (array/generate :int 2000 (lambda (i) i)))
(pprint (list (array/len a) (array/sum a) (array/get a 999) (array/sum b) (array/fold 0 + b)))
(pprint (list (array/sum (array/slice b 500 1500)) (array/slice b 0 3) (array/sum (array/concat b b))
              (array/sum (array/map (lambda (x) (* x 2)) b)) (array/max (array/map (lambda (x) (- 0 x)) b))))
(pprint (list (eq? a (array/div (array/mul a 2) 2)) (eq? (hash b) (hash (array/generate :int 2000 (lambda (i) i))))))
(pprint (join (fork (array/sum (array/add a 1)))))
(pprint (eq? (cadr (join (fork b))) b))
(let me (address))
(map (lambda (i) (spawn (back me i a))) (range 0 20))
(let got (map (lambda (_) (read me)) (range 0 20)))
(pprint (list (length got) (eq? (map car got) (range 0 20)) (map (lambda (m) (array/sum (cadr m))) got)))
(join (fork (churn 250 0)))
