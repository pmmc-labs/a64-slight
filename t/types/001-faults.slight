; The builtins' faults that types make certain: each, if it ran, would end
; its process, so each is in a process of its own. last-word's s isn't
; known, so nothing is said of it.
(defun last-word (s) (car (str/split s " ")))
(fork (lambda () (str/len 42)))
(fork (lambda () (+ 1 :two)))
(fork (lambda () (cons 1 2)))
(fork (lambda () (join/race (list 1 2))))
(fork (lambda () (car ())))
(fork (lambda () (cadr (list :only))))
(fork (lambda () (if (str/index-of "abc" "b") :found :not)))
(let f 5)
(fork f 1)
(let g (lambda (a b) a))
(fork g 1)
(fork last-word 7)
(last-word "a b")
