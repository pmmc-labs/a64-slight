; socket/peer and rpc/peer (D235): who's at the other end of a Unix
; connection, as the kernel says: its uid, gid and pid. Here both ends
; are this program, so each is this program's own, as id and the shell
; give them, from either end; a process has none, and anything that
; isn't a pid faults. And an rpc handler asks who called it: over a Unix
; socket, the same three; over TCP, ().

(@include :rpc)
(@include :exec)

; What a command printed, as a number.
(defun number-of (cmd)
    (match (exec/run (list "sh" "-c" cmd))
        ((:ok (0 out)) (str->int (str/trim out)))))

(defun server (w)
    (recv
        ((:open l at)  (send w (list :listening at)) (server w))
        ((:accept l c) (connect c (accepted w)) (server w))))

; Each end asks who's at the other while the other is still connected,
; since macOS gives a peer's pid only then: the connecting end asks, and
; says so; the accepted end then asks, tells w, and says so; and only
; then does the connecting end close, and the accepted end after it.
(defun accepted (w)
    (recv ((:open c) (accepted-asks w c))))

(defun accepted-asks (w c)
    (recv
        ((:line _ _)
            (send w (list :peer (socket/peer c)))
            (send c (list :write "asked" \n))
            (accepted-ends c))))

(defun accepted-ends (c)
    (recv ((:eof _) (disconnect c))))

; The connecting end: gives who it connected to.
(defun client ()
    (recv
        ((:open c)
            (let who (socket/peer c))
            (send c (list :write "asked" \n))
            (client-ends c who))))

(defun client-ends (c who)
    (recv ((:line _ _) (disconnect c) who)))

(defun whoami ()
    (rpc/handler "whoami" "Who called." () (lambda () (rpc/peer))))

; The top level is a task (D243): the listener and the accepted end tell
; it at an address.
(pprint (join (fork (socket/peer 42))))
(let mine (list (list :uid (number-of "id -u")) (list :gid (number-of "id -g")) (list :pid (number-of "echo $PPID"))))
(let path "build/t/291-socket-peer.sock")
(let to (address))
(let l (connect :unix/listen path (server to)))
(read to)
(let connected (read (connect :unix path (client))))
(let who (cadr (read to)))
(pprint (list :accepted (eq? who mine)))
(pprint (list :connected (eq? connected (list :ok mine))))
(pprint (map car who))
(pprint (socket/peer $$))
(kill l)

(let rpc-path "build/t/291-rpc.sock")
(match (rpc/listen rpc-path (list (whoami)))
    ((:ok (l2 _))
        (match (rpc/connect rpc-path ())
            ((:ok conn)
                (pprint (list :unix (eq? (rpc/call conn "whoami" ()) (list :ok mine))))
                (rpc/close conn)))
        (kill l2)))
(match (rpc/listen "127.0.0.1:0" (list (whoami)))
    ((:ok (t port))
        (match (rpc/connect (str "127.0.0.1:" port) ())
            ((:ok conn)
                (pprint (list :tcp (rpc/call conn "whoami" ())))
                (rpc/close conn)))
        (kill t)))
:done
; warns: 54:34
