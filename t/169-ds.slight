(@include :ds)
; lib/ds.slight: data structures as processes.

(let c (cell/new 0))
(cell/update c inc)
(cell/update c (lambda (n) (* n 10)))
(pprint (cell/get c))
(cell/set c "x")
(pprint (cell/swap c (lambda (s) (~ s "y"))))
(pprint (cell/get c))

(let d (dict/new))
(dict/put d "name" "slight")
(dict/put d :version 1)
(dict/put d :version 2)
(dict/update d "count" inc 0)
(dict/update d "count" inc 0)
(pprint (list (dict/get d :version) (dict/get d "count") (dict/get d "nope") (dict/size d)))
(pprint (dict/keys d))
(dict/delete d "name")
(pprint (dict/keys d))

(let q (queue/new))
(map (lambda (x) (queue/push q x)) (list 1 2 3))
(pprint (list (queue/pop q) (queue/pop q)))
(queue/push q 4)
(pprint (list (queue/size q) (queue/pop q) (queue/pop q) (queue/pop q)))

; the taker asks first, and waits for the put
(let ch (channel/new))
(let taker (fork (list :took (channel/take ch))))
(sleep 0)
(channel/put ch "hello")
(pprint (join taker))
(channel/put ch "later")
(pprint (channel/take ch))

; a structure of one's own answers with reply
(defun counter (n)
    (recv
        (:inc      (counter (+ n 1)))
        ((:get to) (reply to n) (counter n))))
(let k (fork (counter 0)))
(send k :inc)
(send k :inc)
(pprint (ask k (list :get)))

; asking a structure that has ended raises (:ended pid result)
(kill c)
(let r (join (fork (cell/get c))))
(pprint (list (car r) (car (cadr r)) (eq? (cadr (cadr r)) c) (caddr (cadr r))))

; and one that never answers, (:timeout pid)
(defun sink () (recv (_ (sink))))
(let s (fork (sink)))
(let t (join (fork (ask-within 100 s (list :anything)))))
(list (car t) (car (cadr t)) (eq? (cadr (cadr t)) s))
