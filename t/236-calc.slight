; lib/calc.slight (D190): arithmetic as people write it. Precedence (^
; first, from the right, then a sign, then * / %, then + -), whole numbers
; kept whole while they fit and a float past that, a division that comes
; out whole whole, the functions and constants, the operators a model may
; write (**, ×, ÷, −), and what goes wrong, said with where. Then the tool
; (lib/tools.slight), called as an agent calls it. No libm function but
; sqrt is asked for anything but an exact answer (D76).

(@include :tools)

(defun try (s)
    (match (join (fork (calc/eval s)))
        ((:ok v)     (str v))
        ((:error e)  (str "error: " e))))

(map (lambda (s) (tty/write s "  =>  " (try s) \n))
    (list "1 + 2 * 3" "(1 + 2) * 3" "7 / 2" "6 / 2" "-7 / 2" "7 % 3" "-7 % 3" "10.5 % 3"
          "2 ^ 10" "2 ** 10" "2 ^ 3 ^ 2" "-2 ^ 2" "(-2) ^ 2" "2 ^ -1" "0 ^ 0"
          "2 ^ 61" "2 ^ 62" "10 ^ 18" "3000000000 * 3000000000" "12345678901234567890"
          "0.1 + 0.2" "1.5e3 + .5" "2. * 3" "3 - -2" "+5"
          "sqrt(16)" "sqrt(2)" "abs(-3)" "floor(2.7)" "ceil(2.1)" "round(2.5)" "round(-2.5)" "floor(-2.5)"
          "min(3, 1, 2)" "max(1, 2.5)" "sin(0) + cos(0) + exp(0)" "pi" "2 * pi" "e" "SQRT(16) + PI"
          "2 × 3 ÷ 4" "5 − 2" "1e300 * 1e300" "sqrt(-1)" "floor(1e300)"
          "" "2 +" "(2 + 3" "2 + 3)" "2 3" "1 / 0" "1 % 0" "log(10)" "sqrt(1, 2)" "min()" "2 $ 3"
          "1,000" "." "1e400"))

(pprint (join (fork (tool/call (tools/calc) (list (list "expression" "(2 + 3) * 4 ^ 2 / 8"))))))
(pprint (join (fork (tool/call (tools/calc) ()))))
