; A file that can't be opened ends the connected process before it runs,
; with (:error (name path)); one that fails partway ends it then: a
; directory opens, and fails at the first read, at the recv after
; (:open f). A reader takes nothing but (:read how): anything else is a
; dead letter. The path must be a string, which connect checks in the
; caller.

(defun reader ()
    (recv
        ((:open f)   (pprint :opened) (reader))
        ((:line f s) (reader))
        ((:eof f)    :done)))

(defun poke ()
    (recv
        ((:open f) (send f (list :write "no")) :poked)))

(pprint (join (connect :fs/read "t/data/no-such-file" (reader))))
(pprint (join (connect :fs/read "t/data" (reader))))
(pprint (join (connect :fs/write "build/t/no-such-dir/x" (reader))))
(pprint (join (connect :fs/read "t/data/lines.txt" (poke))))
(pprint (join (fork (disconnect 5))))
(pprint (disconnect $$))
(connect :fs/read 42 (reader))
(pprint :not-reached)
