; Addresses (D243): a task makes them, and reads what's sent to each. A
; message to an address waits for its read; read/any takes the first of
; its sources, in their order, that has something, a pid's being its end;
; a timer can be set for an address, and taken back; and disconnect closes
; one, dropping what waits there and what comes after. ask is the
; prelude's, on them; asking an actor that has ended raises with :ended,
; since its result isn't kept. Only a task makes and reads addresses, and
; only its own, open ones.

(defun echo ()
    (recv
        ((m to) (send to (list :echo m)) (echo))))

(defun later (to ms v)
    (sleep ms)
    (send to v))

(defun cell (v)
    (recv
        ((:get to) (reply to v) (cell v))
        (:stop     v)))

(defun deaf () (recv (_ (deaf))))

(let r (address))
(pprint r)
(send r :to-myself)
(pprint (read r))
(let e (spawn (echo)))
(send e (list :hi r))
(pprint (read r))
(fork (later r 10 :late))
(pprint (read r))

(let w (fork (sleep 20)))
(after 5 r :tick)
(pprint (read/any (list r w)))
(pprint (read/any (list r w)))
(send r :queued)
(pprint (read/any (list w r)))
(pprint (read r))

(let t (after 5 r :never))
(pprint (timer/cancel t))
(send r :dropped)
(disconnect r)
(send r :after-close)
(pprint (join (fork (read r))))
(pprint (join (fork (do (let a (address)) (disconnect a) (read a)))))

(let c (spawn (cell 42)))
(pprint (ask c (list :get)))
(send c :stop)
(pprint (join (fork (ask c (list :get)))))
(let s (spawn (deaf)))
(pprint (join (fork (ask-within 50 s (list :get)))))

(pprint (read (spawn (address))))
(pprint (join (fork (read/any ()))))
(pprint (join (fork (read $$))))
:done
; warns: 58:22
