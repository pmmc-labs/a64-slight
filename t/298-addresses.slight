; Addresses (D243): a task makes them, and reads what's sent to each. A
; message to an address waits for its read; a process's end comes to one
; from a monitor told it (D277); a timer can be set for an address, and
; taken back; and disconnect closes one, dropping what waits there and
; what comes after. ask is the prelude's, on them; asking an actor that
; has ended raises (:ended pid result), the result kept for its parent
; till it has it (D244). Any process makes and reads addresses, its own,
; open ones; a process is no source for read.

(defun echo ()
    (recv
        ((m to) (send to (list :echo m)) (echo))))

(defun later (to ms v)
    (sleep ms)
    (send to v))

(defun cell (v)
    (recv
        ((:get to) (reply to v) (cell v))
        (:stop     v)))

(defun deaf () (recv (_ (deaf))))

(let r (address))
(pprint r)
(send r :to-myself)
(pprint (read r))
(let e (fork echo))
(send e (list :hi r))
(pprint (read r))
(fork later r 10 :late)
(pprint (read r))

(let w (fork sleep 20))
(monitor w r)
(after 5 r :tick)
(pprint (read r))
(pprint (read r))
(send r :queued)
(monitor w r)
(pprint (read r))
(pprint (read r))

(let t (after 5 r :never))
(pprint (timer/cancel t))
(send r :dropped)
(disconnect r)
(send r :after-close)
(pprint (join (fork (lambda () (read r)))))
(pprint (join (fork (lambda () (do (let a (address)) (disconnect a) (read a))))))

(let c (fork cell 42))
(pprint (ask c (list :get)))
(send c :stop)
(pprint (join (fork ask c (list :get))))
(let s (fork deaf))
(pprint (join (fork ask-within 50 s (list :get))))

(pprint (join (fork (lambda () (do (address) :made)))))
(pprint (join (fork (lambda () (read/any ())))))
(pprint (join (fork (lambda () (read $$)))))
:done
