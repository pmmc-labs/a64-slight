; What a terminal would take as a command, or would show in another
; order, made printable for a person (D205): tools/printable, which each
; tool that asks approve uses, so that what the person is asked about is
; what will be done, whatever the model put in it.

(@include :tools)

(defun shown (s) (pprint (tools/printable s)))

; newlines and tabs stay, and so does UTF-8
(shown "plain text, a tab\tand\na newline, é, 日本, 😀")
(shown "colour \e[31mred\e[0m, and \e[8mhidden\e[28m")
(shown "back\rover, bell\u{7}, delete\u{7f}, nul\u{0}")
(shown "C1: \u{9b}31m and \u{85}")
(shown (bytes->string (list 97 155 98 255 32 226 130 65)))
(shown "bidi: \u{202a}abc\u{202e}fed\u{2069} \u{2066}x\u{2069}")

; what it gives is printable already
(shown (tools/printable "\e[1m"))

; a command to run, asked about as it will run
(let me $$)
(let no (lambda (what) (send me (list :asked what)) #false))
(pprint (tool/call (tools/run no) (list (list "command" "echo shown\e[8m; echo hidden\e[28m"))))
(recv ((:asked what) (pprint what)))
