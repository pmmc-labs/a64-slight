; http/request and http/get give up after 30 s, with (:error :timeout)
; (D234), here on the virtual clock: each asks a server that never
; answers, and gives up 30,000 ms after it asked; a request answered
; after 29,000 ms is in time; and none of the three timers holds up the
; program's end once its request is done (D232).

(@include :http)
(@include "data/http-raw.slight")

(defun slow (request) (sleep 29000) (list 200 () "late, but in time"))

; What f gives, and how many milliseconds it took.
(defun timed (f)
    (let t0 (clock/us))
    (let r (f))
    (list r (div (- (clock/us) t0) 1000)))

(defun main ()
    (let me $$)
    (let raw (raw-listen :silent (list (list "/silent" #false)) me))
    (recv ((:silent silent) (serving raw silent))))

(defun serving (raw silent)
    (let l (http/serve 0 slow))
    (recv ((:listening port) (asking raw silent l port))))

(defun asking (raw silent l port)
    (let quiet (str "http://127.0.0.1:" silent "/silent"))
    (pprint (timed (lambda () (http/get quiet))))
    (pprint (timed (lambda () (http/request :post quiet () "x"))))
    (pprint (timed (lambda ()
        (match (http/get (str "http://127.0.0.1:" port "/"))
            ((:ok (status _ body)) (list status body))
            (e                     e)))))
    (kill raw)
    (kill l)
    :done)

(main)
