; The str/ builtins count characters where the bytes/ builtins count bytes
; (D148, D219). Here é is 2 bytes, 日 3 and 😀 4.

(let s "aé日😀")
(pprint (list (bytes/len s) (str/len s)))
(pprint (str/chars s))
(pprint (list (str/len "") (str/chars "")))
; characters [start, end), as JavaScript's slice takes them: an index
; counts from the end when it's negative, each is clamped, and the slice
; is empty unless start comes before end
(pprint (str/slice s 1 3))
(pprint (str/slice s 3 1))
(pprint (str/slice s -5 2))
(pprint (str/slice s 2 99))
(pprint (str/slice s 4 4))
(pprint (str/slice s 9 7))
(pprint (str->bytes (bytes/slice s 1 2)))
; the index of a character, not of a byte
(pprint (list (str/index-of s "😀") (bytes/index-of s "😀")))
(pprint (str/index-of s "日😀"))
(pprint (str/index-of s ""))
(pprint (str/index-of s "x"))
(pprint (str/index-of "" ""))
(pprint (str/well-formed? s))
; what doesn't count is the same for bytes and characters
(pprint (str/split "α,β,γ" ","))
(pprint (str/join "·" (list "α" "β")))
(pprint (list (str/starts-with? "日本語" "日本") (str/ends-with? "日本語" "語")))
(pprint (~ "é" "😀"))
(pprint (eq? (str/join "" (str/chars s)) s))
; and output is the bytes as they are
(tty/write "tty/write: " s "\n")
(pprint (str "str: " s " " 1.5))
; a combining accent is a character of its own
(str/codes "e\u{301}")
