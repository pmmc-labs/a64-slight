; env: SLIGHT_HEAP_MAX=1M
; A mailbox counts toward its process's cap (D301): a process holds its
; heap and its waiting messages against it, and one that's sent more
; than it takes ends (:error (:heap () "its mailbox")), where a joiner or
; a monitor sees it, as one that fills its heap ends. The sender is never
; held up or faulted, and what it sends after that goes nowhere. Before,
; a mailbox had no bound, and the program's memory went with it.

(defun ask (s q) (send s q) (match (read s) ((:process _ i) i)))
(defun mail (s p) (lookup :mail (lookup :memory (ask s (list :process p)))))

; Takes nothing: its messages wait while it sleeps.
(defun sleeper (ms) (sleep ms) :woke)
; Takes each as it comes, and counts them.
(defun taker (n) (recv (:stop n) (_ (taker (+ n 1)))))
; Waits for good, for a message to an address nobody has: what's sent
; to its pid waits in its mailbox.
(defun deaf () (read (address)))
; Sends itself a list, for good.
(defun hoarder (xs) (send $$ xs) (hoarder xs))

(defun flood (p x n) (when (> n 0) (send p x) (flood p x (- n 1))))
(defun batches (p x k) (when (> k 0) (flood p x 100) (yield ()) (batches p x (- k 1))))

(let s  (cadr (open :system)))
(let xs (range 0 100))

; A list of 100 integers waits as its record, 32 bytes, and its copy,
; 1,600: 600 of them are 979,200 bytes, and 642 are 1,047,744, under the
; cap of 1,048,576. The sleeper has no heap.
(let a (fork sleeper 1000))
(flood a xs 600)
(pprint (list :waiting (mail s a)))
(flood a xs 42)
(pprint (list :waiting (mail s a)))

; One more is past it, and the sleeper ends; nine after that go nowhere.
(flood a xs 10)
(pprint (list :slept (join a)))

; A process that takes what it's sent as it comes is never near it,
; however much goes through: 5,000 lists, 8 MB, a hundred at a time.
(let k (fork taker 0))
(batches k xs 50)
(send k :stop)
(pprint (list :took (join k)))

; A process's own sends count as anyone's.
(pprint (list :hoarded (join (fork hoarder xs))))

; A big string is shared, not copied (D253), and waits as a record and
; a handle, 32 bytes each; but it's held, so its bytes count, 8,000 here,
; as they will in the heap of whoever takes it: ten are 80,640, and 131
; would be past the cap.
(let big (str/repeat "x" 8000))
(let b (fork sleeper 1000))
(flood b big 10)
(pprint (list :strings (mail s b)))
(flood b big 190)
(pprint (list :slept (join b)))

; And from another island: the root waits for the end that one list
; too many brings.
(let c (fork deaf))
(fork/on 1 flood c xs 700)
(pprint (list :deaf (join c)))
:done
