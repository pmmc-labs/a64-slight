(200 ("-s" "-i" "--raw" "--http1.1" "--suppress-connect-headers" "--proto" "=https" "-H" "Expect:" "-H" "User-Agent:" "-H" "Accept:" "-X" "GET" "--url" "https://example.test/args" "--" ""))
(200 ("-s" "-i" "--raw" "--http1.1" "--suppress-connect-headers" "--proto" "=https" "-H" "Expect:" "-H" "User-Agent:" "-H" "Accept:" "-X" "POST" "-H" "Content-Type: text/plain" "-H" "x-empty;" "--data-binary" "@-" "--url" "https://example.test/args" "--" "a body" "of two lines"))
(200 ("-s" "-i" "--raw" "--http1.1" "--suppress-connect-headers" "--proto" "=https" "-H" "Expect:" "-H" "User-Agent:" "-H" "Accept:" "-X" "DELETE" "-H" "Content-Type:" "-H" "x-n: 3" "--data-binary" "@-" "--url" "https://example.test/args" "--" ""))
(200 (""))
(200 ("one" "two" ""))
(404 (""))
(error (enotfound "example.test:443"))
(error (econnrefused "example.test:443"))
(error (curl 60 "example.test:8443"))
(error (curl 18 "example.test:443"))
(error (econnreset "example.test:443"))
(200 ("all of it"))
((head 200) (line "one") (line "two") (eof))
((error (econnrefused "example.test:443") #true))
done
