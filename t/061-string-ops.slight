(pprint (~ "foo" "bar"))
(pprint (concat))
(pprint (concat "a" 1 :b (list 1 "x") ()))
(pprint (substring "hello" 1 3))
(pprint (substring "hello" 3 1))
(pprint (substring "hello" -2 10))
(pprint (substring "hello" 2 2))
(pprint (index-of "hello" "l"))
(pprint (index-of "hello" "z"))
(pprint (index-of "hello" ""))
(pprint (index-of "hello" "lo"))
(pprint (str-split "a,b,,c" ","))
(pprint (str-split "" ","))
(pprint (str-split "abc" ""))
(pprint (str-split "abc" "abc"))
(pprint (str-split "a--b--c" "--"))
(pprint (str-join "-" (list "a" 1 :b)))
(pprint (str-join "-" ()))
(pprint (str-join ", " (str-split "x y z" " ")))
(pprint (byte-at "A" 0))
(pprint (bytes->string (list 104 105)))
(pprint (format-num 7 3 "0"))
(pprint (format-num 42 5))
(pprint (format-num 12345 3 "0"))
(pprint (format-num 5 4 "ab"))
(format-num -3 4 "0")
