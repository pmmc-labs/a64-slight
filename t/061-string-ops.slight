(pprint (~ "foo" "bar"))
(pprint (str))
(pprint (str "a" 1 :b (list 1 "x") ()))
(pprint (bytes/slice "hello" 1 3))
(pprint (bytes/slice "hello" 3 1))
(pprint (bytes/slice "hello" -2 10))
(pprint (bytes/slice "hello" 2 2))
(pprint (bytes/index-of "hello" "l"))
(pprint (bytes/index-of "hello" "z"))
(pprint (bytes/index-of "hello" ""))
(pprint (bytes/index-of "hello" "lo"))
(pprint (str/split "a,b,,c" ","))
(pprint (str/split "" ","))
(pprint (str/split "abc" ""))
(pprint (str/split "abc" "abc"))
(pprint (str/split "a--b--c" "--"))
(pprint (str/join "-" (list "a" 1 :b)))
(pprint (str/join "-" ()))
(pprint (str/join ", " (str/split "x y z" " ")))
(pprint (bytes/at "A" 0))
(pprint (bytes->str (list 104 105)))
(pprint (str/pad-start (str 7) 3 "0"))
(pprint (str/pad-start (str 42) 5))
(pprint (str/pad-start (str 12345) 3 "0"))
(pprint (str/pad-start (str 5) 4 "ab"))
(str/pad-start (str -3) 4 "0")
