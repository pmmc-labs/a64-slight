(pprint (uc "hello, World 1"))
(pprint (lc "Hello, WORLD é"))
(pprint (str-repeat "ab" 3))
(pprint (str-repeat "x" 0))
(pprint (starts-with? "hello" "he"))
(pprint (starts-with? "hello" "lo"))
(pprint (starts-with? "he" "hello"))
(pprint (ends-with? "hello" "lo"))
(pprint (ends-with? "hello" "he"))
(pprint (pad-start "7" 3 "0"))
(pprint (pad-start "abc" 2 "0"))
(pprint (pad-end "ab" 5 "xy"))
(pprint (pad-start "5" 4 "ab"))
(pad-end "x" 3 "")
