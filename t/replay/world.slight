; Everything a run takes from outside: @ARGV, keys, the real clock, a file
; read and a file written, the screen's size. t/replay.sh records a run of
; it and replays it, with other arguments, no stdin and no files.

(@include :fs)

(defun keys (n)
    (recv
        (("q") n)
        ((k & _) (pprint (list :key k)) (keys (+ n 1)))))

(let k (connect :keypress (keys 0)))
(after 5 $$ :tick)
(pprint (recv (:tick :ticked)))
(pprint (slurp (car @ARGV)))
(pprint (spew (cadr @ARGV) (list "written")))
(pprint (join k))
(pprint (list :screen (tty/screen/rows) (tty/screen/cols)))
