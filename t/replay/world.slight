; Everything a run takes from outside: @ARGV, %ENV, keys, the real clock,
; a file read and a file written, the screen's size. t/replay.sh records a
; run of it and replays it, with other arguments, no stdin, no files, and
; without the variable it reads.

(@include :fs)

(defun keys (n)
    (recv
        (("q") n)
        ((k & _) (pprint (list :key k)) (keys (+ n 1)))))

; The top level is a task, which can't wait (D243), so an actor does its work.
(defun top-level (argv env)
    (let k (connect :keypress (keys 0)))
    (after 5 $$ :tick)
    (pprint (recv (:tick :ticked)))
    (pprint (list :clock (> (clock/us) 4999) (clock/us)))
    (pprint (slurp (car argv)))
    (pprint (spew (cadr argv) (list "written")))
    (pprint (join k))
    (pprint (list :screen (tty/screen/rows) (tty/screen/cols)))
    (pprint (list :env (lookup "SLIGHT_REPLAY_TEST" env))))

(join (spawn (top-level @ARGV %ENV)))
