; Islands (D256): (islands), 4 as t/run.sh sets it, and (island);
; processes placed with fork/on, one on each island, numbered by their
; own island (#<pid 1@1>), their parent this process on island 0; what
; they send back, and their ends, which their parent joins; after, to a
; process on another island; a monitor across islands, of a process
; killed from a third; a fault on another island, which its parent joins;
; a big string there and back, shared, not copied; what faults: an island
; out of range, and one that isn't an integer; and a join across islands
; from a child of the root's (D277). Expected output worked out by hand.

(defun forever () (recv (_ (forever))))
(defun report (to) (send to (list (island) $$ ^$$)))
(defun watcher (to target)
    (monitor target)
    (send to :watching)
    (recv ((:exit p r) (send to (list :saw p r)))))
(defun echo (to) (recv (x (send to (list :echo (island) x)))))
(defun crash () (car 5))
(defun try (pid)
    (match (join pid)
        ((:ok v)          v)
        ((:error (k & _)) (list :error k))))

(pprint (list (islands) (island)))
(let me (address))
(let ps (map (lambda (k) (fork/on k (report me))) (range 0 4)))
(pprint ps)
(pprint (sort (lambda (a b) (< (car a) (car b))) (map (lambda (_) (read me)) ps)))
(pprint (map (lambda (p) (join p)) ps))

(let e (fork/on 3 (echo me)))
(after 5 e :ping)
(pprint (read me))

(let f (fork/on 1 (forever)))
(let w (fork/on 2 (watcher me f)))
(pprint (read me))
(kill f)
(pprint (read me))

(let c (fork/on 3 (crash)))
(pprint (join c))

(let s (str/repeat "ab" 5000))
(fork/on 1 (send me (list (bytes/len s) (eq? s (~ (str/repeat "ab" 4999) "ab")))))
(pprint (read me))
(fork/on 2 (send me s))
(pprint (eq? (read me) s))

(pprint (try (fork (fork/on 4 ()))))
(pprint (try (fork (fork/on :one ()))))
(pprint (try (fork (join (fork/on 1 ())))))
:done
; warns: 18:22 51:29
