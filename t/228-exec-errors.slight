; A command that can't be started ends its owner before it runs, with
; (:error (name command)): :enoent for one that isn't there (in PATH, or
; at a path), :eacces for one that can't be run, and :io-error for an
; argument with a NUL in it. Anything sent to a command but (:write ...),
; (:eof) or (:read how) is a dead letter. The command must be a list of
; strings, which connect checks in the caller.

(defun run ()
    (recv
        ((:open p)     (pprint :opened) (run))
        ((:line p s)   (run))
        ((:eof p)      (run))
        ((:exited p n) n)))

(pprint (read (connect :exec (list "no-such-command" "-l") (run))))
(pprint (read (connect :exec (list "t/data/no-such-file") (run))))
(pprint (read (connect :exec (list "t/data") (run))))
(pprint (read (connect :exec (list "t/data/lines.txt") (run))))
(pprint (read (connect :exec (list "echo" (str "a" (codes->str (list 0)) "b")) (run))))

(defun poke ()
    (recv
        ((:open p)
            (send p (list :hello))
            (send p (list :eof 1))
            (send p (list :read :nope))
            (run))))

(pprint (read (connect :exec (list "true") (poke))))
(pprint (join (fork (connect :exec "ls" (run)))))
(pprint (join (fork (connect :exec () (run)))))
(connect :exec (list "ls" 1) (run))
(pprint :not-reached)
