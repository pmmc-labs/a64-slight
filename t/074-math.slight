; math/sqrt is correctly rounded everywhere (IEEE 754 requires it), so
; all its digits are exact. math/sin, math/cos, math/tan, math/exp and
; math/pow on floats are only as good as the platform's libm (macOS's tan
; of 1.0 is one bit off glibc's), so apart from exact cases they're
; checked to 12 places. math/pow of two integers is exact (D221).
(defun close? (a b) (< (math/abs (- a b)) 1.0e-12))

(pprint (math/sqrt 2))
(pprint (math/pow 2 10))
(pprint (close? (math/pow 2 0.5) 1.4142135623730951))
(pprint (math/sin 0))
(pprint (math/cos 0))
(pprint (close? (math/tan 1.0) 1.5574077246549023))
(pprint (close? (math/tan 1.0) 1.5574077246))
(pprint (close? (math/exp 1) 2.718281828459045))
(pprint (float? (math/tan 1.0)))
(pprint (math/abs -5))
(pprint (math/abs -2.5))
(pprint (math/min 3 1.5))
(pprint (math/max 3 1.5))
(pprint (math/min 2 2.0))
(math/max -1 -1.5)
