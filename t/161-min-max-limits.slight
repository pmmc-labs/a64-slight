; min and max of two integers compare them as integers. As doubles, the
; integers near 2^62 round together (4611686018427387903 and ...902 are
; both 4.611686018427388e18), and min gave the larger of the two.

(pprint (min 4611686018427387903 4611686018427387902))
(pprint (max -4611686018427387904 -4611686018427387903))
(pprint (min -4611686018427387904 4611686018427387903))
(pprint (max 7 7))
(list (min 1 2) (max 1 2))
