; A process's end is kept for its parent till the parent has it (D244),
; whatever started it (D277, one kind of process), and goes to its
; monitors as it ends: to each one's inbox, or to the address it gave,
; (monitor pid to). A monitor's address closed drops the monitor, so
; nobody's told of an end after.

(defun waits () (recv (_ :woke)))

; Lets everything that can run, run, while the root waits.
(defun pause () (join (fork (yield ()))))

; joined before it ends
(pprint (join (fork 5)))

; the root's own, joined after it ends: kept for the root till it has
; it, :ended after; and a monitor set after its end is told at once
(let a (fork 7))
(pause)
(pprint (join a))
(pprint (join a))
(monitor a)
(pprint (recv (m m)))

; a process that starts four, each waiting for a word, tells the root
; their pids, and stays: their ends are kept for it, not for the root
(defun four (to)
    (send to (list (fork (recv (_ :b))) (fork (recv (_ (yield ()) :c))) (fork (waits)) (fork (recv (_ 9)))))
    (recv (_ :done)))

(let to (address))
(let h (fork (four to)))
(let kids (read to))
(let b (car kids))
(let c (cadr kids))
(let d (nth 2 kids))
(let e (nth 3 kids))

; e, joined by the root after it ends: kept for h, so the root sees it
; too, and it stays kept
(send e :go)
(pause)
(pprint (join e))
(pprint (join e))

; b's and c's ends come to one address, from monitors, as they end
(monitor b to)
(monitor c to)
(send b :go)
(send c :go)
(pprint (read to))
(pprint (read to))

; d's monitor is at an address the root closes: when d is killed,
; nobody's told, and its end is kept for h
(let at (address))
(monitor d at)
(disconnect at)
(kill d)
(pause)
(pprint (join d))
(send h :done)
:done
