; sort, sort-by and zip, in the prelude
(pprint (sort < '(3 1 2)))
(pprint (sort > '(3 1 2)))
(pprint (sort < ()))
(pprint (sort < '(5)))
(pprint (sort < '(2.5 1 -0.5 1.0)))
(pprint (sort < '(1 2 3 4 5 6 7)))
(pprint (sort < '(7 6 5 4 3 2 1)))
; stable: ties keep their order
(pprint (sort (lambda (a b) (< (car a) (car b))) '((2 a) (1 b) (2 c) (1 d) (2 e))))
(pprint (sort-by length '((1 2 3) () (1) (4 5) (6))))
(pprint (sort-by cadr '((a 3) (b 1) (c 3) (d 2))))
; sort-by calls its key once for each element, in order
(pprint (sort-by (lambda (x) (pprint (list :key x)) (- 0 x)) '(1 3 2)))
(pprint (zip '(a b c) '(1 2 3)))
(pprint (zip '(a b) '(1 2 3)))
(pprint (zip '(a b c) '(1)))
(pprint (zip () '(1 2)))
(pprint (lookup :b (zip '(a b c) '(1 2 3))))
; long lists are fine: every loop is a tail call
(defun randoms (n s acc)
    (if (== n 0) acc (randoms (dec n) (% (* s 16807) 2147483647) (cons s acc))))
(let xs (randoms 100000 42 ()))
(let sorted (sort < xs))
(pprint (length sorted))
(pprint (take 3 sorted))
(pprint (take 3 (skip 99997 sorted)))
(defun ordered? (xs)
    (cond
        ((nil? xs)       #true)
        ((nil? (cdr xs)) #true)
        (#true           (and (<= (car xs) (cadr xs)) (ordered? (cdr xs))))))
(pprint (ordered? sorted))
(pprint (eq? (sum sorted) (sum xs)))
(length (zip (range 0 300000) (range 0 300000)))
