(pprint (str/upper "hello, World 1"))
(pprint (str/lower "Hello, WORLD é"))
(pprint (str/repeat "ab" 3))
(pprint (str/repeat "x" 0))
(pprint (str/starts-with? "hello" "he"))
(pprint (str/starts-with? "hello" "lo"))
(pprint (str/starts-with? "he" "hello"))
(pprint (str/ends-with? "hello" "lo"))
(pprint (str/ends-with? "hello" "he"))
(pprint (str/pad-start "7" 3 "0"))
(pprint (str/pad-start "abc" 2 "0"))
(pprint (str/pad-end "ab" 5 "xy"))
(pprint (str/pad-start "5" 4 "ab"))
(str/pad-end "x" 3 "")
