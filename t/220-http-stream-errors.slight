; The ways a stream fails (D181): each is (:error s reason), in place of
; whatever hadn't come yet, with the reasons http/request gives. A URL it
; can't use still gives a pid, and the error comes from it. A refused
; connection ends the stream's process before it can say so (D136), and
; its watcher tells the caller. Then replies that aren't HTTP: none at
; all, a start line that isn't one, a head cut short, a bad chunk size,
; and a chunked body cut short, after its first line (a line it hadn't
; finished doesn't come).

(@include :http)
(@include "data/http-raw.slight")

(defun heard (s acc)
    (recv
        ((:head _ status _) (heard s (cons (list :head status) acc)))
        ((:line _ text)     (heard s (cons (list :line text) acc)))
        ((:eof _)           (reverse (cons (list :eof) acc)))
        ((:error p reason)  (reverse (cons (list :error reason (eq? p s)) acc)))))

(defun streamed (url)
    (cadr (join (fork (heard (http/stream :get url () "" :lines) ())))))

(defun main ()
    (let me $$)
    (let raw (raw-listen :raw (list
        (list "/nothing" "")
        (list "/ssh"     "SSH-2.0-OpenSSH_9.6\r\n\r\n")
        (list "/cut"     "HTTP/1.1 200 OK\r\nContent-Ty")
        (list "/size"    "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nok\n\r\n0\r\n\r\n")
        (list "/short"   (list "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" "3\r\nok\n\r\n" "9\r\nnot all"))) me))
    (recv
        ((:raw port)
            (let base (concat "http://127.0.0.1:" port))
            (let r (list
                (streamed "https://127.0.0.1/")
                (streamed "ftp://127.0.0.1/")
                (streamed "http://127.0.0.1:1/")
                (streamed (concat base "/nothing"))
                (streamed (concat base "/ssh"))
                (streamed (concat base "/cut"))
                (streamed (concat base "/size"))
                (streamed (concat base "/short"))))
            (kill raw)
            (map pprint r)
            :done)))

(main)
