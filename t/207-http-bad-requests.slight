; Requests the server must refuse, sent raw, and the first line of each
; reply: a start line that isn't HTTP is a 400, a head over 64 KB a 431, and
; a body over 8 MB a 413, which is answered before the body is read. A
; client that connects and goes at once is let go. Then a good request.
; Then framing, as RFC 9112 (6.3) has it: a 400 for a Transfer-Encoding
; whose last coding isn't chunked, compared as a word, not looked for in
; the text; for one beside a Content-Length; for Content-Lengths that
; differ, in two headers or one, or that aren't digits; and for a chunk
; whose bytes aren't followed by an empty line. The same Content-Length
; twice is one, chunked is a coding whatever its case, and the codings
; of two headers are one list.

(@include :http)
(@include "data/http-raw.slight")

(defun handler (req) (list 200 () (lookup :body req)))

(defun first-line (reply) (car (str/split reply "\r\n")))

; The first line and the body.
(defun shown (reply) (list (first-line reply) (cadr (str/split reply "\r\n\r\n"))))

; The top level is a task (D243): http/listen starts the server from it.
(match (http/listen 0 handler)
    ((:ok (server port))
        (let r (list
            (first-line (talk port (list "NOPE\r\n\r\n")))
            (first-line (talk port (list (str "GET / HTTP/1.1\r\nX: " (str/repeat "a" 70000) "\r\n"))))
            (first-line (talk port (list "POST / HTTP/1.1\r\nContent-Length: 9000000\r\n\r\n")))
            (first-line (talk port (list "GET / HTTP/1.1\r\nHost: x\r\n\r\n")))
            (quit-at-once port)
            (first-line (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: xchunked\r\n\r\n0\r\n\r\n")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\nabcd")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nContent-Length: 3, 4\r\n\r\nabcd")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nContent-Length: -0\r\n\r\n")))
            (first-line (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabcXY\r\n0\r\n\r\n")))
            (shown (talk port (list "POST / HTTP/1.1\r\nContent-Length: 3\r\ncontent-length: 3\r\n\r\nabc")))
            (shown (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: gzip, Chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n")))
            (shown (talk port (list "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")))))
        (kill server)
        r))
