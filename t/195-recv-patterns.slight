; recv's patterns are match's (D168): they nest, a literal can go
; anywhere, and & takes the rest of a list. A message that no clause's
; pattern fits is still a dead letter.

(defun shapes (total)
    (recv
        ((:rect (w h))   (shapes (+ total (* w h))))
        ((:square s)     (shapes (+ total (* s s))))
        ((:many & sizes) (shapes (+ total (sum sizes))))
        ((:done from)    (send from (list :total total)) :finished)))

(defun classify (from)
    (recv
        (5         (send from :five) (classify from))
        ("hi"      (send from :greeting) (classify from))
        (#true     (send from :yes) (classify from))
        ((_ (_ x)) (send from (list :deep x)) (classify from))
        (:stop     :stopped)))

; The root is a task (D243): the actors answer at an address of its own,
; and it reads each one's end as soon as it has sent the last message.
(let to (address))
(let p (spawn (shapes 0)))
(send p (list :rect (list 2 3)))
(send p (list :rect 2 3))
(send p (list :square 4))
(send p (list :many 1 2 3))
(send p (list :many))
(send p (list :done to))
(let p-end (read p))
(pprint (match (read to) ((:total t) t)))
(pprint p-end)
(let c (spawn (classify to)))
(send c 5)
(send c "hi")
(send c #true)
(send c (list 1 (list 2 3)))
(send c :stop)
(let c-end (read c))
(pprint (list (read to) (read to) (read to) (read to)))
(pprint c-end)
