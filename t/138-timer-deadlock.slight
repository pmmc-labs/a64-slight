; Once the last timer has fired, a root still waiting for a message is
; deadlocked, as before.

(defun wait-for-right ()
    (recv
        (:right :done)))

; The top level is a task, which can't wait (D243), so an actor does its work.
(defun top-level ()
    (after 10 $$ :wrong)
    (wait-for-right))

(read (spawn (top-level)))
