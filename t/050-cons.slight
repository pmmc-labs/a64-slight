(pprint (cons 1 ()))
(pprint (cons 1 (cons 2 (cons 3 ()))))
(pprint (list))
(pprint (list 1 2 3))
(pprint (list 1 (list :a :b) () (list (list))))
(pprint (car (list :a :b :c)))
(pprint (cdr (list :a :b :c)))
(pprint (cdr (list :a)))
(let xs (list 1 2 3 4 5))
(pprint (cadr xs))
(pprint (cddr xs))
(pprint (caddr xs))
(pprint (cadddr xs))
(pprint (cddddr xs))
(pprint (caar (list (list :x :y))))
(pprint (cdar (list (list :x :y))))
; cons shares its tail
(let ys (cons 0 xs))
(pprint ys)
xs
