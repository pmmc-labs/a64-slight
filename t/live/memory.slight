; For t/live.py: what reading or building a value holds on the way to
; its outcome, which only the system can measure. t/live.py runs each
; case on its own and checks its peak; the outcomes are the golden tests'
; (249, 252, 253).
;
;   endless  a JSON string 512 MB long, from a command, read as :json: too
;            big at 64 MB, and the rest never held (D204)
;   deep     30 million arrays, each in the one before, from a command:
;            too big to build, the open ones counted (D205)
;   wide     str/pad-start to a width of 4 GB: the heap's fault, at once,
;            with nothing built outside the heap first (D205)

(defun reading ()
    (recv
        ((:open p)   (send p (list :read :json)) (reading))
        ((:json p v) :a-value)
        ((:eof p)    :eof)))

(defun command (script) (read (connect :exec (list "sh" "-c" script) (reading))))

(defun run-case (name)
    (match name
        ("endless" (command "printf '\"'; head -c 536870912 /dev/zero | tr '\\000' a"))
        ("deep"    (command "head -c 31457280 /dev/zero | tr '\\000' '['; head -c 31457280 /dev/zero | tr '\\000' ']'"))
        ("wide"    (join (fork (str/pad-start (str 1) 4000000000 "x"))))))

(pprint (run-case (car @ARGV)))
