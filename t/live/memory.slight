; For t/live.py: what reading or building a value holds on the way to
; its outcome, which only the system can measure. t/live.py runs each
; case on its own and checks its peak; the outcomes are the golden tests'
; (249, 252, 253).
;
;   endless  a JSON string 512 MB long, from a command, read as :json: too
;            big at 64 MB, and the rest never held (D204)
;   deep     30 million arrays, each in the one before, from a command:
;            too big to build, the open ones counted (D205)
;   wide     str/pad-start to a width of 4 GB: the heap's fault, at once,
;            with nothing built outside the heap first (D205)
;   churn    half a million tasks, each joined, and as many actors, each
;            read: a pid's entry goes once nothing can come of it, and its
;            page once all of the page's have (D244)
;   shared   a 32 MB string held by 40 actors at once, each given it as a
;            spawn's value: shared, not copied (D253), so the peak is one
;            of it, not 1.3 GB
;   dropped  600 strings of 1 MB, each made and dropped: their buffers
;            freed as they're collected (D253)
;   faults n str/replace-all past the heap's cap, n times, each in a task
;            of its own: each faults :heap as its text passes the room
;            the heap has, and frees what it built (H3, L8), so 8 hold no
;            more at the peak than 1 does

(defun reading ()
    (recv
        ((:open p)   (send p (list :read :json)) (reading))
        ((:json p v) :a-value)
        ((:eof p)    :eof)))

(defun command (script) (join (connect :exec (list "sh" "-c" script) reading)))

(defun churn (n)
    (if (== n 0)
        :done
        (do (join (fork (lambda () n)))
            (join (fork (lambda () n)))
            (churn (- n 1)))))

; Holds s till it's told to end, then says how long it was.
(defun holder (to s)
    (recv (:end (send to (bytes/len s)) :done)))

(defun shared (s)
    (let me (address))
    (let actors (map (lambda (_) (fork holder me s)) (range 0 40)))
    (map (lambda (a) (send a :end)) actors)
    (fold/l 0 (lambda (sum _) (+ sum (read me))) actors))

(defun dropped (n total)
    (if (== n 0) total (dropped (- n 1) (+ total (bytes/len (str/repeat "x" 1048576))))))

(defun faults (n s count)
    (if (== n 0)
        count
        (match (join (fork (lambda () (str/replace-all s "" s))))
            ((:error (:heap _ _)) (faults (- n 1) s (+ count 1)))
            (_                    (faults (- n 1) s count)))))

(defun run-case (name n)
    (match name
        ("endless" (command "printf '\"'; head -c 536870912 /dev/zero | tr '\\000' a"))
        ("deep"    (command "head -c 31457280 /dev/zero | tr '\\000' '['; head -c 31457280 /dev/zero | tr '\\000' ']'"))
        ("wide"    (join (fork (lambda () (str/pad-start (str 1) 4000000000 "x")))))
        ("churn"   (churn 500000))
        ("shared"  (shared (str/repeat "x" 33554432)))
        ("dropped" (dropped 600 0))
        ("faults"  (faults n (str/repeat "a" 10000) 0))))

(pprint
    (match @ARGV
        ((name)   (run-case name 0))
        ((name n) (run-case name (str->int n)))))
