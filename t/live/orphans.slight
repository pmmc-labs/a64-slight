; t/live.py's signals, as PID 1: a command leaves a process of its own,
; which is the program's once the command has ended, and which, when it
; ends, stays a zombie unless the program waits for it (D229).

(@include :exec)

(exec/run (list "sh" "-c" "sleep 0.2 & echo left"))
(pprint :left)
(sleep 600000)
