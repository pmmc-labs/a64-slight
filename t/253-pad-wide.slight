; str/pad-start makes its string whole before it fills it (D205), so a
; width past what the heap holds faults :heap at once, rather than build
; that much outside the heap a byte at a time first. Widths that fit are
; as they were.

(defun kind (r)
    (match r
        ((:error (kind _ _)) kind)))

(pprint (kind (join (fork (str/pad-start (str 1) 4000000000 "x")))))
(pprint (str/pad-start (str 42) 6 "0"))
(pprint (str/pad-start (str 3.5) 8 "ab"))
(pprint (str/pad-start (str 12345) 3))
(pprint (str/pad-start (str 7) 3 ""))
(pprint (bytes/len (str/pad-start (str 1) 100000 "-")))
