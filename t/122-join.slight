; join waits for a task to end and gives its result, (:ok value): from
; anywhere (here, inside map's lambda), before or after the task ends.
; Joiners wake in the order they joined, each with the result. A task's
; value is kept till its parent has it, and is :ended after (D244): so
; the root's second join of slow, and its join of w2 after map's.

(defun count-to (n acc)
    (cond
        ((== n 0) acc)
        (#true    (count-to (- n 1) (+ acc 1)))))

(defun waiter (name target)
    (pprint (list name (join target)))
    name)

; forks n processes, so the process table grows while someone is joining
(defun start-all (n)
    (cond
        ((== n 0) :spawned)
        (#true    (fork n) (start-all (- n 1)))))

(let slow  (fork (count-to 5000 0)))
(let quick (fork (list :hello $$)))
(let w1    (fork (waiter :first slow)))
(let w2    (fork (waiter :second slow)))
(pprint (join slow))
(pprint (join slow))
(pprint (join quick))
(pprint (map join (list w1 w2)))
(pprint (join (fork (start-all 3000))))
(join w2)
