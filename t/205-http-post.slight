; A POST with a body and a header. The handler sees the method, the body
; and the header, which the client sent in capitals and the server reads in
; lowercase; its answer is 17 bytes, so the Content-Length says so.

(@include :http)

(defun handler (req)
    (list 200 ()
        (str (if (eq? (lookup :method req) :post) "post" "other")
                " " (lookup :body req)
                " " (lookup "x-who" (lookup :headers req)))))

; The top level is a task (D243): http/listen starts the server from it.
(match (http/listen 0 handler)
    ((:ok (server port))
        (let r (http/request :post (str "http://127.0.0.1:" port "/") (list (list "X-Who" "stevan")) "hello"))
        (kill server)
        r))
