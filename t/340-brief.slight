; What the runtime says of a value, here a fault's, is cut at 64 KB,
; then "...", however big the value prints (D265): a value built by
; doubling 30 times prints as 20 GB. The fault's reason holds the value,
; which is then too big to copy as the task ends, so it ends :heap.
; Expected output from t/models/brief.py.

(defun double (x n) (if (== n 0) x (double (list x x) (- n 1))))
(defun kind (r) (match r ((:error (k _ _)) k) (other other)))

(pprint (kind (join (fork (lambda () (+ 1 (double :leaf 30)))))))
:done
