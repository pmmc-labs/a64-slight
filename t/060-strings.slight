; pprint shows strings in quotes, with nothing inside escaped (D64)
(pprint "hello")
(pprint "")
(pprint "tab\there")
(pprint "two\nlines")
(pprint (list "a" (list "b") 1))
(pprint '"quoted")
(pprint '("in" ("a" "list")))
(pprint (str? "x"))
(pprint (str? :x))
(pprint (str? 1))
; lengths are in bytes
(pprint (bytes/len "hello"))
(pprint (bytes/len ""))
(pprint (bytes/len "é"))
(bytes/len "héllo")
