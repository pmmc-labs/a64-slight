(pprint (reverse '(1 2 3)))
(pprint (reverse ()))
(pprint (length '(a b c)))
(pprint (append '(1 2) '(3)))
(pprint (append () '(3)))
(pprint (sum (range 1 101)))
(pprint (product '(1 2 3 4)))
(pprint (map inc '(1 2)))
(pprint (map dec '(1 2)))
(pprint (filter (lambda (x) (> x 2)) (range 0 6)))
(pprint (remove (lambda (x) (> x 2)) (range 0 6)))
(pprint (fold/l () (lambda (acc x) (cons x acc)) '(1 2 3)))
(pprint (fold/r () (lambda (x acc) (cons x acc)) '(1 2 3)))
(pprint (fold/l "" (lambda (acc s) (~ acc s)) '("a" "b" "c")))
(pprint (take 2 '(a b c)))
(pprint (take 5 '(a b)))
(pprint (skip 2 '(a b c)))
(pprint (skip 5 '(a b)))
(pprint (nth 1 '(a b c)))
(pprint (nth 5 '(a b c)))
(pprint (find (lambda (x) (> x 2)) '(1 2 3 4)))
(pprint (find (lambda (x) (> x 9)) '(1 2 3 4)))
(pprint (member? :b '(a b c)))
(pprint (member? :z '(a b c)))
(pprint (range 0 5))
(pprint (range 3 3))
(pprint (range 5 3))
(let table (assoc :x 1 (assoc :y 2 ())))
(pprint table)
(pprint (lookup :y table))
(pprint (lookup :z table))
(pprint (dotimes 0 3 (lambda (i) (pprint (* i 10)))))
; long lists are fine: every loop in the prelude is a tail call
(length (map inc (range 0 300000)))
