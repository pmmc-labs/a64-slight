; an integer and a float give a float; / always does
(pprint (+ 1 0.5))
(pprint (* 2 1.5))
(pprint (- 7 0.5))
(pprint (/ 10 4))
(pprint (/ 5 1))
(pprint (/ 1.0 4))
(pprint (+ 1 2))
(pprint (< 1 1.5))
(pprint (> 2.5 2))
(pprint (<= 2.0 2))
(pprint (>= 1.9 2))
(pprint (== 1 1.0))
(pprint (!= 1 1.0))
(pprint (== 0.1 (- 0.3 0.2)))
(pprint (float? 1.5))
(pprint (float? 1))
(pprint (num? 1.5))
(pprint (num? 1))
(num? "1")
