; A port must be from 0 to 65535 (or "host:port", t/276), an address a
; string; connect can only hand over an open device. A port that's taken,
; a connection refused and an address that can't be found end the connected
; process as it starts, with (:error (name where)), which the root reads (an
; actor's result isn't kept, D243, so it reads it from the start). A
; listener takes nothing.

(defun never ()
    (recv
        ((:open c) (pprint :not-reached) ())))

(pprint (join (fork (connect :tcp/listen 70000 (never)))))
(pprint (join (fork (connect :tcp/listen :eighty (never)))))
(pprint (join (fork (connect :tcp 80 (never)))))
(pprint (join (fork (connect 5 (never)))))
(pprint (join (fork (connect $$ (never)))))

; (car reason) and whether its where is ours: the port is the system's
(defun failed (r where)
    (list (car r) (car (cadr r)) (eq? (cadr (cadr r)) where)))

; A listener's owner, which tells the root the listener and its port.
(defun telling (to)
    (recv ((:open l port) (send to (list l port)) (never))))

(let to (address))
(connect :tcp/listen 0 (telling to))
(let lp (read to))
(let l (car lp))
(let port (cadr lp))
(pprint (failed (read (connect :tcp/listen port (never))) port))
(send l (list :write "nope"))
(disconnect l)
(let where (str "localhost:" port))
(pprint (failed (read (connect :tcp where (never))) where))
(pprint (read (connect :tcp "localhost" (never))))
(pprint (read (connect :tcp "localhost:notaport" (never))))
