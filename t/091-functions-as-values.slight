(defun square (x) (* x x))
(defun twice (f x) (f (f x)))
(pprint (twice square 3))
(pprint (map square '(1 2 3)))
(pprint (twice (lambda (s) (~ s "!")) "hi"))
; builtins too
(pprint (map car '((a 1) (b 2))))
(pprint (fold/l 0 + (range 1 11)))
(pprint (map str-len '("a" "bb" "")))
(pprint (map pprint '(x y)))
(pprint square)
(pprint car)
(pprint (lambda (x) x))
(pprint (eq? square square))
(pprint (lambda? square))
(pprint (lambda? 1))
(lambda? car)
