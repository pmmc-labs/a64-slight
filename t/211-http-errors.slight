; env: no_proxy=127.0.0.1 NO_PROXY=127.0.0.1
; The ways a request fails before any answer: a scheme it doesn't know, a
; port nobody listens on, over http and https (through curl, D251, whose
; failure is said as the socket's is), and a server that doesn't answer in
; time. Then how URLs are taken apart, https's port 443.

(@include :http)
(@include "data/http-raw.slight")

; The top level is a task (D243), so the raw server says its port with raw-up.
(let up (raw-up (list (list "/silent" #false))))
(let raw (car up))
(let port (cadr up))
(let r (list
    (http/get "ftp://127.0.0.1/")
    (http/get "http://127.0.0.1:1/")
    (http/get "https://127.0.0.1:1/")
    (http/request-within 100 :get (str "http://127.0.0.1:" port "/silent") () "")
    (http/parse-url "http://example.com:8080/a/b?c=d")
    (http/parse-url "http://example.com")
    (http/parse-url "https://example.com/x")))
(kill raw)
r
