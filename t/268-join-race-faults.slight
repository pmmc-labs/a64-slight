; join/race's faults (D220): an empty list, which has nothing to wait for;
; something that isn't a list; something in it that isn't a pid, found
; before it waits; and the caller's own pid. And a root racing processes
; that never end is a deadlock, which says which they are.

(defun kind (pid) (car (cadr (join pid))))
(pprint (kind (fork (lambda () (join/race ())))))
(pprint (kind (fork (lambda () (join/race 5)))))
(pprint (kind (fork (lambda () (join/race (list (fork sleep 5) 3))))))
(pprint (kind (fork (lambda () (join/race (list $$))))))
(join/race (list (fork (lambda () (read (address)))) (fork (lambda () (read (address))))))
; warns: 8:43 9:43
