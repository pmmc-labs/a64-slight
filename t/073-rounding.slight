; math/ceil, math/floor, math/round and math/trunc give integers;
; math/round sends halves up (D72)
(pprint (math/ceil 1.2))
(pprint (math/ceil -1.5))
(pprint (math/floor -1.5))
(pprint (math/trunc -1.5))
(pprint (math/trunc 1.5))
(pprint (math/round 2.5))
(pprint (math/round -2.5))
(pprint (math/round 2.4))
(pprint (math/round -2.6))
(pprint (math/round 7))
(pprint (math/ceil (* 0.5 41)))
(int? (math/floor 2.0))
