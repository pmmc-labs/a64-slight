; float->str (D221): a float as str shows it; or, with digits from 0 to
; 100, in fixed notation, as JavaScript's toFixed: the nearest such
; decimal to the float's exact value, so 1.005, just under 1.005, is
; 1.00, and a tie goes away from zero, so 2.5 is 3. An integer is the
; float it would be. Past 1e21, nan and inf are as str shows them.

(pprint (float->str 2.5 0))
(pprint (float->str -2.5 0))
(pprint (float->str 0.5 0))
(pprint (float->str 1.5 0))
(pprint (float->str 0.125 2))
(pprint (float->str 1.005 2))
(pprint (float->str 1.45 1))
(pprint (float->str 8.345 2))
(pprint (float->str 99.995 2))
(pprint (float->str 9.99 1))
(pprint (float->str 123.456 1))
(pprint (float->str -0.001 2))
(pprint (float->str -0.0 2))
(pprint (float->str 0.0 0))
(pprint (float->str 1.0e-10 3))
(pprint (float->str 0.000001 7))
(pprint (float->str 1234.5678 10))
(pprint (float->str 1.0e20 2))
(pprint (float->str 1.0e21 2))
(pprint (float->str -1.0e21 0))
(pprint (float->str math/PI 20))
(pprint (float->str math/PI 0))
(pprint (float->str 5 3))
(pprint (float->str -7 1))
(pprint (float->str math/INF 2))
(pprint (float->str (math/sqrt -1) 2))
(pprint (float->str 1.0))
(pprint (float->str 5))
(pprint (float->str 0.1))
(pprint (float->str 1.0e21))
(defun kind (pid) (car (cadr (join pid))))
(pprint (kind (fork (float->str 1.5 101))))
(pprint (kind (fork (float->str 1.5 -1))))
(pprint (kind (fork (float->str 1.5 2.0))))
(kind (fork (float->str "1.5")))
