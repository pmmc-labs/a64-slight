; connect :fs/read: the owner hears (:open f) first, f being the file's
; device, then (:line f s) for each line, without its newline, and then
; (:eof f). The next line is cut only when the owner waits again after
; taking the last (D158), so the root's :hello, sent just after the
; connect, comes after (:open f), and a reader that disconnects gets
; nothing more.

(defun reader (lines)
    (recv
        ((:open f)   (pprint (list :open f)) (reader lines))
        ((:line f s) (pprint (list :line f s)) (reader (+ lines 1)))
        ((:eof f)    (pprint (list :eof f)) lines)
        (other       (pprint (list :other other)) (reader lines))))

(let r (connect :fs/read "t/data/lines.txt" (reader 0)))
(send r :hello)
(pprint (join r))

(defun first-line ()
    (recv
        ((:open f)   (first-line))
        ((:line f s)
            (disconnect f)
            (pprint (list :got s))
            (after 0 $$ :check)
            (drain))))

(defun drain ()
    (recv
        (:check :checked)
        (msg    (pprint (list :then msg)) (drain))))

(pprint (join (connect :fs/read "t/data/lines.txt" (first-line))))
