; :unix and :unix/listen (D231): a Unix socket at a path, read and
; written as a TCP connection is. A listener says (:open l path), and its
; connections echo; listening where a listener is, or where a file is, is
; :eaddrinuse; a path with nothing there, or none at all, is :enoent, and
; one too long for a socket :enametoolong; and a listener that's killed
; takes its path with it, so a connection then finds nothing.

(defun server (w)
    (recv
        ((:open l at)  (send w (list :listening at)) (server w))
        ((:accept l c) (connect c (echo)) (server w))))

(defun echo ()
    (recv
        ((:open c)   (echo))
        ((:line c s) (send c (list :write "echo " s \n)) (echo))
        ((:eof c)    (disconnect c))))

; Sends each line in turn, and gives what came back for each.
(defun client (lines)
    (recv ((:open c) (client-send c lines ()))))

(defun client-send (c lines acc)
    (match lines
        (()         (disconnect c) (reverse acc))
        ((s & rest) (send c (list :write s \n)) (client-read c rest acc))))

(defun client-read (c lines acc)
    (recv ((:line _ s) (client-send c lines (cons s acc)))))

(defun wrote ()
    (recv ((:open f) (send f (list :write "not a socket" \n)) (disconnect f))))

(defun kind (joined)
    (match joined
        ((:error (k _)) k)))

; The top level is a task (D243): the listener tells it at an address.
(let path "build/t/284-unix.sock")
(let to (address))
(let l (connect :unix/listen path (server to)))
(pprint (read to))
(pprint (read (connect :unix path (client (list "one" "two")))))
(pprint (read (connect :unix/listen path (server ()))))
(read (connect :fs/write "build/t/284-unix.txt" (wrote)))
(pprint (read (connect :unix/listen "build/t/284-unix.txt" (server ()))))
(pprint (read (connect :unix "build/t/284-unix-nothing.sock" (client ()))))
(pprint (read (connect :unix "" (client ()))))
(pprint (kind (read (connect :unix/listen (str "build/t/" (str/repeat "x" 120)) (server ())))))
(kill l)
(pprint (read (connect :unix path (client ()))))
:done
