; format-num makes its string whole before it fills it (D205), so a width
; past what the heap holds faults :heap at once, rather than build that
; much outside the heap a byte at a time first. Widths that fit are as
; they were.

(defun kind (r)
    (match r
        ((:error (kind _ _)) kind)))

(pprint (kind (join (fork (format-num 1 4000000000 "x")))))
(pprint (format-num 42 6 "0"))
(pprint (format-num 3.5 8 "ab"))
(pprint (format-num 12345 3))
(pprint (format-num 7 3 ""))
(pprint (str-len (format-num 1 100000 "-")))
