; A byte that doesn't start a well-formed UTF-8 sequence is a character of
; its own, as in Go (D148): it counts 1, utf8/chars keeps it as it was, its
; code point is U+FFFD (65533), and nothing faults. Each line is the
; bytes, the count, utf8/valid?, and each character's bytes and code.

(defun show (xs)
    (let s (bytes->string xs))
    (pprint (list xs (utf8/len s) (utf8/valid? s) (map bytes (utf8/chars s)) (map ord (utf8/chars s)))))

(show '(97 128 98))         ; a continuation byte with nothing before it
(show '(226 130 172))       ; €
(show '(226 130))           ; € cut short at the end
(show '(226 130 65))        ; and before an A
(show '(192 128))           ; NUL, overlong
(show '(224 128 175))       ; /, overlong in three bytes
(show '(240 130 130 172))   ; €, overlong in four
(show '(237 159 191))       ; U+D7FF, the last before the surrogates
(show '(237 160 128))       ; U+D800, a surrogate
(show '(238 128 128))       ; U+E000, the first after them
(show '(244 143 191 191))   ; U+10FFFF, the last there is
(show '(244 144 128 128))   ; past it
(show '(245 128 128 128))   ; a lead byte that's never used
(show '(255 254))
(show '(239 191 189))       ; U+FFFD itself, which is well-formed
(show '())

; utf8/chars loses nothing, so joining the characters gives the string back
(let bad (bytes->string '(104 105 255 226 130 33 240 159 152 128)))
(pprint (eq? (str-join "" (utf8/chars bad)) bad))
(pprint (map bytes (utf8/chars bad)))
; a stray byte is a character to utf8/substring and utf8/index-of too
(pprint (bytes (utf8/substring bad 2 5)))
(pprint (list (utf8/index-of bad "!") (utf8/index-of bad "😀")))
; a match has to start a character: 169 is the second byte of é
(let m (bytes->string '(169)))
(list (index-of "é" m) (utf8/index-of "é" m))
