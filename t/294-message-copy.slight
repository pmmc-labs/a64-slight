; Values copied from one process to another (D240): taken into a fork,
; kept as its result, given back by join and join/race, and sent, each a
; copy. The copy goes along a list's spine, taking each cell as it comes
; to it; a car that's a list, and a box of values (a tuple or a closure),
; go on its stack, which a list of 2,000 lists makes grow; a box of up to
; 64 bytes is copied a word at a time, a bigger one, a string, a tuple or
; a closure, by memcpy; static data, a quoted list whole or as a fresh
; list's tail, isn't copied; and values with no pointer among them aren't
; walked at all. Each value goes into a fork and back, and then round an
; echo process; then all of them at once, in one message.

(defun echo ()
    (recv
        ((from v) (send from v) (echo))))

; fork's copy of v, the exit record's, and join's.
(defun back (v) (cadr (join (fork v))))

(defun trip (e xs acc)
    (cond
        ((nil? xs) (reverse acc))
        (#true
            (send e (list $$ (back (car xs))))
            (recv (v (trip e (cdr xs) (cons v acc)))))))

; Equal, a function being called with 1 to compare it.
(defun same? (a b)
    (cond
        ((lambda? a) (and (lambda? b) (eq? (a 1) (b 1))))
        ((cons? a)   (and (cons? b) (same? (car a) (car b)) (same? (cdr a) (cdr b))))
        ((tuple? a)  (and (tuple? b) (same? (tuple->list a) (tuple->list b))))
        (#true       (eq? a b))))

(defun nest (n acc) (if (== n 0) acc (nest (- n 1) (list acc n))))
(defun depth (x n) (if (nil? x) n (depth (car x) (+ n 1))))
(defun seconds (x acc) (if (nil? x) acc (seconds (car x) (+ acc (cadr x)))))
(defun sum3 (a b xs) (+ a (+ b (sum xs))))
(defun capture (a b c d f g xs) (lambda (x) (sum (list x a b c d f g (sum xs)))))

; The top level is a task, which can't wait (D243), so an actor does its work.
(defun top-level ()
    (let k  7)
    (let ys (range 0 10))
    (let s  (range 0 1000))
    (let things (list
        (map (lambda (i) (list (range 0 (math/mod i 7)) (int->str i) (int->float i) (tuple i (list i "s")) (lambda (x) (sum (list x i k (sum ys))))))
             (range 0 50))
        (range 0 20000)
        (nest 1000 ())
        (map (lambda (i) (list i)) (range 0 2000))
        (map (lambda (n) (tuple/make n (list n "t"))) (range 0 12))
        (map (lambda (n) (str/repeat "x" n)) (range 0 100))
        '(1 2 (3 4) "five" 6.5)
        (append (range 0 5) '(7 8 9))
        (list '(a b) '(c d) (range 0 3))
        (list s s s)
        (lambda (x) (+ x (sum ys)))
        (capture 1 2 3 4 5 k ys)
        (map int->float (range 0 100))
        42 :sym #true () 2.5 "short"))
    (let e   (spawn (echo)))
    (let got (cadr (join (spawn (trip e things ())))))
    (send e (list $$ things))
    (let whole (recv (v v)))
    (pprint (map (lambda (p) (same? (car p) (cadr p))) (zip things got)))
    (pprint (same? things whole))
    (let m (nth 0 got))
    (pprint (list
        (sum (map (lambda (x) (length (car x))) m))
        (sum (map (lambda (x) (str->int (cadr x))) m))
        (sum (map caddr m))
        (sum (map (lambda (x) (match (nth 3 x) (#(a (b t)) (+ a b)))) m))
        (sum (map (lambda (x) ((nth 4 x) 1)) m))))
    (pprint (list (length (nth 1 got)) (sum (nth 1 got))))
    (pprint (list (depth (nth 2 got) 0) (seconds (nth 2 got) 0)))
    (pprint (list (length (nth 3 got)) (sum (map car (nth 3 got)))))
    (pprint (map tuple/len (nth 4 got)))
    (pprint (map (lambda (t) (if (== (tuple/len t) 0) () (tuple/get t (- (tuple/len t) 1)))) (nth 4 got)))
    (pprint (list (length (nth 5 got)) (sum (map bytes/len (nth 5 got))) (nth 99 (nth 5 got))))
    (pprint (list (nth 6 got) (nth 7 got) (nth 8 got)))
    (pprint (map sum (nth 9 got)))
    (pprint (list ((nth 10 got) 1) ((nth 11 got) 1)))
    (pprint (sum (nth 12 got)))
    (pprint (list (nth 13 got) (nth 14 got) (nth 15 got) (nth 16 got) (nth 17 got) (nth 18 got)))
    (pprint (join (fork (sum3 k 3 (nth 1 whole)))))
    (pprint (match (join/race (list (fork (nth 3 whole)))) ((p (:ok v)) (sum (map car v)))))
    (pprint (join (fork (+ k 1))))
    :done)

(join (spawn (top-level)))
