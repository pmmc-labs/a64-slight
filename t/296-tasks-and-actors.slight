; One kind of process (D277): fork starts one, which is joined for its
; value, sent to, timed with after, and monitored, whatever it does; the
; root waits for a message too. A message to one that has ended just
; disappears (D92). And :system says no kind.

(defun counter (n)
    (recv
        (:inc  (counter (inc n)))
        (:stop n)))

(defun info (pid)
    (recv ((:open s) (send s (list :process pid)) (recv ((:process _ i) (lookup :kind i))))))

(pprint (join (fork (+ 1 2))))

(let c (fork (counter 0)))
(send c :inc)
(send c :inc)
(send c :stop)
(pprint (join c))

(pprint (join (fork (send (fork (sleep 10)) :hi))))
(pprint (join (fork (do (after 10 (fork (sleep 10)) :hi) :set))))
(pprint (join (fork (do (let t (fork 5)) (monitor t) (recv ((:exit _ r) r))))))

(send $$ :to-myself)
(pprint (recv (m m)))

(let t (fork :done))
(join t)
(pprint (send t :late))

(pprint (join (connect :system (info $$))))
:end
