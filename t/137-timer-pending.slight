; A pending timer is something that can still happen: a root waiting for
; a message that only a timer will send isn't deadlocked, and the program
; doesn't end while a timer is pending, even once the root has its value.
; A timer whose process has ended is dropped, when it's due or when
; nothing else can run before it (D232): a killed sleeper doesn't wake,
; and a message to it disappears.

(defun late (ms)
    (sleep ms)
    (pprint (list :late ms)))

(defun wait-for-wake ()
    (recv
        (:wake (pprint :woke) :root-done)))

; A killed sleeper, an actor so that a timer can be aimed at it, whose
; result isn't kept (D243): read after it's killed, it has :ended.
(let sleeper (spawn (late 20)))
(after 30 sleeper :hello)
(sleep 5)
(kill sleeper)
(pprint (read sleeper))

; The root is a task, which can't take messages, so an actor waits for
; the wake-up.
(defun waker ()
    (fork (late 50))
    (after 10 $$ :wake)
    (wait-for-wake))

(read (spawn (waker)))
