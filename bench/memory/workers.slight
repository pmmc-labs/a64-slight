; n workers, each keeping three cells from one message to the next, sent m lists each; then the root sleeps.
; (bench/memory.py; docs/memory-review-2026-11-13.md has what each showed.)

(defun worker (st)
    (recv
        ((:work x) (worker (list x (+ x 1) (car st))))
        (:stop     st)))
(defun start (n acc) (if (== n 0) acc (start (- n 1) (cons (fork worker (list 0)) acc))))
(defun rounds (ps m)
    (when (> m 0)
        (map (lambda (p) (send p (list :work m))) ps)
        (yield ())
        (rounds ps (- m 1))))
(let n (str->int (car @ARGV)))
(let m (str->int (cadr @ARGV)))
(let ps (start n ()))
(rounds ps m)
(sleep 2500)
(length ps)
