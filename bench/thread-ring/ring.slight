; ring: thread-ring with the ring's size its second argument, m processes
; in a ring passing a token on n times, to see what a hop costs as the
; processes waiting at once grow (BENCHMARKS.md, 11 Nov): ring n m.

(defun member (id root)
    (recv ((:next next) (relay id next root))))

(defun relay (id next root)
    (recv
        (0 (send root id))
        (n (send next (- n 1)) (relay id next root))))

; The top level is a task, which can't wait (D243), so an actor does its
; work, and the root gives its value.
(defun top-level (argv)
    (let me   $$)
    (let ring (map (lambda (id) (fork member id me)) (range 1 (+ 1 (str->int (cadr argv))))))
    (map (lambda (pair) (send (car pair) (list :next (cadr pair)))) (zip ring (append (cdr ring) (list (car ring)))))
    (send (car ring) (str->int (car argv)))
    (recv (id id)))

(cadr (join (fork top-level @ARGV)))
