; parallel-fib: 64 processes each work out fib(k), and their answers are
; summed. Work a language with more than one core can spread; slight runs
; them all on one.

(defun fib (n)
    (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(let k       (string->int (car @ARGV)))
(let workers (map (lambda (_) (fork (fib k))) (range 0 64)))
(sum (map (lambda (w) (match (join w) ((:ok v) v))) workers))
