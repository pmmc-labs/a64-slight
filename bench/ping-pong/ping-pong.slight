; ping-pong: n round trips between two processes, each a message there
; and one back.

(defun pong ()
    (recv
        ((:ping from i) (send from (list :pong i)) (pong))
        ((:stop)        :stopped)))

(defun ping (p i n)
    (cond
        ((== i n) (send p (list :stop)) n)
        (#true
            (send p (list :ping $$ i))
            (recv ((:pong _) (ping p (+ i 1) n))))))

; The top level is a task, which can't wait (D243), so an actor does its
; work, and the root gives its value.
(defun top-level (argv)
    (ping (spawn (pong)) 0 (str->int (car argv))))

(cadr (join (spawn (top-level @ARGV))))
