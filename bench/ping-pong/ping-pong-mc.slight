; ping-pong on every island (D256): a pair on each of (islands) islands,
; each its share of the n round trips, never leaving its island; what
; every core gives many independent conversations, as a server's
; connections are.

(defun pong ()
    (recv
        ((:ping from i) (send from (list :pong i)) (pong))
        ((:stop)        :stopped)))

; The count, to the top level's address once the share's done.
(defun ping (to p i n)
    (cond
        ((== i n) (send p (list :stop)) (send to n))
        (#true
            (send p (list :ping $$ i))
            (recv ((:pong _) (ping to p (+ i 1) n))))))

(defun pair (to n)
    (ping to (spawn (pong)) 0 n))

(defun total (from k acc)
    (if (== k 0) acc (total from (- k 1) (+ acc (read from)))))

(let n  (str->int (car @ARGV)))
(let k  (islands))
(let me (address))
(dotimes 0 k (lambda (b) (spawn/on b (pair me (- (div (* (+ b 1) n) k) (div (* b n) k))))))
(total me k 0)
