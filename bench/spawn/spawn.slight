; spawn: n processes started one after another, each sending its number
; back and ending; their numbers summed. Nothing takes a process's own
; value, and none is kept: each fork's pid is thrown away (D297).

(defun start (i n me)
    (when (< i n)
        (fork send me i)
        (start (+ i 1) n me)))

(defun gather (n acc)
    (if (== n 0) acc (recv (i (gather (- n 1) (+ acc i))))))

; A process of its own does the work, and the root gives its value: once
; the top level couldn't wait (D243); it can since D277, and this is kept
; so that the numbers are of the same program as before.
(defun top-level (argv)
    (let n (str->int (car argv)))
    (start 0 n $$)
    (gather n 0))

(cadr (join (fork top-level @ARGV)))
