; fan-in: 100 processes each send their number n/100 times to one, which
; sums what it's sent: many senders, one mailbox.

(defun sender (to s m)
    (when (> m 0)
        (send to s)
        (sender to s (- m 1))))

(defun gather (n sum)
    (if (== n 0) sum (recv (s (gather (- n 1) (+ sum s))))))

; The top level is a task, which can't wait (D243), so an actor does its
; work, and the root gives its value.
(defun top-level (argv)
    (let n  (str->int (car argv)))
    (let me $$)
    (dotimes 1 101 (lambda (s) (fork (sender me s (div n 100)))))
    (gather n 0))

(cadr (read (spawn (top-level @ARGV))))
