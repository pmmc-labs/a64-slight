; nqueens, Gabriel's, as in the R7RS benchmarks: the ways n queens can be
; placed, trying each row in turn, with lists: x the rows still to try, y
; those passed over for this column, z those placed. Calls, and lists
; made and dropped.

(defun ok? (row dist placed)
    (match placed
        (() #true)
        ((q & rest)
            (and (not (== q (+ row dist)))
                 (not (== q (- row dist)))
                 (ok? row (+ dist 1) rest)))))

(defun try-it (x y z)
    (match x
        (() (if (nil? y) 1 0))
        ((q & rest)
            (+ (if (ok? q 1 z) (try-it (append rest y) () (cons q z)) 0)
               (try-it rest (cons q y) z)))))

(try-it (range 1 (+ (string->int (car @ARGV)) 1)) () ())
