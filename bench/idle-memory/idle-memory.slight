; idle-memory: n processes, all waiting for a message at once, then each
; asked for 1 and ending; the answers summed. Its peak memory, less
; startup's, over n is what a waiting process costs (with its pid kept in
; a list, as the other languages keep theirs).

(defun idle () (recv ((:ping from) (send from 1))))

(defun start (n acc)
    (if (== n 0) acc (start (- n 1) (cons (spawn (idle)) acc))))

(defun gather (n acc)
    (if (== n 0) acc (recv (i (gather (- n 1) (+ acc i))))))

; The top level is a task, which can't wait (D243), so an actor does its
; work, and the root gives its value.
(defun top-level (argv)
    (let n (str->int (car argv)))
    (map (lambda (p) (send p (list :ping $$))) (start n ()))
    (gather n 0))

(cadr (read (spawn (top-level @ARGV))))
