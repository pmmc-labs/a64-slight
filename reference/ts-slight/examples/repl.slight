;; -----------------------------------------------------------------------------
;; Style Utils
;; -----------------------------------------------------------------------------

(defun lookup-style (name)
    (case name
        (:BOLD      1)
        (:FAINT     2)
        (:ITALIC    3)
        (:UNDERLINE 4)
        (:INVERT    7)
        (:HIDE      8)
        (:STRIKE    9)))

(defun reset-style    () (~ \e "[0m"))

(defun render-styles (styles) (concat \e "[" (str-join ";" styles) ";m"))

(defun rgb->fg-color (rgb) (cons 38 (cons 2 rgb)))
(defun rgb->bg-color (rgb) (cons 48 (cons 2 rgb)))

;; -----------------------------------------------------------------------------
;; Screen & Cursor Utils
;; -----------------------------------------------------------------------------

(defun clear-to-eol   () (~ \e "[0K"))
(defun clear-to-sol   () (~ \e "[1K"))
(defun clear-line     () (~ \e "[2K"))

(defun clear-to-eos   () (~ \e "[0J"))
(defun clear-to-tos   () (~ \e "[1J"))
(defun clear-screen   () (~ \e "[2J"))

(defun home-cursor    () (~ \e "[H"))
(defun show-cursor    () (~ \e "[?25l"))
(defun hide-cursor    () (~ \e "[?25h"))
(defun save-cursor    () (~ \e "[u"))
(defun restore-cursor () (~ \e "[s"))

(defun move-cursor-to (row col) (concat \e "[" row ";" col "H"))

;; -----------------------------------------------------------------------------
;; Constructors
;; -----------------------------------------------------------------------------

(defun Style (fg-color bg-color styles)
    (lambda (contents)
        (concat
            (render-styles
                (append (map lookup-style styles)
                    (append
                        (rgb->fg-color (lookup-color fg-color))
                        (rgb->bg-color (lookup-color bg-color)))))
            contents (reset-style))))


(defun Cell (width align pad-char)
    (lambda (style content)
        (let len (str-len content))
        (style
            (if (== width len) content
            (if (<  width len) (substring content 0 width)
            (if (>  width len) (do
                (let pad (str-repeat pad-char (- width len)))
                (case align
                    (:LEFT   (~ content pad))
                    (:RIGHT  (~ pad content))
                    (:CENTER
                        (let w   (/ (- width len) 2))
                        (let lhs (str-repeat pad-char (ceil  w )))
                        (let rhs (str-repeat pad-char (floor w )))
                        (concat lhs content rhs))))
                        ()))))))

(defun Tile (height width pad-char)
    (lambda (style content)
        (map style
            (map (lambda (c)
                (if (> (str-len c) width)
                    (substring c 0 width)
                    (pad-end   c width pad-char)))
            (if (> (length content) height)
                (take height content)
                (append
                    content
                    (dotimes 0 (- height (length content))
                        (lambda (i) (str-repeat pad-char width)))))))))


;; -----------------------------------------------------------------------------
;; REPL
;; -----------------------------------------------------------------------------

(defun REPL/Styles (info prompt input output)
    (lambda (m content)
        (case m
            (:info   (info   content))
            (:prompt (prompt content))
            (:input  (input  content))
            (:output (output content))
            (#true
                raise((~ "Unknown style type " m))))))

(defun REPL/History (idx history)
    (lambda (m)
        ;(pprint (list :HISTORY m :idx idx :history history))
        (case m
            (:empty?  (nil? history))
            (:current (nth idx history))
            (:prev
                ;(pprint (list :HISTORY :idx idx :length (length history) :history history))
                (if (>= (inc idx) (length history))
                    (REPL/History idx history)
                    (REPL/History (inc idx) history)))
            (:next
                (if (< (dec idx) 0)
                    (REPL/History idx history)
                    (REPL/History (dec idx) history)))
            (#true
                (REPL/History 0 (cons m history)))
            )))


(defun REPL (styles data history)
    (tty/write (clear-to-sol) \r (styles :prompt "> "))
    (when (> (str-len data) 0)
        (tty/write (styles :input data)))

    (let key (recv))
    (case (car key)
        (:ArrowUp
            (if (history :empty?)
                (REPL styles data history)
                (REPL styles (history :current) (history :prev))))
        (:ArrowDown
            (if (history :empty?)
                (REPL styles data history)
                (REPL styles (history :current) (history :next))))
        (:Enter
            (if (or (eq? data "q")
                (or (eq? data ":q")
                (or (eq? data "quit")
                    (eq? data "(quit)"))))
                (tty/write \n \n (styles :output "Goodbye!") \n)
                (if (== (str-len data) 0)
                    (REPL styles "" history)
                    (do
                        (let parsed (slight/parse data))
                        (tty/write \n (styles :info (concat "╭" (str-repeat "─" 10) "╮")))
                        (tty/write \n (styles :info "│  source  : ") (styles :output data))
                        (tty/write \n (styles :info "│  parsed  : ") (styles :output (ast->str parsed)))
                        (tty/write \n (styles :info "│  evaled  : ") (styles :output (ast->str (slight/eval-in-top-level parsed))))
                        (tty/write \n (styles :info (concat "╰" (str-repeat "─" 10) "╯")))
                        (tty/write \n)
                        (REPL styles "" (history data))
                    )
                )
            )
        )
        (:Backspace
            (REPL styles (substring data 0 (dec (str-len data))) history))
        (#true
            (if (str? (car key))
                (REPL styles (~ data (car key)) history)
                (REPL styles data history))
        )
    )
)

(let styles (REPL/Styles
    (Style :moonstoneBlue   :BLACK ())
    (Style :persimmonOrange :BLACK (list :BOLD ))
    (Style :urobilinYellow  :BLACK ())
    (Style :acidGreen       :BLACK (list :ITALIC ))
))

(let history (REPL/History 0 ()))

(join (connect :keypress (REPL styles "" history)))





