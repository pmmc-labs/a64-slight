
;; -----------------------------------------------------------------------------
;; Colors
;; -----------------------------------------------------------------------------

(defun hex->rgb (str)
    (list
        (hex (substring str 0 2))
        (hex (substring str 2 4))
        (hex (substring str 4 6))))

(defun lookup-color (name)
    (case name
        ;; Basics
        (:BLACK                (hex->rgb "000000"))
        (:WHITE                (hex->rgb "FFFFFF"))
        (:GREY                 (hex->rgb "CCCCCC"))
        (:RED                  (hex->rgb "FF0000"))
        (:GREEN                (hex->rgb "00FF00"))
        (:BLUE                 (hex->rgb "0000FF"))
        ;; Pantone names
        (:cardinalRed          (hex->rgb "C41E3A"))
        (:deepCerulean         (hex->rgb "007BA7"))
        (:electricLime         (hex->rgb "CCFF00"))
        (:fuchsiaRose          (hex->rgb "C74375"))
