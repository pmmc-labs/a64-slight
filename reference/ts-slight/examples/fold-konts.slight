

(defun hand-written-foldr (init f seq)
    (if (nil? seq) init
        (f (car seq) (hand-written-foldr init f (cdr seq)))))

(defun old-map (f lst)
    (if (nil? lst) ()
        (cons (f (head lst)) (old-map f (tail lst)))))

