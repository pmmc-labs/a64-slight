(defun test (a-big-list)
    (time-it "list - hand-written-foldr")
    (let result (hand-written-foldr () (lambda (x acc) (cons (inc x) acc)) a-big-list))
    (time-it/end "list - hand-written-foldr")

    (time-it "list - old-map")
    (let result (old-map (lambda (x) (inc x)) a-big-list))
    (time-it/end "list - old-map")

    (time-it "list - new-map-w-fold/r")
    (let result (map (lambda (x) (inc x)) a-big-list))
    (time-it/end "list - new-map-w-fold/r")

    (time-it "list - reverse-w-fold/l")
    (let result (reverse a-big-list))
    (time-it/end "list - reverse-w-fold/l")

    (time-it "list - fold/r")
    (let result (fold/r () (lambda (x acc) (cons (inc x) acc)) a-big-list))
    (time-it/end "list - fold/r"))

(test the-big-list)


