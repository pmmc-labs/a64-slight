

(defun Branch? (t) (eq? (car t) :Branch))
(defun Leaf?   (t) (eq? (car t) :Leaf))
(defun Tree?   (t) (or (Branch? t) (Leaf? t)))

(defun Branch (left right)
    (list :Branch left right))

(defun Leaf (value)
    (list :Leaf value))

(defun pprint-tree (t depth)
    (cond
        ((Leaf? t)
            (tty/write (str-repeat "  " depth) ":..[" (cadr t) "]" \n))
        ((Branch? t)
            (pprint-tree (cadr  t) (inc depth))
            (pprint-tree (caddr t) (inc depth)))))


(let tree (Branch
    (Leaf :+)
    (Branch
        (Leaf 10)
        (Leaf 20)
    )
))

(pprint-tree tree 0)
