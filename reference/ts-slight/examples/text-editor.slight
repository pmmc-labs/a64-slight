
;; -----------------------------------------------------------------------------

(defun Cursor (row col max-row max-col)
    (lambda (m arg)
        (case m
            (:row         row)
            (:col         col)
            (:vert-pos    (inc row))
            (:horz-pos    (inc col))

            (:calcLinePos (+ arg row))
            (:moveUp      (Cursor (if (== row 0)       row (dec row)) col max-row max-col))
            (:moveDown    (Cursor (if (== row max-row) row (inc row)) col max-row max-col))
            (:moveLeft    (Cursor row (if (== col 0)       col (dec col)) max-row max-col))
            (:moveRight   (Cursor row (if (== col max-col) col (inc col)) max-row max-col))
            (:lineBreak   (Cursor (if (== row max-row) row (inc row))   0 max-row max-col))
        )
    )
)

(defun Screen (rows cols)

    (defun render-lines (count offset lines default)
        (when (< count rows)
            (tty/write ;; format gutter w/ line numbers
                \e "[2m" (format-num (inc (+ count offset)) 3 "0") " :" \e "[0m" " "
                (if (nil? lines) default (car lines)) \e "[K" \r \n)
            (render-lines (inc count) offset (if (nil? lines) lines (cdr lines)) default)))

    (defun render-footer (cursor offset)
        (let footer (concat
                "line: " (format-num (+ (cursor :vert-pos ()) offset) 2 "0")
            ", column: " (format-num (cursor :horz-pos ()) 2 "0")
            " "
            "[v: "  (format-num (cursor :vert-pos ()) 2 "0")
            " h: "  (format-num (cursor :horz-pos ()) 2 "0")
            " o: "  (format-num offset 2 "0")
            "]"
        ))
        (tty/write \e "[7m" (pad-start footer cols " ")
                   \e "[0m" \e "[K" \r \n ))

    (defun render-status-msg (msg)
        (tty/write \e "[7m"
            (if (nil? msg) (str-repeat " " cols) (pad-end msg cols " "))
            \e "[0m" \e "[K" \r \n ))

    (defun lift-cursor ()
        (tty/write \e "[?25l"
                   \e "[H"))

    (defun position-cursor (cursor gutter)
        (tty/write  \e "[" (cursor :vert-pos ()) ";" (+ gutter (cursor :horz-pos ())) "H"
                    \e "[?25h"))

    (let default-line (concat \e "[2m~" \e "[0m"))
    (let gutter-width 6) ;; fixed for now

    (lambda (m args)
        (case m
            (:rows rows)
            (:cols cols)

            (:makeCursor
                (Cursor 0 0 (dec rows) (dec cols)))

            (:refresh
                (let cursor (car  args))
                (let lines  (cadr args))
                (let offset (car  (cddr args)))
                (let msg    (cadr (cddr args)))

                (lift-cursor)
                (render-lines 0 offset (skip offset lines) default-line)
                (render-status-msg msg)
                (render-footer cursor offset)
                (position-cursor cursor gutter-width)
            )
        )
    )
)

;; -----------------------------------------------------------------------------

(defun scroll-up? (cursor line-offset)
    (if (and (== (cursor :vert-pos ()) 1)
             (>  line-offset        0))
                (dec line-offset)
                line-offset))

(defun scroll-down? (screen cursor lines line-offset)
    (if (and (== (cursor :vert-pos ()) (screen :rows ()))
             (<  (+ (cursor :vert-pos ()) line-offset) (length lines)))
                (inc line-offset)
                line-offset))

;; -----------------------------------------------------------------------------

(defun delete-char-at (cursor lines line-pos)
    (let rest (skip line-pos lines))
    (append (take line-pos lines) (cons (str-splice-at (car rest) (cursor :col ()) ()) (cdr rest))))

(defun insert-char-at (cursor lines line-pos char)
    (let rest (skip line-pos lines))
    (append (take line-pos lines) (cons (str-splice-at (car rest) (cursor :col ()) char) (cdr rest))))

;; -----------------------------------------------------------------------------

(defun add-newline-at (cursor lines line-pos)
    (let rest (skip line-pos lines))
    (if (or (== 0 (cursor :col ())) (== (car rest) ""))
        (append (take line-pos lines) (cons "" rest))
        (append (take line-pos lines) (append (str-split-at (car rest) (cursor :col ())) (cdr rest)))))

(defun remove-newline-at (cursor lines line-pos)
    (let rest (skip (dec line-pos) lines))
    (let prev (car rest))
    (let next (cadr rest))
    (append (take (dec line-pos) lines) (cons (~ prev next) (cddr rest))))

;; -----------------------------------------------------------------------------

(defun EditorConfig (path screen)
    (lambda (m)
        (case m
            (:path   path)
            (:screen screen))))

(defun Editor (cfg cursor lines line-offset msg)
    ((cfg :screen) :refresh (list cursor lines line-offset msg))
    (let key (recv))
    (if (and (not (nil? (cdr key)))
             (eq? (cadr key) :ctrl))
        (case (car key)
            ("e"
                (let rowidx (cursor :row ()))
                (let source (nth rowidx lines))
                (let parsed (slight/parse  source))
                (let expand (slight/expand parsed))
                (let evaled (slight/eval   expand))
                (Editor cfg cursor lines line-offset (concat ">>> " evaled)))
            ("s"
                (spew (cfg :path) lines)
                (Editor cfg cursor lines line-offset (concat "File (" (cfg :path) ") saved successfully.")))
            ("q"
                (tty/write \e "[2J" \e "[H" \e "[?25h" \n)
                (tty/write "Goodbye!" \n))
        )
        (case (car key)
            (:ArrowLeft  (Editor cfg (cursor :moveLeft  ()) lines line-offset msg))
            (:ArrowRight (Editor cfg (cursor :moveRight ()) lines line-offset msg))
            (:ArrowUp    (Editor cfg (cursor :moveUp    ()) lines (scroll-up?   cursor line-offset) msg))
            (:ArrowDown  (Editor cfg (cursor :moveDown  ()) lines (scroll-down? (cfg :screen) cursor lines line-offset) msg))
            (:Enter
                (let updated (add-newline-at cursor lines (cursor :calcLinePos line-offset)))
                (Editor cfg (cursor :lineBreak ()) updated (scroll-down? (cfg :screen) cursor updated line-offset) msg)
            )
            (:Backspace
                (if (== 0 (cursor :col ()))
                    (do
                        (let updated (remove-newline-at cursor lines (cursor :calcLinePos line-offset)))
                        (Editor cfg (cursor :moveUp ()) updated (scroll-down? (cfg :screen) cursor updated line-offset) msg))
                    (do
                        (let updated (delete-char-at cursor lines (cursor :calcLinePos line-offset)))
                        (Editor cfg (cursor :moveLeft ()) updated line-offset msg)))
            )
            (#true
                (let updated (insert-char-at cursor lines (cursor :calcLinePos line-offset) (car key)))
                (Editor cfg (cursor :moveRight ()) updated line-offset msg)
            )
        )
    )
)

(defun init-editor (path)
    (let cfg (EditorConfig
        path
        (Screen (- (tty/screen/rows) 5) (- (tty/screen/cols) 1))
    ))
    (let lines
        (if (nil? path)
            (list "")
            (str-split (slurp path) \n)))
    (let editor (connect :keypress (Editor cfg ((cfg :screen) :makeCursor ()) lines 0 ())))

    (join editor)
)

;; -----------------------------------------------------------------------------


(init-editor (if (nil? @ARGV) () (car @ARGV)))





