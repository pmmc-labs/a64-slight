
(defun Greeter ()
    (let msg (recv))
    (pprint (concat "Hello " msg))
    (yield (Greeter))
)

(let g (fork (Greeter)))  ;; fork the actor
(send g "World")          ;; sent it a message
(yield ())                ;; yield so that Greeter can respond

;; now change Greeter's definition
(slight/eval-in-top-level
    '(defun Greeter () (let msg (recv)) (pprint (concat "Goodbye " msg)) (yield (Greeter))))

;; send message again
;; the new code is live
(send g "World")

(yield ()) ;; yield so that new Greeter code gets the message
(kill g)   ;; then we can kill it to clean things up
