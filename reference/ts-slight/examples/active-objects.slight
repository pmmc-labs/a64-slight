
(defun Object ()
    (let oid (gensym))
    (lambda (m o)
        (case m
            (:oid   oid)
            (:class Object)
            (:===   (eq? oid (o :oid ())))
            (#true  (raise (list :METHOD-NOT-FOUND m))))))

(defun Point (x y)
    (let super (Object))
    (lambda (m o)
        (case m
            (:class  Point)
            (:x      x)
            (:y      y)
            (:xy     (list x y))
            (:yx     (list y x))
            (:+      (Point (+ x (o :x ())) (+ y (o :y ()))))
            (:-      (Point (- x (o :x ())) (- y (o :y ()))))
            (:==     (and (== x (o :x ())) (== y (o :y ()))))
            (:!=     (or  (!= x (o :x ())) (!= y (o :y ()))))
            (:to-str (concat "Point:" x ":" y))
            (#true   (super m o)))))

(defun Point-3D (x y z)
    (let super (Point x y))
    (lambda (m o)
        (case m
            (:class  Point-3D)
            (:z      z)
            (:xyz    (list x y z))
            (:+      (Point-3D (+ x (o :x ())) (+ y (o :y ())) (+ z (o :z ())) ))
            (:-      (Point-3D (- x (o :x ())) (- y (o :y ())) (- z (o :z ())) ))
            (:==     (and (== z (o :z ())) (super :== o) ))
            (:!=     (or  (!= z (o :z ())) (super :!= o) ))
            (:to-str (concat "Point-3D:" x ":" y ":" z))
            (#true   (super m o)))))


(defun ActorRef (obj)
    (let msg  (recv))
    (let call (car  msg))
    (case call
        (:EXIT ())
        (#true
            (let reply-to (cadr msg))
            (let m (car  call))
            (let o (cadr call))
            (send reply-to (obj m o))
            (yield (ActorRef obj)))))

(defun PointActor (x y)
    (let $ref (fork (ActorRef (Point x y))))
    (lambda (m o)
        (case m
            (:EXIT
                (send $ref (list :EXIT)))
            (#true
                (send $ref (list (list m o) $$))
                (recv)))))


(let p1 (PointActor 10 20))
(let p2 (PointActor 20 10))
(let p3 (Point 20 10))

(pprint ((p1 :+ p2) :to-str ()))
(pprint (p2 :==  p3))
(pprint (p2 :=== p3))
(pprint (p1 :== ((p1 :+ p2) :- p3)))

(pprint (((p1 :class ()) 25 30) :to-str ()))

(p1 :EXIT ())
(p2 :EXIT ())
