
;; https://pkolaczk.github.io/memory-consumption-of-async/

(defun test-actor (next)
    (let msg (recv))
    (if (nil? next)
        (do
            (time-it/end "start")
            (sys/io/print-ln "ALL DONE: " (cadr msg) " at " $$))
        (send next (list :PING (+ (cadr msg) 1)))))

(defun setup (n next)
    (if (== n 0)
        (do
            (sys/io/print-ln "READY")
            next)
        (setup (- n 1) (fork (test-actor next)))))

(let actor-count 1000000)

(sys/io/print-ln "INIT with " actor-count " actors")
(time-it "setup")
(let last (setup actor-count (fork (test-actor ()))))
(time-it/end "setup")

(sys/io/print-ln "START")
(time-it "start")
(send last (list :PING 0))


