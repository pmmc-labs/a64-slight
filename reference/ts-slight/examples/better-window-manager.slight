
(defun Coords     (x y) (lambda (m) (case m (:x x) (:y y))))
(defun Dimensions (h w) (lambda (m) (case m (:h h) (:w w))))

(defun Logger (dims coords logs)
    (when (nil? logs)
        (tty/write \e "[" (inc (coords :x)) ";" (inc (coords :y)) "H")
        (tty/write \e "[37;42m LOG " (str-repeat " " (- (dims :w) 11)) $$ " " \e "[0m"))
    (let msg (recv))
    (let tag  (car msg))
    (let args (cdr msg))
    (case tag
        (:log
            (let from  (car   args))
            (let level (cadr  args))
            (let line  (caddr args))
            (tty/write \e "[u" \e "[" (+ (coords :x) (+ (length logs) 2)) ";" (inc (coords :y)) "H")
            (tty/write
                \e "[4"
                    (case level
                        (:INFO  6)
                        (:ALERT 5)
                        (:DEBUG 3)
                        (:ERROR 1)
                    ) "m▕"
                \e "[32;47;4m" (pad-end line (dims :w) " ")
                \e "[0m"`
                \e "[s")

            (yield (Logger dims coords (cons line logs)))
        )
        (:EXIT ())
    )
)

(defun Window (name dims coords contents logger)
    (send logger (list :log $$ :DEBUG (concat "... entering window[" $$ "](" name ")")))
    (let msg (recv))
    (let tag  (car msg))
    (let args (cdr msg))
    (send logger (list :log $$ :INFO (concat "-> window[" $$ "](" name ") got " tag)))
    (case tag
        (:refresh
            (tty/write \e "[" (+ (coords :x) 1) ";" (+ (coords :y) 1) "H")
            (tty/write \e "[37;46m " name (str-repeat " " (- (dims :w) (+ (str-len name) 4))) $$ " " \e "[0m")
            (tty/write \e "[" (+ (coords :x) 2) ";" (+ (coords :y) 1) "H")
            (dotimes 0 (dims :h)
                (lambda (i)
                    (tty/write \e "[36;47m" "▏" (format-num i 2 "0") "▕" \e "[4m" (str-repeat " " (dims :w)) \e "[0m")
                    (tty/write \e "[" (+ (coords :x) (+ i 2)) ";" (+ (coords :y) 1) "H")
                ))
            (yield (Window name dims coords contents logger))
        )
        (:EXIT
            (send logger (list :log $$ :ALERT (concat "... exiting window[" $$ "]"))))
    )
)


(defun WindowManager ( rows cols windows logger )
    (send logger (list :log $$ :DEBUG "... entering window-manager"))
    (let msg (recv))
    (let tag  (car msg))
    (let args (cdr msg))
    (send logger (list :log $$ :INFO (concat "-> window-manager got " tag)))
    (case tag
        (:newWindow
            (let name   (car   args))
            (let dims   (cadr  args))
            (let coords (caddr args))
            (let win (fork (Window name dims coords () logger)))
            (send logger (list :log $$ :ALERT (concat "+ new Window[" win "](" name ")")))
            (send win (list :refresh))
            (yield (WindowManager rows cols (cons win windows) logger))
        )
        (:EXIT
            (send logger (list :log $$ :ALERT "... exiting window-manager"))
            (when (cons? windows)
                (map (lambda (w) (send w (list :EXIT))) windows)))
    )
)

(defun Keyboard (window-manager logger)
    (let key (recv))
    (case (car key)
        ("q"
            (send window-manager (list :EXIT))
            (send logger         (list :EXIT))
            (join window-manager)
            (join logger)
        )
        (#true
            (Keyboard window-manager logger))
    )
)

(tty/write \e "[1J")

(let screen-rows (- (tty/screen/rows) 10))
(let screen-cols (- (tty/screen/cols) 1))

(let logger (fork (Logger (Dimensions screen-rows 50) (Coords 1 (- screen-cols 52)) ())))
(send logger (list :log $$ :DEBUG "... Logger Initialized"))

(let wm (fork (WindowManager screen-rows screen-cols () logger)))
(let kb (connect :keypress (Keyboard wm logger)))

(send wm (list
    :newWindow
        "Window One"
        (Dimensions 31 (- screen-cols 59))
        (Coords      1  1)))

(join kb)

(tty/write \e "[" (+ screen-rows 5) ";0H")


