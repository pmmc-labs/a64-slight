
(defun Object ()
    (let oid  (gensym))
    (let self (lambda (m)
        (case m
            (:oid   oid)
            (:class Object)
            (:===   (lambda (o) (eq? oid (o :oid))))
            (#true  (raise (list :METHOD-NOT-FOUND m)))
        )
    ))
    self)

(defun Point (x y)
    (let super (Object))
    (let self  (lambda (m)
        (case m
            (:class  Point)
            (:x      x)
            (:y      y)
            (:+      (lambda (o) (Point (+ x (o :x)) (+ y (o :y)))))
            (:-      (lambda (o) (Point (- x (o :x)) (- y (o :y)))))
            (:==     (lambda (o) (and (== x (o :x)) (== y (o :y)))))
            (:!=     (lambda (o) (or  (!= x (o :x)) (!= y (o :y)))))
            (:to-str (concat "Point:" x ":" y))
            (#true   (super m)))
    ))
    self)


(let obj1 (Object))
(let obj2 (Object))

(pprint (obj1 :oid))
(pprint (obj2 :oid))

(pprint ((obj1 :===) obj2))

(let p1 (Point 10 20))
(let p2 (Point 20 10))
(let p3 (Point 20 10))

(pprint (((p1 :+) p2) :to-str))
(pprint ((p2 :==)  p3))
(pprint ((p2 :===) p3))
(pprint ((p1 :==) ((((p1 :+) p2) :-) p3)))

(pprint (((p1 :class) 25 30) :to-str))


